#!/bin/sh
# Engine-tree repo-root crucible. Not the kernel.
set -eu
bindir=$(CDPATH=; cd -- "$(dirname -- "$0")" && pwd)
CRUCIBLE_WRAPPER=$0
export CRUCIBLE_WRAPPER
if [ -n "${CRUCIBLE_BIN:-}" ] && [ -x "$CRUCIBLE_BIN" ]; then
  exec "$CRUCIBLE_BIN" "$@"
fi
if [ -x "$bindir/target/release/crucible" ]; then
  exec "$bindir/target/release/crucible" "$@"
fi
printf 'crucible: no binary next to the wrapper (cargo build --release, or set CRUCIBLE_BIN)\n' >&2
exit 1
