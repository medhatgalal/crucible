#!/bin/sh
# crucible - a file-only refusal gate for maker/judge work. No dependencies.
#
#   crucible adopt [PROGRAM] --managed     install one self-contained cycle in this repo
#   crucible adopt [PROGRAM] --refresh     additive engine update (keeps local adapters)
#   crucible cycle [status]                resume the durable problem-to-done loop
#   crucible cycle problem FILE            bind the cycle to a problem report
#   crucible cycle problem FILE --next     same panel, archive closed investigation, new PROBLEM
#   crucible cycle problem --abandon REASON archive junk INVESTIGATE; no PASS; no new PROBLEM
#   crucible cycle approve-panel           record approval of the agent panel
#   crucible cycle approve                 record approval of the current proposal
#   crucible drive [tick|stop]             Ralph-style outer loop; stop releases leftover lock
#   crucible help protocol                 show the agent-facing protocol primitives
#
# Roles come from the brief an agent receives, never from which agent it is. Any CLI
# can be maker; any 1+ CLIs can be judges, same kind or mixed. agents.tsv is two
# columns: name<TAB>kind. Drive starts sealed agents.tsv workers; it does not write verdicts.
#
# WHAT THIS ENFORCES (a missing or wrong file stops the run):
#   work exists; no symlinks or newline filenames anywhere in the item; the falsifier
#   is written; evidence exists, is non-empty, was produced by `crucible run`, and
#   carries the current work id; each verdict is a registered agent, is a regular file,
#   has an exact VERDICT and WORK-ID header, is fresh, is not byte-identical to another,
#   and is backed by at least one evidence file that agent recorded itself; enough
#   verdicts; enough distinct kinds; work unchanged across check and close; no reclose.
#
# WHAT THIS DOES NOT ENFORCE, stated plainly rather than dressed up:
#   WHO WROTE A FILE. Under one user with a shell, one actor can author every verdict
#   under different registered names. Independence here is a property of how you
#   dispatch, not something this script can prove. It raises the cost of faking a panel;
#   it does not close it. Nor can it prove a recorded command was meaningful, that a
#   judge understood what it read, or that a lesson was applied rather than present.
#
# Environment: CRUCIBLE_MIN_JUDGES (default 2), CRUCIBLE_MIN_KINDS (default 1).

set -eu

# The run root is wherever this script lives. That means a program copied into
# <target-repo>/.crucible/<program>/ works with cwd anywhere, and its memory,
# lessons and items are stored in the repo they belong to.
ROOT=${CRUCIBLE_ROOT:-$(cd "$(dirname "$0")" && pwd)}
MIN_JUDGES=${CRUCIBLE_MIN_JUDGES:-2}
MIN_KINDS=${CRUCIBLE_MIN_KINDS:-1}
MARK='crucible-run/1'

die() { printf 'crucible: %s\n' "$*" >&2; exit 2; }
usage() {
  cat <<'EOF'
Crucible runs one durable problem-to-done cycle for a coordinating agent.

  crucible adopt [PROGRAM] --managed   install the cycle in the current repository
  crucible adopt [PROGRAM] --refresh   additive engine update; does not delete local adapters
  crucible cycle [status]              resume from repository evidence
  crucible cycle problem FILE          bind a problem report to the cycle
  crucible cycle problem FILE --next   same panel; archive this investigation; bind a new PROBLEM
  crucible cycle problem --abandon R   archive junk INVESTIGATE without PASS or a new PROBLEM
  crucible cycle approve-panel         record approval of the agent panel
  crucible cycle approve               record approval of the current proposal
  crucible drive [tick|stop]           Ralph-style outer loop; stop releases leftover lock
  crucible help protocol               show internal agent protocol primitives

Operators normally do not run these commands. Point a fresh agent at START.md with a problem.
EOF
}
protocol_usage() {
  cat <<'EOF'
Agent protocol primitives. These are implementation details used by START.md; the operator does
not drive the cycle with them.

  claim add|list|verdict|scout|admit   verify a report before it becomes work
                                      claim add requires one predicate [ABSENT|EXISTS|DEFECT]
                                      claim verdict AGENT STALE|FALSE --like C2 C3 copies non-TRUE
  triage                              render the evidence-grounded proposal input
  add / ready / phase / task          create and advance bounded work
  dispatch / attempt / result         coordinate isolated agent attempts
  attempt transport                   record multi-agent|acp|subagent isolation
  attempt reclaim ATTEMPT             STOPPED a RUNNING attempt whose pid is dead
  evidence archive SLUG               park item evidence whose work-id is not current
  contract-audit ATTEMPT AUDITOR …    file-based contract PASS|FIX|STOP by a distinct agent
  contract-audit ATTEMPT AUDITOR PASS --like ATTEMPT2 …   copy PASS onto isomorphic DISPATCHED contracts
  plan-audit SLUG AUDITOR PASS|FIX|STOP  ITEM.md audit before maker dispatch (guided)
  probe-acp ok|failed|unavailable     record ACP availability for the ladder
  run / run-claim                     record work-bound evidence
  check / close                       refuse unsupported completion
  agents / target / state / workid    inspect supporting state
  lifecycle status|enable             compatibility setup for older programs
  panes / selftest                    optional observation and engine verification

Independence ladder: multi-agent preferred, then ACP, then subagent after ACP probe failure.
If no independent agent can be invoked, STOP and warn — do not continue as solo theatre.
EOF
}
have() { command -v "$1" >/dev/null 2>&1; }
posint() { case $1 in ''|*[!0-9]*) return 1 ;; esac; [ "$1" -ge 1 ]; }
posint "$MIN_JUDGES" || die "CRUCIBLE_MIN_JUDGES must be a positive integer"
posint "$MIN_KINDS"  || die "CRUCIBLE_MIN_KINDS must be a positive integer"

hashfile() {
  if   have shasum;    then shasum -a 256 "$1" | cut -d' ' -f1
  elif have sha256sum; then sha256sum   "$1" | cut -d' ' -f1
  else cksum "$1" | cut -d' ' -f1; fi
}
h12() {
  if   have shasum;    then shasum -a 256
  elif have sha256sum; then sha256sum
  else cksum; fi | cut -d' ' -f1 | cut -c1-12
}

# How an agent should invoke this from the working directory it will actually be in. A hardcoded
# "./crucible" was wrong for an installed program: the documents put cwd at the repository root,
# where ./crucible does not exist, so every generated contract handed the agent a 127.
self_path() {
  [ -n "${CRUCIBLE_SELF:-}" ] && { printf '%s' "$CRUCIBLE_SELF"; return; }
  if [ -f "$ROOT/PROGRAM" ]; then
    r=$(sed -n 's/^repo: //p' "$ROOT/PROGRAM" | head -1)
    if [ -n "$r" ]; then
      # Resolve both sides before comparing. git reports the physical path and `pwd` may report
      # a symlinked one — on macOS /var is a link to /private/var — so a textual prefix test
      # silently failed and every generated contract fell back to a path that does not exist.
      rr=$(cd "$r" 2>/dev/null && pwd -P) || rr=$r
      rt=$(cd "$ROOT" 2>/dev/null && pwd -P) || rt=$ROOT
      case $rt in
        "$rr"/*) printf '%s/crucible' "${rt#"$rr"/}"; return ;;
      esac
    fi
  fi
  printf './crucible'
}

D() { printf '%s/items/%s' "$ROOT" "$1"; }
need() { [ -n "${1:-}" ] || die "need a slug"; [ -d "$(D "$1")" ] || die "no such item: $1"; }

lifecycle_mode() {
  mode=$(sed -n 's/^lifecycle: //p' "$ROOT/PROGRAM" 2>/dev/null | head -1)
  case $mode in
    '') printf 'item-file' ;;
    managed) printf 'managed' ;;
    *) die "unsupported lifecycle behavior: $mode" ;;
  esac
}
uses_managed_lifecycle() { [ "$(lifecycle_mode)" = managed ]; }
uses_guided_cycle() { grep -q '^cycle: guided$' "$ROOT/PROGRAM" 2>/dev/null; }

state_validate_file() {
  sf=$1
  [ -f "$sf" ] && [ ! -L "$sf" ] || die "invalid STATE.tsv: missing regular file"
  err=$(awk -F '\t' '
    BEGIN { want="item\tstatus\tstage\twork_id\trisk\tinflight_attempt\tblock_code\tupdated_epoch" }
    NR == 1 {
      if ($0 != want) { print "header mismatch"; exit 1 }
      next
    }
    {
      if (NF != 8) { print "row " NR " has " NF " fields, need 8"; exit 1 }
      if ($1 !~ /^[A-Za-z0-9._-]+$/) { print "invalid item at row " NR; exit 1 }
      if (seen[$1]++) { print "duplicate item " $1; exit 1 }
      if ($2 !~ /^(ACTIVE|BLOCKED|CLOSED|DROPPED)$/) { print "invalid status for " $1; exit 1 }
      if ($3 !~ /^(DRAFT|READY|BUILD|REVIEW)$/) { print "invalid stage for " $1; exit 1 }
      if ($4 !~ /^[A-Za-z0-9._-]+$/) { print "invalid work_id for " $1; exit 1 }
      if ($5 !~ /^(-|LOW|MEDIUM|HIGH)$/) { print "invalid risk for " $1; exit 1 }
      if ($6 !~ /^[A-Za-z0-9._-]+$/) { print "invalid inflight_attempt for " $1; exit 1 }
      if ($7 !~ /^[A-Za-z0-9._-]+$/) { print "invalid block_code for " $1; exit 1 }
      if ($8 !~ /^[0-9]+$/) { print "invalid updated_epoch for " $1; exit 1 }
      if ($2 == "ACTIVE" || $2 == "BLOCKED") current++
    }
    END {
      if (NR == 0) { print "empty file"; exit 1 }
      if (current > 1) { print "more than one current item"; exit 1 }
    }
  ' "$sf" 2>&1) || die "invalid STATE.tsv: $err"
}

state_value() {
  slug=$1; column=$2
  awk -F '\t' -v s="$slug" -v c="$column" 'NR > 1 && $1 == s { print $c; exit }' "$ROOT/STATE.tsv"
}

state_render_file() {
  out=$1; source=${2:-$ROOT/STATE.tsv}
  prog=$(sed -n 's/^program: //p' "$ROOT/PROGRAM" 2>/dev/null | head -1)
  {
    printf '# STATE — %s\n\n' "${prog:-program}"
    printf 'Generated from `STATE.tsv`; do not edit this file by hand.\n\n'
    printf '| Item | Status | Stage | Work ID | Risk | In-flight attempt | Block code | Updated epoch |\n'
    printf '| --- | --- | --- | --- | --- | --- | --- | --- |\n'
    awk -F '\t' 'NR > 1 { printf "| %s | %s | %s | %s | %s | %s | %s | %s |\n", $1,$2,$3,$4,$5,$6,$7,$8 }' "$source"
  } > "$out"
}

state_lock() {
  STATE_TMP="$ROOT/.STATE.tsv.$$.tmp"
  STATE_MD_TMP="$ROOT/.STATE.md.$$.tmp"
  STATE_PROGRAM_TMP="$ROOT/.PROGRAM.$$.tmp"
  STATE_LOCK="$ROOT/.state.lock"
  mkdir "$STATE_LOCK" 2>/dev/null || die "state mutation already in progress"
  trap 'rm -f "$STATE_TMP" "$STATE_MD_TMP" "$STATE_PROGRAM_TMP"; rmdir "$STATE_LOCK" 2>/dev/null || true' 0 1 2 15
}

state_unlock() {
  rmdir "$STATE_LOCK" 2>/dev/null || die "could not release state lock"
  trap - 0 1 2 15
}

state_commit() {
  state_validate_file "$STATE_TMP"
  state_render_file "$STATE_MD_TMP" "$STATE_TMP"
  mv "$STATE_TMP" "$ROOT/STATE.tsv"
  mv "$STATE_MD_TMP" "$ROOT/STATE.md"
  state_unlock
}

state_add_item() {
  slug=$1; wid=$2; risk=$3
  state_lock
  state_validate_file "$ROOT/STATE.tsv"
  [ -z "$(state_value "$slug" 1)" ] || die "item already exists in STATE.tsv: $slug"
  current=$(awk -F '\t' 'NR > 1 && ($2 == "ACTIVE" || $2 == "BLOCKED") { n++ } END { print n+0 }' "$ROOT/STATE.tsv")
  [ "$current" -eq 0 ] || die "refused: another item is current"
  cp "$ROOT/STATE.tsv" "$STATE_TMP"
  printf '%s\tACTIVE\tDRAFT\t%s\t%s\t-\t-\t%s\n' "$slug" "$wid" "$risk" "$(date +%s)" >> "$STATE_TMP"
  state_commit
}

state_update_item() {
  slug=$1; status=$2; stage=$3; wid=$4; risk=$5; inflight=$6; block=$7
  state_lock
  state_validate_file "$ROOT/STATE.tsv"
  awk -F '\t' -v OFS='\t' -v s="$slug" -v st="$status" -v g="$stage" \
    -v w="$wid" -v r="$risk" -v i="$inflight" -v b="$block" -v now="$(date +%s)" '
    NR == 1 { print; next }
    $1 == s { print $1,st,g,w,r,i,b,now; found=1; next }
    { print }
    END { if (!found) exit 4 }
  ' "$ROOT/STATE.tsv" > "$STATE_TMP" || die "item missing from STATE.tsv: $slug"
  state_commit
}

cmd_state() {
  uses_managed_lifecycle || die "state requires managed lifecycle behavior — run: $(self_path) lifecycle enable --dry-run"
  state_lock
  state_validate_file "$ROOT/STATE.tsv"
  state_render_file "$STATE_MD_TMP" "$ROOT/STATE.tsv"
  mv "$STATE_MD_TMP" "$ROOT/STATE.md"
  state_unlock
  printf '%s/STATE.md\n' "$ROOT"
}

cmd_lifecycle() {
  sub=${1:-status}; flag=${2:-}
  case $sub in
    status)
      [ -z "$flag" ] || die "usage: crucible lifecycle status"
      printf 'lifecycle: %s\n' "$(lifecycle_mode)"
      ;;
    enable)
      case $flag in --dry-run|--apply) : ;; *) die "usage: crucible lifecycle enable --dry-run|--apply" ;; esac
      uses_managed_lifecycle && { printf 'lifecycle: managed\n'; return; }
      active=$(find "$ROOT/items" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1)
      [ -z "$active" ] || die "refused: managed lifecycle can only be enabled before the first item"
      printf 'CREATE %s/STATE.tsv\nREPLACE %s/STATE.md\nUPDATE %s/PROGRAM lifecycle: managed\n' "$ROOT" "$ROOT" "$ROOT"
      [ "$flag" = --apply ] || return 0
      state_lock
      printf 'item\tstatus\tstage\twork_id\trisk\tinflight_attempt\tblock_code\tupdated_epoch\n' > "$STATE_TMP"
      state_validate_file "$STATE_TMP"
      state_render_file "$STATE_MD_TMP" "$STATE_TMP"
      awk '$0 !~ /^lifecycle: / { print }' "$ROOT/PROGRAM" > "$STATE_PROGRAM_TMP"
      printf 'lifecycle: managed\n' >> "$STATE_PROGRAM_TMP"
      mv "$STATE_TMP" "$ROOT/STATE.tsv"
      mv "$STATE_MD_TMP" "$ROOT/STATE.md"
      mv "$STATE_PROGRAM_TMP" "$ROOT/PROGRAM"
      state_unlock
      printf 'enabled managed lifecycle\n'
      ;;
    *) die "usage: crucible lifecycle status|enable --dry-run|--apply" ;;
  esac
}

attempt_dir() {
  id=$1
  case $id in ''|*[!A0-9.]*) die "invalid attempt id: $id" ;; esac
  valid=$(printf '%s\n' "$id" | awk -F. '
    NF == 3 && $1 ~ /^A[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ { print "yes" }
  ')
  [ "$valid" = yes ] || die "invalid attempt id: $id"
  ad="$ROOT/attempts/$id"
  [ -d "$ad" ] || die "no such attempt: $id"
  printf '%s' "$ad"
}

attempt_meta() {
  ad=$(attempt_dir "$1"); column=$2
  awk -F '\t' -v c="$column" 'NR == 2 { print $c; exit }' "$ad/meta.tsv"
}

attempt_state() {
  ad=$(attempt_dir "$1")
  awk -F '\t' 'NR > 1 { state=$1 } END { print state }' "$ad/events.tsv"
}

attempt_pid() {
  ad=$(attempt_dir "$1")
  awk -F '\t' 'NR > 1 && $3 != "-" { pid=$3 } END { print (pid ? pid : "-") }' "$ad/events.tsv"
}

attempt_pid_alive() {
  pid=$(attempt_pid "$1")
  [ -n "$pid" ] && [ "$pid" != - ] || return 1
  # kill -0 fails with EPERM on pid 1; ps -p is the existence check.
  ps -p "$pid" >/dev/null 2>&1
}

attempt_terminal() {
  case $1 in RETURNED|TIMEOUT|STOPPED|ABANDONED|SUPERSEDED) return 0 ;; *) return 1 ;; esac
}

attempt_event() {
  id=$1; new=$2; pid=$3; reason=$4; ad=$(attempt_dir "$id")
  case "$reason" in *"$(printf '\t')"*|*'
'*) die "attempt reason must be one line without tabs" ;; esac
  lock="$ad/.event.lock"; tmp="$ad/.events.$$.tmp"
  mkdir "$lock" 2>/dev/null || die "attempt update already in progress: $id"
  trap 'rm -f "$tmp"; rmdir "$lock" 2>/dev/null || true' 0 1 2 15
  old=$(attempt_state "$id")
  attempt_terminal "$old" && die "attempt $id is terminal: $old"
  cp "$ad/events.tsv" "$tmp"
  printf '%s\t%s\t%s\t%s\n' "$new" "$(date +%s)" "$pid" "$reason" >> "$tmp"
  mv "$tmp" "$ad/events.tsv"
  rmdir "$lock"; trap - 0 1 2 15
}

state_attempt_update() {
  slug=$1; status=$2; inflight=$3; block=$4
  stage=$(state_value "$slug" 3); wid=$(state_value "$slug" 4); risk=$(state_value "$slug" 5)
  state_update_item "$slug" "$status" "$stage" "$wid" "$risk" "$inflight" "$block"
}

attempt_live_for() (
  slug=$1; role=$2; criterion=$3; task=${4:--}
  [ -d "$ROOT/attempts" ] || return 1
  for ad in "$ROOT"/attempts/*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    [ "$(attempt_meta "$id" 2)" = "$slug" ] || continue
    [ "$(attempt_meta "$id" 5)" = "$role" ] || continue
    [ "$(attempt_meta "$id" 8)" = "$criterion" ] || continue
    [ "$(attempt_meta "$id" 3)" = "$task" ] || continue
    st=$(attempt_state "$id")
    attempt_terminal "$st" || { printf '%s' "$id"; return 0; }
  done
  return 1
)

attempt_pass_exists() (
  slug=$1; wid=$2; role=$3; agent=$4; criterion=$5; task=${6:--}
  [ -d "$ROOT/attempts" ] || return 1
  for result_file in "$ROOT"/attempts/*/result.md; do
    [ -f "$result_file" ] || continue
    [ "$(sed -n 's/^OUTCOME: //p' "$result_file" | head -1)" = PASS ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^WORK-ID: //p' "$result_file" | head -1)" = "$wid" ] || continue
    [ "$(sed -n 's/^ROLE: //p' "$result_file" | head -1)" = "$role" ] || continue
    [ "$(sed -n 's/^AGENT: //p' "$result_file" | head -1)" = "$agent" ] || continue
    [ "$(sed -n 's/^CRITERION: //p' "$result_file" | head -1)" = "$criterion" ] || continue
    [ "$(sed -n 's/^TASK-ID: //p' "$result_file" | head -1)" = "$task" ] || continue
    return 0
  done
  return 1
)

canonical_pass_exists() (
  slug=$1; wid=$2; class=$3
  [ -d "$ROOT/attempts" ] || return 1
  for result_file in "$ROOT"/attempts/*/result.md; do
    [ -f "$result_file" ] || continue
    [ "$(sed -n 's/^OUTCOME: //p' "$result_file" | head -1)" = PASS ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^WORK-ID: //p' "$result_file" | head -1)" = "$wid" ] || continue
    [ "$(sed -n 's/^EVIDENCE-CLASS: //p' "$result_file" | head -1)" = "$class" ] || continue
    return 0
  done
  return 1
)

maker_pass_exists() (
  slug=$1; wid=$2
  [ -d "$ROOT/attempts" ] || return 1
  for result_file in "$ROOT"/attempts/*/result.md; do
    [ -f "$result_file" ] || continue
    [ "$(sed -n 's/^OUTCOME: //p' "$result_file" | head -1)" = PASS ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^WORK-ID: //p' "$result_file" | head -1)" = "$wid" ] || continue
    [ "$(sed -n 's/^ROLE: //p' "$result_file" | head -1)" = maker ] || continue
    return 0
  done
  return 1
)

cmd_attempt() {
  uses_managed_lifecycle || die "attempt requires managed lifecycle behavior"
  sub=${1:-}; [ $# -eq 0 ] || shift
  id=${1:-}; [ $# -eq 0 ] || shift
  [ -n "$id" ] || die "usage: crucible attempt start|overdue|finish|transport|reclaim ATTEMPT ..."
  ad=$(attempt_dir "$id"); slug=$(attempt_meta "$id" 2)
  case $sub in
    start)
      value=${1:-}; [ $# -eq 1 ] || die "usage: crucible attempt start ATTEMPT PID"
      posint "$value" || die "attempt start requires a positive PID"
      [ "$(attempt_state "$id")" = DISPATCHED ] || die "attempt start requires DISPATCHED"
      # Independence artifacts must be sealed before the process is observed running.
      require_attempt_independence "$id"
      attempt_event "$id" RUNNING "$value" observed-start
      printf '%s RUNNING pid %s\n' "$id" "$value"
      ;;
    transport)
      value=${1:-}; [ $# -eq 1 ] || die "usage: crucible attempt transport ATTEMPT multi-agent|acp|subagent"
      case $value in multi-agent|acp|subagent) : ;; *) die "transport must be multi-agent, acp, or subagent" ;; esac
      [ "$(attempt_state "$id")" = DISPATCHED ] \
        || die "refused: transport may only be recorded while DISPATCHED (before attempt start)"
      require_panel_approval
      if uses_guided_cycle; then
        enforce_transport_ladder "$value"
      elif [ "$value" = subagent ]; then
        acp_probe_failed \
          || die "refused: subagent requires a recorded ACP probe failure (ACP-PROBE.md status: failed, or PANEL notes ACP unavailable)"
      fi
      if [ -e "$ad/transport" ]; then
        [ -f "$ad/transport" ] && [ ! -L "$ad/transport" ] || die "transport is immutable: $id"
        existing=$(sed -n '1p' "$ad/transport" | tr -d '\r')
        [ "$existing" = "$value" ] || die "transport is immutable: $id"
        printf '%s transport %s (already recorded)\n' "$id" "$value"
        return
      fi
      tmp="$ad/.transport.$$.tmp"
      printf '%s\n' "$value" > "$tmp"
      mv "$tmp" "$ad/transport"
      printf '%s transport %s\n' "$id" "$value"
      ;;
    overdue)
      [ $# -eq 0 ] || die "usage: crucible attempt overdue ATTEMPT"
      [ "$(attempt_state "$id")" = RUNNING ] || die "attempt overdue requires RUNNING"
      deadline=$(attempt_meta "$id" 12); now=$(date +%s)
      [ "$now" -ge "$deadline" ] || die "refused: deadline $deadline has not passed"
      attempt_event "$id" OVERDUE "$(attempt_pid "$id")" deadline-passed
      printf '%s OVERDUE; process outcome is still unobserved\n' "$id"
      ;;
    finish)
      value=${1:-}; [ $# -eq 0 ] || shift; reason=${*:-}
      case $value in RETURNED|TIMEOUT|STOPPED|ABANDONED) : ;; *) die "finish state must be RETURNED TIMEOUT STOPPED or ABANDONED" ;; esac
      current=$(attempt_state "$id")
      case $current in RUNNING|OVERDUE) : ;; *) die "attempt finish requires RUNNING or OVERDUE" ;; esac
      [ -n "$reason" ] || reason=observed
      attempt_event "$id" "$value" "$(attempt_pid "$id")" "$reason"
      retry=$(attempt_meta "$id" 13); task=$(attempt_meta "$id" 3)
      case $value in
        RETURNED) printf '%s RETURNED; record its result next\n' "$id" ;;
        TIMEOUT)
          case $slug in C[0-9]*)
            printf '%s TIMEOUT; claim attempt has no item state\n' "$id"
            ;;
          *)
            if [ "$task" != - ] && [ "$retry" = - ]; then
              state_attempt_update "$slug" ACTIVE TASKS RETRY_AVAILABLE
              printf '%s TIMEOUT; one task retry is available\n' "$id"
            elif [ "$task" != - ]; then
              state_attempt_update "$slug" BLOCKED - RETRY_EXHAUSTED
              printf '%s TIMEOUT; item blocked RETRY_EXHAUSTED\n' "$id"
            elif [ "$retry" = - ]; then
              state_attempt_update "$slug" ACTIVE "$id" RETRY_AVAILABLE
              printf '%s TIMEOUT; one retry is available\n' "$id"
            else
              state_attempt_update "$slug" BLOCKED - RETRY_EXHAUSTED
              printf '%s TIMEOUT; item blocked RETRY_EXHAUSTED\n' "$id"
            fi
            ;;
          esac ;;
        STOPPED|ABANDONED)
          case $slug in C[0-9]*)
            printf '%s %s; claim attempt has no item state\n' "$id" "$value"
            ;;
          *)
            if [ "$task" != - ]; then block_code=TASK_BLOCKED; else block_code=OPERATOR_DECISION; fi
            state_attempt_update "$slug" BLOCKED - "$block_code"
            printf '%s %s; item blocked %s\n' "$id" "$value" "$block_code"
            ;;
          esac ;;
      esac
      ;;
    reclaim)
      [ $# -eq 0 ] || die "usage: crucible attempt reclaim ATTEMPT"
      current=$(attempt_state "$id")
      case $current in RUNNING|OVERDUE) : ;; *) die "attempt reclaim requires RUNNING or OVERDUE" ;; esac
      if attempt_pid_alive "$id"; then
        die "refused: attempt $id pid $(attempt_pid "$id") is still alive"
      fi
      attempt_event "$id" STOPPED "$(attempt_pid "$id")" dead-pid
      retry=$(attempt_meta "$id" 13); task=$(attempt_meta "$id" 3)
      case $slug in C[0-9]*)
        printf '%s STOPPED; dead pid reclaimed (claim attempt)\n' "$id"
        ;;
      *)
        if [ "$task" != - ]; then block_code=TASK_BLOCKED; else block_code=OPERATOR_DECISION; fi
        state_attempt_update "$slug" BLOCKED - "$block_code"
        printf '%s STOPPED; dead pid reclaimed; item blocked %s\n' "$id" "$block_code"
        ;;
      esac
      ;;
    *) die "usage: crucible attempt start|overdue|finish|transport|reclaim ATTEMPT ..." ;;
  esac
}

# Structural minimum checks on a managed contract before audit PASS (shell, not LLM).
contract_structural_ok() {
  ad=$1; role=$2
  [ -f "$ad/contract.md" ] || return 1
  grep -qiE 'follow it exactly|Read this file and follow it exactly' "$ad/contract.md" || return 1
  case $role in
    judge|adversary)
      grep -q 'This attempt is bound' "$ad/contract.md" || return 1
      grep -q '^## Maker report' "$ad/contract.md" && return 1
      grep -q '^## Review independence' "$ad/contract.md" || return 1
      ;;
    maker)
      grep -q 'This attempt is bound' "$ad/contract.md" || return 1
      grep -qE '^## Work location|^## Item' "$ad/contract.md" || return 1
      ;;
    claim-auditor|scout)
      grep -qE 'claim|Claim|auditing claim' "$ad/contract.md" || return 1
      ;;
  esac
  return 0
}

registered_kind_count() {
  [ -f "$ROOT/agents.tsv" ] || { printf '0'; return; }
  grep -v '^#' "$ROOT/agents.tsv" | grep -v '^[[:space:]]*$' |
    awk -F '\t' 'NF >= 2 && $2 != "" { k[$2]=1 } END { print length(k)+0 }'
}

panel_has_single_product_waiver() {
  [ -f "$(panel_file)" ] || return 1
  # Only explicit waiver lines count — prose mentioning the token must not grant it.
  grep -qiE '^[[:space:]]*(LADDER_WAIVER|WAIVER):[[:space:]]*single-product\b' "$(panel_file)"
}

# Prefer multi-agent *agents* when ≥2 kinds are registered. The transport label
# describes this hop: acp is honest for a same-product ACP session even on a
# multi-kind panel. Do not force the multi-agent label onto a grok→grok hop.
# Subagent still requires a recorded ACP probe failure.
enforce_transport_ladder() {
  transport=$1
  if [ "$transport" = subagent ]; then
    acp_probe_failed \
      || die "refused: subagent requires a recorded ACP probe failure (ACP-PROBE.md status: failed, or PANEL notes ACP unavailable)"
  fi
  case $transport in
    multi-agent|acp|subagent) return 0 ;;
    *) die "refused: transport must be multi-agent|acp|subagent" ;;
  esac
}

contract_normalize_file() {
  awk '
    /^## The claim/ { skip=1; print "## The claim"; print "CN"; next }
    skip && /^## / { skip=0 }
    skip { next }
    { print }
  ' "$1" | sed -e '/^attempt-id:/d' \
               -e 's/C[0-9][0-9]*/CN/g' \
               -e 's/A[0-9][0-9.][0-9.]*/ATTEMPT/g'
}

contracts_isomorphic() {
  a=$(contract_normalize_file "$1" | h12)
  b=$(contract_normalize_file "$2" | h12)
  [ -n "$a" ] && [ "$a" = "$b" ]
}

contract_audit_copy_like() {
  template=$1
  target=$2
  tad="$ROOT/attempts/$template"
  dad=$(attempt_dir "$target")
  [ -f "$tad/contract-audit.md" ] || return 1
  grep -q '^VERDICT: PASS' "$tad/contract-audit.md" || return 1
  [ ! -e "$dad/contract-audit.md" ] || return 1
  [ "$(attempt_state "$target")" = DISPATCHED ] || return 1
  [ -f "$tad/contract.md" ] && [ -f "$dad/contract.md" ] || return 1
  [ "$(attempt_meta "$template" 5)" = "$(attempt_meta "$target" 5)" ] || return 1
  contracts_isomorphic "$tad/contract.md" "$dad/contract.md" || return 1
  sed "s/$template/$target/g" "$tad/contract-audit.md" > "$dad/.contract-audit.$$.tmp"
  mv "$dad/.contract-audit.$$.tmp" "$dad/contract-audit.md"
  printf '%s/contract-audit.md (like %s)\n' "$dad" "$template"
}

cmd_contract_audit() {
  uses_managed_lifecycle || die "contract-audit requires managed lifecycle behavior"
  id=${1:-}; auditor=${2:-}; verdict=${3:-}
  [ -n "$id" ] && [ -n "$auditor" ] && [ -n "$verdict" ] \
    || die "usage: crucible contract-audit ATTEMPT AUDITOR PASS|FIX|STOP [note...] | PASS --like ATTEMPT2..."
  case $verdict in PASS|FIX|STOP) : ;; *) die "contract-audit verdict must be PASS, FIX, or STOP" ;; esac
  reg "$auditor"
  shift 3
  likes=
  note=NONE
  if [ "${1:-}" = --like ]; then
    [ "$verdict" = PASS ] || die 'refused: --like requires PASS'
    shift
    [ $# -gt 0 ] || die 'usage: crucible contract-audit ATTEMPT AUDITOR PASS --like ATTEMPT2...'
    likes=$*
  else
    [ $# -eq 0 ] || note=$*
  fi
  ad=$(attempt_dir "$id")
  [ -f "$ad/contract.md" ] || die "attempt has no contract.md: $id"
  st=$(attempt_state "$id")
  [ "$st" = DISPATCHED ] \
    || die "refused: contract-audit may only be recorded while DISPATCHED (before attempt start)"
  require_panel_approval
  attempt_agent=$(attempt_meta "$id" 6)
  role=$(attempt_meta "$id" 5)
  slug=$(attempt_meta "$id" 2)
  [ "$auditor" != "$attempt_agent" ] \
    || die "refused: contract-auditor $auditor cannot audit its own attempt agent"
  require_role_cast contract-auditor "$auditor"
  case $role in
    judge|adversary)
      is_maker "$slug" "$auditor" 2>/dev/null \
        && die "refused: maker $auditor cannot contract-audit review of $slug" || true
      ;;
  esac
  transport=-
  if attempt_transport "$id" >/dev/null 2>&1; then
    transport=$(attempt_transport "$id")
  fi
  independence=ok
  case $verdict in
    PASS)
      [ "$transport" != - ] || die "refused: record transport before contract-audit PASS"
      enforce_transport_ladder "$transport"
      contract_structural_ok "$ad" "$role" \
        || die "refused: contract.md fails structural checks (brief-only instruction / role sections)"
      case $transport in
        multi-agent) independence=ok ;;
        acp) independence=weak ;;
        subagent) independence=weak ;;
      esac
      ;;
    STOP) independence=unavailable ;;
    FIX) independence=weak ;;
  esac
  if [ -e "$ad/contract-audit.md" ]; then
    [ -f "$ad/contract-audit.md" ] && [ ! -L "$ad/contract-audit.md" ] \
      || die "contract-audit is immutable: $id"
    existing=$(sed -n 's/^VERDICT: //p' "$ad/contract-audit.md" | head -1)
    existing_auditor=$(sed -n 's/^AUDITOR: //p' "$ad/contract-audit.md" | head -1)
    if [ "$existing" = "$verdict" ] && [ "$existing_auditor" = "$auditor" ]; then
      printf '%s/contract-audit.md (already %s by %s)\n' "$ad" "$verdict" "$auditor"
      if [ -n "$likes" ]; then
        role=$(attempt_meta "$id" 5)
        for like_id in $likes; do
          contract_audit_copy_like "$id" "$like_id" \
            || die "refused: $like_id is not an isomorphic DISPATCHED $role contract of $id"
        done
      fi
      return
    fi
    die "contract-audit is immutable: $id (existing $existing by $existing_auditor)"
  fi
  case $verdict in
    PASS) failures=none; required_fix=none ;;
    FIX) failures=$note; required_fix=$note ;;
    STOP) failures=$note; required_fix=none ;;
  esac
  tmp="$ad/.contract-audit.$$.tmp"
  {
    printf 'VERDICT: %s\nAUDITOR: %s\nAUDITOR-KIND: %s\nTRANSPORT: %s\nINDEPENDENCE: %s\n' \
      "$verdict" "$auditor" "$(kind_of "$auditor")" "$transport" "$independence"
    printf 'FAILURES: %s\nREQUIRED_FIX: %s\n' "$failures" "$required_fix"
    printf '\nFile-based contract audit for attempt %s by %s.\n' "$id" "$auditor"
    if [ "$verdict" = PASS ] && [ "$note" != NONE ]; then
      printf 'NOTE: %s\n' "$note"
    fi
  } > "$tmp"
  mv "$tmp" "$ad/contract-audit.md"
  if [ "$verdict" = STOP ]; then
    stage=$(state_value "$slug" 3); risk=$(state_value "$slug" 5)
    wid=$(state_value "$slug" 4)
    # Claim attempts use item field C1 etc. and may not be in STATE.tsv
    if [ -f "$ROOT/STATE.tsv" ] && state_value "$slug" 1 >/dev/null 2>&1; then
      case $slug in C[0-9]*) : ;; *)
        state_update_item "$slug" BLOCKED "$stage" "$wid" "$risk" - INDEPENDENCE_UNAVAILABLE
      ;; esac
    fi
    printf '%s/contract-audit.md\nESCALATE INDEPENDENCE_UNAVAILABLE — do not continue as solo theatre\n' "$ad"
    return
  fi
  if [ "$verdict" = FIX ]; then
    # SUPERSEDE so a revised redispatch can proceed (live attempt no longer blocks).
    # Re-audit of this attempt is not allowed — write a new contract via redispatch.
    attempt_event "$id" SUPERSEDED - contract-audit-FIX
    if [ -f "$ROOT/STATE.tsv" ]; then
      case $slug in C[0-9]*) : ;; *)
        stage=$(state_value "$slug" 3); risk=$(state_value "$slug" 5); wid=$(state_value "$slug" 4)
        inflight=$(state_value "$slug" 6)
        [ "$inflight" = "$id" ] && state_update_item "$slug" ACTIVE "$stage" "$wid" "$risk" - -
      ;; esac
    fi
    printf '%s/contract-audit.md\nFIX: revise the contract and redispatch a new attempt (this attempt is SUPERSEDED)\n' "$ad"
    return
  fi
  printf '%s/contract-audit.md\n' "$ad"
  if [ -n "$likes" ]; then
    for like_id in $likes; do
      contract_audit_copy_like "$id" "$like_id" \
        || die "refused: $like_id is not an isomorphic DISPATCHED $role contract of $id"
    done
  fi
}

cmd_plan_audit() {
  uses_managed_lifecycle || die "plan-audit requires managed lifecycle behavior"
  slug=${1:-}; auditor=${2:-}; verdict=${3:-}
  [ -n "$slug" ] && [ -n "$auditor" ] && [ -n "$verdict" ] \
    || die "usage: crucible plan-audit SLUG AUDITOR PASS|FIX|STOP"
  case $verdict in PASS|FIX|STOP) : ;; *) die "plan-audit verdict must be PASS, FIX, or STOP" ;; esac
  need "$slug"
  reg "$auditor"
  is_maker "$slug" "$auditor" && die "refused: $auditor is a maker of $slug — plan-audit must be independent"
  d=$(D "$slug")
  [ ! -e "$d/plan-audit.md" ] || [ ! -L "$d/plan-audit.md" ] \
    || die "plan-audit.md must be a regular file"
  if [ -f "$d/plan-audit.md" ]; then
    [ ! -L "$d/plan-audit.md" ] || die "plan-audit.md must be a regular file"
    existing=$(sed -n 's/^VERDICT: //p' "$d/plan-audit.md" | head -1)
    [ "$existing" != "$verdict" ] \
      || { printf '%s/plan-audit.md (already %s)\n' "$d" "$verdict"; return; }
    die "refused: plan-audit.md is immutable (existing $existing)"
  fi
  {
    printf 'VERDICT: %s\nAUDITOR: %s\nAUDITOR-KIND: %s\nITEM: %s\n' \
      "$verdict" "$auditor" "$(kind_of "$auditor")" "$slug"
    printf '\nPlan-audit of ITEM.md for %s by %s. Not a maker PASS.\n' "$slug" "$auditor"
  } > "$d/plan-audit.md"
  printf '%s/plan-audit.md\n' "$d"
}

cmd_probe_acp() {
  # Append-only ACP probe log. A prior ok cannot be unbound-overwritten into failed
  # to unlock weaker subagent transport.
  status=${1:-}; [ -n "$status" ] || die "usage: crucible probe-acp ok|failed|unavailable [note...]"
  case $status in ok|failed|unavailable) : ;; *) die "probe-acp status must be ok, failed, or unavailable" ;; esac
  shift
  note=${*:-none}
  now=$(date +%s)
  mkdir -p "$ROOT/acp-probes"
  if [ -f "$ROOT/ACP-PROBE.md" ] && [ ! -L "$ROOT/ACP-PROBE.md" ]; then
    prev=$(sed -n 's/^status: //p' "$ROOT/ACP-PROBE.md" | head -1 | tr '[:upper:]' '[:lower:]')
    if [ "$prev" = ok ] && [ "$status" != ok ]; then
      die "refused: ACP probe already ok; cannot downgrade to $status to unlock weaker isolation (record PANEL ACP-unavailable if needed)"
    fi
  fi
  # Append immutable event
  n=1; while [ -e "$ROOT/acp-probes/$n.md" ]; do n=$((n+1)); done
  {
    printf 'status: %s\nprobed-epoch: %s\nnote: %s\n' "$status" "$now" "$note"
    printf '\nImmutable ACP probe event %s.\n' "$n"
  } > "$ROOT/acp-probes/$n.md"
  # Latest summary for humans / acp_probe_failed
  tmp="$ROOT/.ACP-PROBE.md.$$.tmp"
  {
    printf 'status: %s\nprobed-epoch: %s\nnote: %s\nevent: acp-probes/%s.md\n' \
      "$status" "$now" "$note" "$n"
    printf '\nLatest ACP probe summary. History under acp-probes/.\n'
  } > "$tmp"
  mv "$tmp" "$ROOT/ACP-PROBE.md"
  printf '%s/ACP-PROBE.md\n' "$ROOT"
}

result_finalize() (
  id=$1; slug=$2; wid=$3; role=$4; agent=$5; outcome=$6; evidence=$7; fingerprint=$8; task=${9:--}
  ad=$(attempt_dir "$id"); d=$(D "$slug")
  if [ "$role" = judge ]; then
    word=$outcome
    case $outcome in NEEDS_CONTEXT|BLOCKED) word=INSUFFICIENT_EVIDENCE ;; esac
    verdict_tmp="$d/verdicts/.$agent.$$.tmp"
    printf 'VERDICT: %s\nWORK-ID: %s\nresult %s; see %s\n' \
      "$word" "$wid" "$id" "$evidence" > "$verdict_tmp"
    mv "$verdict_tmp" "$d/verdicts/$agent.md"
  fi
  repeated=0
  if [ "$outcome" = REJECT ] && [ "$fingerprint" != - ]; then
    for result_file in "$ROOT"/attempts/*/result.md; do
      [ -f "$result_file" ] || continue; [ "$result_file" = "$ad/result.md" ] && continue
      [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] || continue
      [ "$(sed -n 's/^FINDING-FINGERPRINT: //p' "$result_file" | head -1)" = "$fingerprint" ] || continue
      repeated=1; break
    done
  fi
  stage=$(state_value "$slug" 3); risk=$(state_value "$slug" 5)
  if [ "$repeated" -eq 1 ]; then
    result_status=BLOCKED; result_block=REPEATED_FINDING
  else
    case $outcome in
      PASS|REJECT) result_status=ACTIVE; result_block=- ;;
      BLOCKED) result_status=BLOCKED; result_block=RESULT_BLOCKED ;;
      NEEDS_CONTEXT) result_status=BLOCKED; result_block=NEEDS_CONTEXT ;;
      SCOPE_CONFLICT) result_status=BLOCKED; result_block=SCOPE_CONFLICT ;;
    esac
  fi
  if [ "$task" != - ]; then
    item_wid=$(workid "$slug")
    remaining=$(task_live_count "$slug")
    [ "$remaining" -eq 0 ] && task_inflight=- || task_inflight=TASKS
    state_update_item "$slug" "$result_status" "$stage" "$item_wid" "$risk" "$task_inflight" "$result_block"
  else
    state_update_item "$slug" "$result_status" "$stage" "$wid" "$risk" - "$result_block"
  fi
)

cmd_result() {
  uses_managed_lifecycle || die "result requires managed lifecycle behavior"
  id=${1:-}; outcome=${2:-}; evidence=${3:-}; next=${4:-}; fingerprint=${5:--}
  [ -n "$id" ] && [ -n "$outcome" ] && [ -n "$evidence" ] && [ -n "$next" ] \
    || die "usage: crucible result ATTEMPT OUTCOME EVIDENCE NEXT [FINGERPRINT]"
  case $outcome in PASS|REJECT|BLOCKED|NEEDS_CONTEXT|SCOPE_CONFLICT) : ;; *) die "invalid result outcome: $outcome" ;; esac
  case $next in CLOSE|FIX|DECIDE|ESCALATE) : ;; *) die "invalid result next action: $next" ;; esac
  case "$outcome:$next" in
    PASS:CLOSE|REJECT:FIX|BLOCKED:DECIDE|BLOCKED:ESCALATE|NEEDS_CONTEXT:DECIDE|NEEDS_CONTEXT:ESCALATE|SCOPE_CONFLICT:DECIDE|SCOPE_CONFLICT:ESCALATE) : ;;
    *) die "incompatible result: $outcome cannot request $next" ;;
  esac
  case $fingerprint in -|[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]) : ;; *) die "fingerprint must be - or 12 alphanumeric characters" ;; esac
  [ "$outcome" != REJECT ] || [ "$fingerprint" != - ] || die "REJECT requires a finding fingerprint"
  ad=$(attempt_dir "$id")
  rst=$(attempt_state "$id")
  if [ -d "$ROOT/.drive.lock" ]; then
    [ "$rst" = RUNNING ] \
      || die "refused: result while drive.lock exists must come from the RUNNING worker, not the coordinator"
  else
    [ "$rst" = RETURNED ] || die "result requires a RETURNED attempt"
  fi
  require_attempt_independence "$id"
  slug=$(attempt_meta "$id" 2); task=$(attempt_meta "$id" 3); dispatch_wid=$(attempt_meta "$id" 4)
  role=$(attempt_meta "$id" 5); agent=$(attempt_meta "$id" 6); kind=$(attempt_meta "$id" 7)
  criterion=$(attempt_meta "$id" 8); class=$(attempt_meta "$id" 9); d=$(D "$slug")
  relation=-; case $role in judge|adversary) relation=$(review_relation "$slug" "$agent") ;; esac
  transport=-; attempt_transport "$id" >/dev/null 2>&1 && transport=$(attempt_transport "$id")
  current_wid=$(workid "$slug")
  case $role in
    maker)
      if [ "$task" != - ]; then
        [ -f "$ad/task.tsv" ] || die "task attempt is missing task.tsv"
        task_repo=$(awk -F '\t' 'NR == 2 { print $1 }' "$ad/task.tsv")
        task_branch=$(awk -F '\t' 'NR == 2 { print $2 }' "$ad/task.tsv")
        wid=$(git -C "$task_repo" rev-parse --verify "$task_branch" | cut -c1-12)
        [ "$wid" != "$dispatch_wid" ] || die "task result requires work to change after dispatch"
        changed_count=0
        changed_paths=$(git -C "$task_repo" diff --name-only "$dispatch_wid..$wid")
        [ -n "$changed_paths" ] || die "task result has no changed paths"
        newline_count=$(git -C "$task_repo" diff --name-only -z "$dispatch_wid..$wid" | tr -cd '\000' | wc -c | tr -d ' ')
        line_count=$(printf '%s\n' "$changed_paths" | wc -l | tr -d ' ')
        [ "$newline_count" = "$line_count" ] || die "task result contains a newline in a Git path"
        while IFS= read -r changed_path; do
          task_owns_path "$slug" "$task" "$changed_path" \
            || die "task $task changed unowned path: $changed_path"
          changed_count=$((changed_count + 1))
        done <<EOF
$changed_paths
EOF
        [ "$changed_count" -gt 0 ] || die "task result has no changed paths"
      else
        [ "$current_wid" != EMPTY ] && [ "$current_wid" != NOBRANCH ] \
          || die "maker result requires current work"
        [ "$current_wid" != "$dispatch_wid" ] || die "maker result requires work to change after dispatch"
        wid=$current_wid
        if [ -f "$d/TARGET" ] && grep -q '^## Owned files' "$d/ITEM.md" 2>/dev/null; then
          r=$(tgt "$slug" repo); br=$(tgt "$slug" branch); base=$(tgt "$slug" base)
          owned=$(awk '/^## Owned files/{p=1;next} p && /^## /{exit} p && /^- /{sub(/^-[[:space:]]*/,""); print}' "$d/ITEM.md")
          if [ -n "$owned" ]; then
            changed_paths=$(git -C "$r" diff --name-only "${dispatch_wid}..${wid}" 2>/dev/null)
            while IFS= read -r changed_path; do
              [ -n "$changed_path" ] || continue
              okp=0
              for op in $owned; do
                case $changed_path in "$op"|"$op"/*) okp=1; break ;; esac
              done
              [ "$okp" -eq 1 ] \
                || die "refused: admitting this item does not authorize $changed_path (not in Owned files)"
            done <<EOF
$changed_paths
EOF
          fi
        fi
      fi ;;
    judge|adversary)
      [ "$current_wid" = "$dispatch_wid" ] \
        || die "work changed during $role attempt: dispatched $dispatch_wid, current $current_wid"
      wid=$dispatch_wid ;;
  esac
  case $evidence in */*|*'..'*|'') die "evidence must be one filename from the item evidence directory" ;; esac
  ef="$d/evidence/$evidence"
  [ -f "$ef" ] && [ ! -L "$ef" ] || die "missing regular evidence file: $evidence"
  [ "$(head -1 "$ef")" = "$MARK" ] || die "evidence was not recorded by crucible run"
  [ "$(sed -n 's/^agent: //p' "$ef" | head -1)" = "$agent" ] || die "evidence agent does not match attempt"
  [ "$(sed -n 's/^work-id: //p' "$ef" | head -1)" = "$wid" ] || die "evidence work id does not match attempt"
  [ "$(sed -n 's/^attempt-id: //p' "$ef" | head -1)" = "$id" ] || die "evidence attempt id does not match attempt"
  if [ -e "$ad/result.md" ]; then
    [ -f "$ad/result.md" ] && [ ! -L "$ad/result.md" ] || die "attempt result is immutable: $id"
    [ "$(sed -n 's/^OUTCOME: //p' "$ad/result.md" | head -1)" = "$outcome" ] \
      && [ "$(sed -n 's/^WORK-ID: //p' "$ad/result.md" | head -1)" = "$wid" ] \
      && [ "$(sed -n 's/^EVIDENCE: //p' "$ad/result.md" | head -1)" = "$evidence" ] \
      && [ "$(sed -n 's/^FINDING-FINGERPRINT: //p' "$ad/result.md" | head -1)" = "$fingerprint" ] \
      && [ "$(sed -n 's/^NEXT: //p' "$ad/result.md" | head -1)" = "$next" ] \
      || die "attempt result is immutable: $id"
    [ "$(state_value "$slug" 6)" = "$id" ] || die "attempt result is immutable: $id"
    result_finalize "$id" "$slug" "$wid" "$role" "$agent" "$outcome" "$evidence" "$fingerprint" "$task"
    printf '%s/result.md (reconciled publication)\n' "$ad"
    return
  fi
  if [ "$task" != - ]; then
    verify_script=$(awk -F '\t' 'NR == 2 { print $6 }' "$ad/task.tsv")
    verify_tmp="$ad/.task-verification.$$.tmp"
    verify_rc=0
    "$(D "$slug")/$verify_script" "$wid" > "$verify_tmp" 2>&1 || verify_rc=$?
    printf '\nexit: %s\n' "$verify_rc" >> "$verify_tmp"
    mv "$verify_tmp" "$ad/task-verification.txt"
    [ "$verify_rc" -eq 0 ] || die "task verifier failed for $task; see $ad/task-verification.txt"
  fi
  lock="$ad/.result.lock"; mkdir "$lock" 2>/dev/null || die "attempt result is immutable: $id"
  tmp="$ad/.result.$$.tmp"; trap 'rm -f "$tmp"' 0 1 2 15
  {
    printf 'OUTCOME: %s\nITEM: %s\nWORK-ID: %s\nDISPATCH-WORK-ID: %s\nATTEMPT-ID: %s\n' \
      "$outcome" "$slug" "$wid" "$dispatch_wid" "$id"
    printf 'ROLE: %s\nAGENT: %s\nKIND: %s\nREVIEW-RELATION: %s\nCRITERION: %s\n' \
      "$role" "$agent" "$kind" "$relation" "$criterion"
    printf 'TASK-ID: %s\nEVIDENCE-CLASS: %s\nEVIDENCE: %s\nTRANSPORT: %s\n' "$task" "$class" "$evidence" "$transport"
    printf 'FINDING-FINGERPRINT: %s\nNEXT: %s\n\nRecorded result for %s.\n' "$fingerprint" "$next" "$id"
  } > "$tmp"
  mv "$tmp" "$ad/result.md"; trap - 0 1 2 15
  result_finalize "$id" "$slug" "$wid" "$role" "$agent" "$outcome" "$evidence" "$fingerprint" "$task"
  printf '%s/result.md\n' "$ad"
}
# agents.tsv: name <TAB> kind <TAB> model <TAB> effort <TAB> command
# The command may contain {BRIEF} {MODEL} {EFFORT}. Only listed names may judge.
col() {
  [ -f "$ROOT/agents.tsv" ] || return 0
  grep -v '^#' "$ROOT/agents.tsv" 2>/dev/null | awk -F'\t' -v n="$1" -v c="$2" '$1==n{print $c; exit}'
}
kind_of() { col "$1" 2; }

record_maker() {
  slug=$1; agent=$2; d=$(D "$slug"); kind=$(kind_of "$agent")
  [ -s "$d/MAKER" ] || printf '%s\n' "$agent" > "$d/MAKER"
  [ -f "$d/MAKERS.tsv" ] || printf 'agent\tkind\n' > "$d/MAKERS.tsv"
  awk -F '\t' -v a="$agent" 'NR > 1 && $1 == a { found=1 } END { exit !found }' "$d/MAKERS.tsv" \
    || printf '%s\t%s\n' "$agent" "$kind" >> "$d/MAKERS.tsv"
}

is_maker() {
  slug=$1; agent=$2; d=$(D "$slug")
  if [ -f "$d/MAKERS.tsv" ]; then
    awk -F '\t' -v a="$agent" 'NR > 1 && $1 == a { found=1 } END { exit !found }' "$d/MAKERS.tsv"
    return
  fi
  [ -f "$d/MAKER" ] && [ "$(head -1 "$d/MAKER")" = "$agent" ]
}

review_relation() {
  slug=$1; reviewer=$2; d=$(D "$slug"); reviewer_kind=$(kind_of "$reviewer"); same=0; different=0
  if [ -f "$d/MAKERS.tsv" ]; then
    maker_names=$(awk -F '\t' 'NR > 1 { print $1 }' "$d/MAKERS.tsv")
  elif [ -s "$d/MAKER" ]; then
    maker_names=$(head -1 "$d/MAKER")
  else
    printf 'UNPROVEN'; return
  fi
  for maker_name in $maker_names; do
    maker_kind=$(kind_of "$maker_name")
    if [ -n "$maker_kind" ] && [ "$maker_kind" = "$reviewer_kind" ]; then same=1; else different=1; fi
  done
  if [ "$same" -eq 1 ] && [ "$different" -eq 1 ]; then printf 'MIXED-FAMILY'
  elif [ "$same" -eq 1 ]; then printf 'SAME-FAMILY'
  else printf 'CROSS-FAMILY'; fi
}

cmd_agents() {
  [ -f "$ROOT/agents.tsv" ] || die "no agents.tsv here"
  printf '%-10s %-8s %-22s %-8s %s\n' NAME KIND MODEL EFFORT COMMAND
  grep -v '^#' "$ROOT/agents.tsv" | grep -v '^[[:space:]]*$' |
    while IFS="$(printf '\t')" read -r n k m e c; do
      printf '%-10s %-8s %-22s %-8s %s\n' "$n" "$k" "${m:--}" "${e:--}" "${c:-(none)}"
    done
}

invocation() {
  n=$1; b=$2
  c=$(col "$n" 5); [ -n "$c" ] || { printf '(no command registered for %s — add column 5 to agents.tsv)' "$n"; return; }
  m=$(col "$n" 3); e=$(col "$n" 4)
  printf '%s' "$c" | sed -e "s|{BRIEF}|$b|g" -e "s|{MODEL}|${m:-}|g" -e "s|{EFFORT}|${e:-}|g"
}
reg() { [ -n "$(kind_of "$1")" ] || die "unregistered agent: $1 — add '$1<TAB>kind' to $ROOT/agents.tsv"; }

# Symlinks are refused: the target lives outside the tree and can change after a PASS
# without changing the work id. Newlines are refused: they truncate line-oriented reads.
faults() {
  [ -d "$1" ] || { printf 'missing directory %s\n' "$1"; return; }
  find "$1" -type l | while IFS= read -r l; do printf 'symlink not allowed: %s\n' "${l#"$1/"}"; done
  a=$(find "$1" -type f -exec printf 'x\n' \; | wc -l | tr -d ' ')
  b=$(find "$1" -type f -print | wc -l | tr -d ' ')
  [ "$a" = "$b" ] || printf 'a filename under %s contains a newline\n' "$1"
}

tgt() { sed -n "s/^$2: //p" "$(D "$1")/TARGET" 2>/dev/null | head -1; }

cmd_target() {
  need "${1:-}"; slug=$1; repo=${2:-}; br=${3:-}; base=${4:-}
  [ -n "$repo" ] && [ -n "$br" ] && [ -n "$base" ] || die "usage: crucible target SLUG REPO BRANCH BASE"
  [ -d "$repo/.git" ] || [ -f "$repo/.git" ] || die "not a git repo: $repo"
  git -C "$repo" rev-parse --verify --quiet "$base" >/dev/null || die "no such base ref: $base"
  printf 'repo: %s\nbranch: %s\nbase: %s\n' "$repo" "$br" "$base" > "$(D "$slug")/TARGET"
  printf 'item %s now tracks %s branch %s off %s\n' "$slug" "$repo" "$br" "$base"
  printf 'the maker works in that repo on that branch, not in items/%s/work/\n' "$slug"
}

# Work id. In git mode this is the branch's COMMIT, not its tree: an empty commit leaves the
# tree identical, so a tree-based id let a commit land without voiding any verdict. In sandbox
# mode the mode bits are hashed alongside the content, because making a file executable is a
# change to the work that content hashing alone cannot see.
workid() {
  d=$(D "$1")
  if [ -f "$d/TARGET" ]; then
    r=$(tgt "$1" repo); b=$(tgt "$1" branch)
    c=$(git -C "$r" rev-parse --verify --quiet "$b" 2>/dev/null || true)
    [ -n "$c" ] && { printf '%s' "$c" | cut -c1-12; return; }
    printf 'NOBRANCH'; return
  fi
  [ -n "$(find "$d/work" -type f 2>/dev/null | head -1)" ] || { printf 'EMPTY'; return; }
  find "$d/work" -type f -print | LC_ALL=C sort | while IFS= read -r f; do
    m=$(ls -l "$f" 2>/dev/null | cut -c1-10)
    printf '%s %s %s\n' "${f#"$d/"}" "$m" "$(hashfile "$f")"
  done | h12
}

# What a judge is shown as "the work": a real diff in git mode, file contents in sandbox mode.
emit_work() {
  d=$(D "$1"); wid=$2
  if [ -f "$d/TARGET" ]; then
    r=$(tgt "$1" repo); b=$(tgt "$1" branch); base=$(tgt "$1" base)
    echo "Repository: $r"; echo "Branch: $b  Base: $base  Tree: $wid"; echo
    echo "### commits"; echo '```'; git -C "$r" log --oneline "$base..$b" 2>/dev/null || echo "(none)"; echo '```'
    echo "### files changed"; echo '```'; git -C "$r" diff --stat "$base..$b" 2>/dev/null; echo '```'
    echo "### diff"; echo '```diff'; git -C "$r" diff -U10 "$base..$b" 2>/dev/null; echo '```'
  else
    find "$d/work" -type f -print | LC_ALL=C sort | while IFS= read -r f; do
      echo "### ${f#"$d/"}"; echo '```'; cat "$f"; echo '```'; done
  fi
}

cmd_add() {
  slug=${1:-}; [ $# -eq 0 ] || shift; title=${*:-}
  [ -n "$slug" ] || die 'usage: crucible add SLUG "TITLE"'
  case $slug in *[!A-Za-z0-9._-]*) die "slug may only contain A-Za-z0-9._-" ;; esac
  if uses_managed_lifecycle; then
    state_validate_file "$ROOT/STATE.tsv"
    current=$(awk -F '\t' 'NR > 1 && ($2 == "ACTIVE" || $2 == "BLOCKED") { n++ } END { print n+0 }' "$ROOT/STATE.tsv")
    [ "$current" -eq 0 ] || die "refused: another item is current"
    if uses_guided_cycle; then
      panel_approval_current || die 'refused: the agent panel is not operator-approved'
      approval_current || die 'refused: the current PROPOSAL.md is not operator-approved'
    fi
  fi
  mkdir -p "$ROOT/items"
  [ -f "$ROOT/LESSONS.md" ] || : > "$ROOT/LESSONS.md"
  if [ ! -f "$ROOT/agents.tsv" ]; then
    { printf '# name\tkind\tmodel\teffort\tcommand   ({BRIEF} {MODEL} {EFFORT} are substituted)\n'
      printf '# Only names listed here may author a verdict. Repeat a kind for a same-kind panel.\n'
      have kiro-cli && printf 'lead\tkiro\tclaude-opus-5\tmax\tkiro-cli chat --no-interactive --trust-all-tools --model {MODEL} --effort {EFFORT} "read {BRIEF} and follow it exactly"\n'
      have kiro-cli && printf 'mk1\tkiro\tclaude-sonnet-5\thigh\tkiro-cli chat --no-interactive --trust-all-tools --model {MODEL} --effort {EFFORT} "read {BRIEF} and follow it exactly"\n'
      have kiro-cli && printf 'j1\tkiro\tclaude-opus-5\thigh\tkiro-cli chat --no-interactive --trust-all-tools --model {MODEL} --effort {EFFORT} "read {BRIEF} and follow it exactly"\n'
      have grok     && printf 'j2\tgrok\tgrok-4.5\thigh\tgrok -p "read {BRIEF} and follow it exactly" --model {MODEL}\n'
      have codex    && printf 'j3\tcodex\tgpt-5-codex\thigh\tcodex exec --skip-git-repo-check -m {MODEL} "read {BRIEF} and follow it exactly"\n'
      true; } > "$ROOT/agents.tsv"
    printf 'wrote %s — edit it to match the agents you will actually use\n' "$ROOT/agents.tsv"
  fi
  d=$(D "$slug"); [ -d "$d" ] && die "item exists: $slug"
  mkdir -p "$d/work" "$d/evidence" "$d/verdicts" "$d/briefs"
  if uses_managed_lifecycle; then
    cat > "$d/ITEM.md" <<EOF
# $slug — ${title:-untitled}

## Goal

${title:-Describe the work, and quote the report sentence that caused this item.}

## Non-goals

State what this item will not change.

## Risk

LOW

## Owned files

- List literal repository-relative paths before READY.

## Acceptance criteria

- [ ] A1

## Focused falsifier

TEMPLATE-FALSIFIER-UNWRITTEN. Replace this line with one bounded command or script.

## Expensive evidence

NONE

## Stop conditions

Stop and escalate if the frozen contract must change.
EOF
  else
    cat > "$d/ITEM.md" <<EOF
# $slug — ${title:-untitled}

PHASE: SPEC
STATUS: OPEN

## The ask

${title:-Describe the work, and quote the report sentence that caused this item.}

## Acceptance criteria

- [ ] A1

## Falsifier

TEMPLATE-FALSIFIER-UNWRITTEN. Replace this line: name the change to undo and the check
that must then fail. The gate refuses closure while this marker is present.
EOF
  fi
  if [ -f "$ROOT/PROGRAM" ]; then
    r=$(sed -n 's/^repo: //p' "$ROOT/PROGRAM" | head -1)
    b=$(sed -n 's/^base: //p' "$ROOT/PROGRAM" | head -1)
    [ -n "$r" ] && cmd_target "$slug" "$r" "ai/$slug" "${b:-main}" >/dev/null 2>&1 || true
  fi
  if uses_managed_lifecycle; then
    state_add_item "$slug" "$(workid "$slug")" LOW
  fi
  printf '%s/ITEM.md\n' "$d"
  if uses_managed_lifecycle; then
    printf 'next: complete the frozen contract, then\n'
    printf '      %s ready %s\n' "$(self_path)" "$slug"
  else
    printf 'next: write the ask, criteria and falsifier into that file, then\n'
    printf '      crucible brief %s maker <name>\n' "$slug"
  fi
}

cmd_brief() {
  need "${1:-}"; slug=$1; role=${2:-}; name=${3:-}
  [ -n "$name" ] || die "usage: crucible brief SLUG maker|judge NAME"
  reg "$name"
  d=$(D "$slug"); wid=$(workid "$slug"); self=$(self_path)
  case $role in
  maker)
    printf '%s\n' "$name" > "$d/MAKER"
    out="$d/briefs/maker.md"
    { echo "# Maker brief: $slug"
      echo
      echo "You are $name, the maker. Do the work described below."
      echo
      if [ -f "$d/TARGET" ]; then
        echo "Work in the repository **$(tgt "$slug" repo)** on branch **$(tgt "$slug" branch)**,"
        echo "which branches from **$(tgt "$slug" base)**. Commit there. Do not push."
      else
        echo "Write your changes only under \`$d/work/\`. Do not create symlinks and do not put"
        echo "newlines in filenames; both are refused."
      fi
      echo
      echo "Do not write to \`$d/evidence/\` by hand — hand-written evidence is refused. To record"
      echo "a check, have this run it for you:"
      echo
      echo "    $self run $slug $name -- <your command>"
      echo
      echo "That captures the command, its exit status and its output, and stamps it with the"
      echo "work id at the moment it ran, so it cannot be relabelled later."
      echo
      echo "Do not write to \`$d/verdicts/\` or edit \`$d/ITEM.md\`. Ask the orchestrator if the"
      echo "acceptance criteria are wrong."
      echo
      echo "Run \`$self check $slug\` to see what still refuses. When only the judge count"
      echo "refuses, you are done."
      echo; echo "---"; echo; cat "$d/ITEM.md"
      if [ -s "$ROOT/LESSONS.md" ]; then
        echo; echo "---"; echo; echo "## Lessons from earlier items — these bind you"; echo
        cat "$ROOT/LESSONS.md"
      fi
    } > "$out"
    printf '%s\n' "$out" ;;
  judge)
    [ "$wid" = EMPTY ] && die "refused: no work yet, so there is nothing to judge"
    maker=""; [ -f "$d/MAKER" ] && maker=$(head -1 "$d/MAKER")
    [ "$name" = "$maker" ] && die "refused: $name is the maker of $slug"
    out="$d/briefs/judge-$name.md"
    { echo "# Judge brief: $slug"
      echo
      echo "You are $name, an independent judge. You have no knowledge of how this was built."
      echo "You get the goal, the work, and the recorded evidence. There is no implementer"
      echo "report or rationale here."
      echo
      echo "Verify by running things, not by reading. Record every check you run with:"
      echo
      echo "    $self run $slug $name -- <your command>"
      echo
      echo "A PASS is refused unless you recorded at least one check yourself."
      echo
      echo "Then write \`$d/verdicts/$name.md\`, and no other file. First two lines exactly:"
      echo
      echo "    VERDICT: PASS"
      echo "    WORK-ID: $wid"
      echo
      echo "Use REJECT, INSUFFICIENT_EVIDENCE or SCOPE_CONFLICT instead of PASS as warranted."
      echo "PASS also requires that you ran the falsifier in the item and cite its output."
      echo "REJECT requires file:line for every finding. If you cannot decide from what you"
      echo "have, return INSUFFICIENT_EVIDENCE and name the missing artifact — never PASS."
      echo
      echo "The evidence below was recorded by other agents. It cannot be stale, but nothing"
      echo "proves it was a meaningful check. Re-derive anything you rely on."
      echo; echo "## The goal"; echo; cat "$d/ITEM.md"
      echo; echo "## The work — work id $wid"; echo
      emit_work "$slug" "$wid"
      echo; echo "## Recorded evidence"; echo
      if [ -z "$(find "$d/evidence" -type f 2>/dev/null | head -1)" ]; then
        echo "(none. Absence of evidence is a finding, never a pass.)"
      else
        find "$d/evidence" -type f -print | LC_ALL=C sort | while IFS= read -r f; do
          echo "### ${f##*/}"; echo '```'; cat "$f"; echo '```'; done
      fi
    } > "$out"
    printf '%s\n' "$out" ;;
  *) die "role must be maker or judge" ;;
  esac
}

cmd_run_claim() {
  cn=${1:-}; name=${2:-}; shift 2 2>/dev/null || die "usage: crucible run-claim CN NAME -- CMD..."
  [ "${1:-}" = "--" ] || die "usage: crucible run-claim CN NAME -- CMD..."
  shift; [ $# -gt 0 ] || die "no command given"
  reg "$name"
  cdir="$ROOT/claims/$cn"; [ -d "$cdir" ] || die "no such claim: $cn"
  mkdir -p "$cdir/evidence"
  RUN_SEQ=$((${RUN_SEQ:-0} + 1)); tok="p$$s$RUN_SEQ"
  out="$cdir/evidence/$name.$tok.txt"; tmp="$cdir/evidence/.partial.$name.$tok"
  { printf '%s\n' "$MARK"; printf 'agent: %s\nclaim: %s\n' "$name" "$cn"
    printf 'when: %s\ncommand:' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for a in "$@"; do printf ' %s' "$a"; done; printf '\n--- output ---\n'; } > "$tmp"
  rc=0; "$@" >> "$tmp" 2>&1 || rc=$?
  printf -- '--- exit %s ---\n' "$rc" >> "$tmp"; mv "$tmp" "$out"
  printf '%s (exit %s)\n' "$out" "$rc"; return 0
}

cmd_run() {
  need "${1:-}"; slug=$1; name=${2:-}; shift 2 2>/dev/null || die "usage: crucible run SLUG NAME -- CMD..."
  [ "${1:-}" = "--" ] || die "usage: crucible run SLUG NAME -- CMD..."
  shift; [ $# -gt 0 ] || die "no command given"
  reg "$name"; d=$(D "$slug"); wid=$(workid "$slug")
  run_attempt=-
  if uses_managed_lifecycle; then
    run_attempt=$(state_value "$slug" 6)
    [ "$run_attempt" != - ] || die "managed evidence requires an in-flight attempt"
    if [ "$run_attempt" = TASKS ]; then
      run_cwd=$(pwd -P)
      run_attempt=$(task_attempt_for_run "$slug" "$name" "$run_cwd" 2>/dev/null || true)
      [ -n "$run_attempt" ] || die "no live task attempt for $name in $run_cwd"
    fi
    run_agent=$(attempt_meta "$run_attempt" 6)
    [ "$run_agent" = "$name" ] || die "in-flight attempt belongs to $run_agent, not $name"
    run_state=$(attempt_state "$run_attempt")
    case $run_state in RUNNING|OVERDUE) : ;;
      *) die "managed evidence requires a RUNNING or OVERDUE attempt" ;;
    esac
    run_task=$(attempt_meta "$run_attempt" 3)
    if [ "$run_task" != - ]; then
      task_repo=$(awk -F '\t' 'NR == 2 { print $1 }' "$ROOT/attempts/$run_attempt/task.tsv")
      task_branch=$(awk -F '\t' 'NR == 2 { print $2 }' "$ROOT/attempts/$run_attempt/task.tsv")
      wid=$(git -C "$task_repo" rev-parse --verify "$task_branch" | cut -c1-12)
    fi
  fi
  # The name is unique by construction. Asking whether a name is free and then taking
  # it is a check-then-act race: two concurrent runs both see it free, both take it,
  # and one silently overwrites the other. The pid separates concurrent writers, the
  # counter separates sequential ones.
  RUN_SEQ=$((${RUN_SEQ:-0} + 1)); tok="p$$s$RUN_SEQ"
  out="$d/evidence/$name.$tok.$wid.txt"
  tmp="$d/evidence/.partial.$name.$tok.$wid"
  { printf '%s\n' "$MARK"; printf 'agent: %s\n' "$name"; printf 'work-id: %s\n' "$wid"
    [ "$run_attempt" = - ] || printf 'attempt-id: %s\n' "$run_attempt"
    printf 'when: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; printf 'command:'
    for a in "$@"; do printf ' %s' "$a"; done; printf '\n'; printf -- '--- output ---\n'; } > "$tmp"
  rc=0; "$@" >> "$tmp" 2>&1 || rc=$?
  printf -- '--- exit %s ---\n' "$rc" >> "$tmp"
  # Publish atomically: until this rename nothing can read a partial file, which is why
  # a recorded command that inspects the evidence directory no longer sees its own
  # incomplete header and call it truncated.
  mv "$tmp" "$out"
  printf '%s (exit %s)\n' "$out" "$rc"
  return 0
}

# A claim-auditor judges a CLAIM, which is not an item and has no work tree. Dispatching
# against a claim id used to refuse with "no such item", which made BOOTSTRAP step 5 — the
# fact-checking step, the one that earns everything else — impossible to follow.
cmd_dispatch_claim() {
  cn=$1; role=${2:-}; name=${3:-}
  [ -n "$role" ] && [ -n "$name" ] || die "usage: crucible dispatch CN ROLE AGENT"
  require_panel_approval
  rf="$ROOT/roles/$role.md"; [ -f "$rf" ] || die "no such role: $role"
  reg "$name"
  require_role_cast "$role" "$name"
  f=$(claims_file); [ -f "$f" ] || die "no CLAIMS.md here"
  grep -q "^### $cn " "$f" || die "no such claim: $cn"
  cdir="$ROOT/claims/$cn"; mkdir -p "$cdir/verdicts" "$cdir/dispatches" "$cdir/evidence"
  n=1; while [ -e "$cdir/dispatches/$n-$role-$name.md" ]; do n=$((n+1)); done
  out="$cdir/dispatches/$n-$role-$name.md"
  self=$(self_path)
  { echo "# Dispatch $n — $role — $name — claim $cn"
    echo
    echo "You are **$name**, acting as **$role**, auditing claim **$cn**. This file is your"
    echo "complete task. Read it and follow it exactly. If it is insufficient, return"
    echo "NEEDS_CONTEXT naming what is missing."
    echo
    echo "- **Purpose right now:** $(sed -n 's/^purpose: //p' "$rf" | head -1)"
    echo "- **You may read:** $(sed -n 's/^may-read: //p' "$rf" | head -1)"
    echo "- **You must not read:** $(sed -n 's/^must-not-read: //p' "$rf" | head -1)"
    echo "- **You must return:** $(sed -n 's/^return: //p' "$rf" | head -1)"
    echo "- **How to verify your own work:** $(sed -n 's/^verify: //p' "$rf" | head -1)"
    echo
    echo "Record every command you run:"
    echo
    echo "    $self run-claim $cn $name -- <command>"
    echo
    echo "Then record your result:"
    echo
    if [ "$role" = scout ]; then
      echo "- **You must write:** claims/$cn/evidence/ (via run-claim) and the scout result below"
      echo
      echo "    $self claim scout $cn ABSENT|PARTLY-EXISTS|FULLY-EXISTS $name"
      echo
      echo "FULLY-EXISTS means the repository already does this; it blocks admission, so say where."
      echo "PARTLY-EXISTS means some of it exists: name what does and what is missing, because the"
      echo "item will be narrowed to the gap. ABSENT is a claim in its own right, so list every"
      echo "search you ran and let it be checked. Search by behaviour, not by name — the thing that"
      echo "would be built rarely contains the words someone would call it."
      echo
      echo "Do not record a claim verdict. That surface is for claim-auditor only."
    else
      echo "    $self claim verdict $cn $name TRUE|FALSE|STALE|UNVERIFIABLE"
      echo
      echo "TRUE means true of the code as it exists now, cited to file:line. STALE means it was"
      echo "true and has since been fixed — cite the fix. UNVERIFIABLE means the code cannot settle"
      echo "it; name what is missing. Never guess, and never resolve doubt in favour of the claim."
    fi
    echo; echo "---"; echo; echo "## The claim"; echo
    awk -v c="### $cn " 'index($0,c)==1{p=1;print;next} p&&/^### C[0-9]/{exit} p{print}' "$f"
    echo; echo "---"; echo; echo "## Your role in full"; echo
    sed -n '/^## Instructions/,$p' "$rf"
    echo; echo "---"; echo; echo "## The rules that bind you"; echo
    cat "$ROOT/RULES.md" 2>/dev/null || echo "(RULES.md missing)"
  } > "$out"
  # Managed/guided programs also place claim work on the attempt independence ledger.
  attempt_id=
  if uses_managed_lifecycle; then
    mkdir -p "$ROOT/attempts"
    now=$(date +%s); n=1
    while :; do
      attempt_id="A$now.$$.${n}"
      staging="$ROOT/attempts/.$attempt_id.$$.tmp"
      [ ! -e "$ROOT/attempts/$attempt_id" ] && mkdir "$staging" 2>/dev/null && break
      n=$((n+1))
    done
    kind=$(kind_of "$name")
    printf 'attempt_id\titem\ttask_id\twork_id\trole\tagent\tkind\tcriterion\tevidence_class\tstate\tstarted_epoch\tdeadline_epoch\tretry_of\n' \
      > "$staging/meta.tsv"
    printf '%s\t%s\t-\tCLAIM\t%s\t%s\t%s\t-\tFOCUSED\tDISPATCHED\t%s\t%s\t-\n' \
      "$attempt_id" "$cn" "$role" "$name" "$kind" "$now" "$((now + 1800))" >> "$staging/meta.tsv"
    printf 'state\tepoch\tpid\treason\nDISPATCHED\t%s\t-\tdispatch-recorded\n' "$now" > "$staging/events.tsv"
    {
      cat "$out"
      if [ "$role" != scout ]; then
        printf '\n## Independence seal (before verdict)\n\n'
        printf 'While DISPATCHED, record transport and a contract-audit PASS:\n\n'
        printf '    %s attempt transport %s multi-agent|acp|subagent\n' "$self" "$attempt_id"
        printf '    %s contract-audit %s <contract-auditor> PASS\n' "$self" "$attempt_id"
      fi
    } > "$staging/contract.md"
    printf 'claim-dispatch: %s\n' "${out#"$ROOT"/}" > "$staging/claim-dispatch.txt"
    mv "$staging" "$ROOT/attempts/$attempt_id"
    printf 'attempt-id: %s\n' "$attempt_id" >> "$out"
  fi
  printf '%s\n' "$out"
  if [ -n "$attempt_id" ]; then
    printf 'attempt %s (claim independence ledger)\n' "$attempt_id" >&2
  fi
  { printf '\n# %s as %s on claim %s. Run this:\n' "$name" "$role" "$cn"
    printf '%s\n' "$(invocation "$name" "$out")"; } >&2
}

cmd_dispatch_managed() (
  slug=$1; role=${2:-}; agent=${3:-}; criterion=${4:-A1}; class=${5:-FOCUSED}; retry=${6:--}; task=${7:--}
  need "$slug"
  [ -n "$role" ] && [ -n "$agent" ] || die "usage: crucible dispatch ITEM ROLE AGENT [CRITERION] [EVIDENCE_CLASS] [RETRY_OF]"
  require_panel_approval
  case $criterion in *[!A-Za-z0-9._-]*|'') die "invalid criterion: $criterion" ;; esac
  criterion_exists=$(awk -v c="$criterion" '
    /^- \[[ xX]\] / {
      line=$0; sub(/^- \[[ xX]\] /, "", line); split(line, part, /[:@ ]/)
      if (part[1] == c) { print "yes"; exit }
    }
  ' "$(D "$slug")/ITEM.md")
  [ "$criterion_exists" = yes ] || die "criterion is not declared by the item: $criterion"
  case $class in FOCUSED|FULL_SUITE|EXTERNAL|MANUAL) : ;; *) die "invalid evidence class: $class" ;; esac
  role_file="$ROOT/roles/$role.md"; [ -f "$role_file" ] || die "no such role: $role"
  reg "$agent"
  require_role_cast "$role" "$agent"
  dispatch_lock="$ROOT/.dispatch.lock"; staging=
  mkdir "$dispatch_lock" 2>/dev/null || die "managed dispatch already in progress"
  # shellcheck disable=SC2329  # invoked by the EXIT trap below
  dispatch_cleanup() {
    dispatch_status=$?
    if [ -n "$staging" ]; then
      rm -f "$staging/meta.tsv" "$staging/events.tsv" "$staging/contract.md" "$staging/task.tsv"
      rmdir "$staging" 2>/dev/null || true
    fi
    rmdir "$dispatch_lock" 2>/dev/null || true
    trap - 0
    exit "$dispatch_status"
  }
  trap dispatch_cleanup 0
  trap 'exit 130' 1 2 15
  d=$(D "$slug"); stage=$(phase_of "$slug"); wid=$(workid "$slug")
  case $role in
    maker) [ "$stage" = BUILD ] || die "maker dispatch requires BUILD"
      if uses_guided_cycle; then
        [ -f "$d/plan-audit.md" ] && grep -q '^VERDICT: PASS' "$d/plan-audit.md" \
          || die "refused: maker dispatch requires plan-audit PASS"
      fi
      if [ -f "$d/TASKS.tsv" ]; then
        [ "$task" != - ] || die "item uses a task DAG; dispatch through: $(self_path) task dispatch"
        [ -n "$(task_field "$slug" "$task" 1)" ] || die "no such task: $task"
        deps=$(task_field "$slug" "$task" 2)
        case $deps in *,*) die "task execution with multiple direct dependencies is not available: $task" ;; esac
        task_dependencies_pass "$slug" "$deps" || die "task dependencies have not passed: $task"
        task_pass_exists "$slug" "$task" && die "task already has PASS: $task"
        live_task=$(task_live_attempt "$slug" "$task" 2>/dev/null || true)
        [ -z "$live_task" ] || die "task already has live attempt $live_task"
        pending_retry=$(task_retry_available "$slug" "$task" 2>/dev/null || true)
        if [ -n "$pending_retry" ] && [ "$retry" = - ]; then
          die "task $task requires retry of $pending_retry"
        fi
        max_parallel=${CRUCIBLE_MAX_PARALLEL_MAKERS:-3}; posint "$max_parallel" \
          || die "CRUCIBLE_MAX_PARALLEL_MAKERS must be a positive integer"
        live_count=$(task_live_count "$slug")
        [ "$live_count" -lt "$max_parallel" ] \
          || die "parallel maker limit reached: $live_count/$max_parallel"
        [ -f "$d/TARGET" ] || die "task dispatch requires a Git target"
      else
        [ "$task" = - ] || die "item has no task DAG: $slug"
      fi ;;
    judge|adversary) [ "$stage" = REVIEW ] || die "$role dispatch requires REVIEW"
      is_maker "$slug" "$agent" && die "refused: $agent is a maker of $slug" ;;
    *) die "managed lifecycle dispatch role must be maker, judge, or adversary" ;;
  esac
  if [ "$task" != - ]; then
    task_repo=$(tgt "$slug" repo); item_branch=$(tgt "$slug" branch); item_base=$(tgt "$slug" base)
    if ! git -C "$task_repo" rev-parse --verify --quiet "$item_branch" >/dev/null; then
      git -C "$task_repo" branch "$item_branch" "$item_base" >/dev/null \
        || die "could not create item integration branch $item_branch from $item_base"
    fi
    if [ "$deps" = - ]; then
      wid=$(git -C "$task_repo" rev-parse --verify "$item_branch" | cut -c1-12)
    else
      dependency_result=$(task_result_file "$slug" "$deps")
      wid=$(sed -n 's/^WORK-ID: //p' "$dependency_result" | head -1)
    fi
  fi
  if [ "$retry" != - ]; then
    attempt_dir "$retry" >/dev/null
    [ "$(attempt_state "$retry")" = TIMEOUT ] || die "retry source must be an observed TIMEOUT"
    [ "$(attempt_meta "$retry" 13)" = - ] || die "refused: only one infrastructure retry is allowed"
    [ "$(attempt_meta "$retry" 2)" = "$slug" ] && [ "$(attempt_meta "$retry" 3)" = "$task" ] \
      && [ "$(attempt_meta "$retry" 5)" = "$role" ] \
      && [ "$(attempt_meta "$retry" 6)" = "$agent" ] && [ "$(attempt_meta "$retry" 8)" = "$criterion" ] \
      && [ "$(attempt_meta "$retry" 9)" = "$class" ] && [ "$(attempt_meta "$retry" 4)" = "$wid" ] \
      || die "retry key does not match the prior attempt"
  fi
  [ "$(state_value "$slug" 2)" = ACTIVE ] || die "item is not active: $slug"
  recorded_inflight=$(state_value "$slug" 6)
  if [ "$task" != - ] && { [ "$recorded_inflight" = - ] || [ "$recorded_inflight" = TASKS ]; }; then
    :
  elif [ "$retry" != - ] && [ "$recorded_inflight" = "$retry" ]; then
    :
  else
    [ "$recorded_inflight" = - ] \
      || die "refused: item already has in-flight attempt $recorded_inflight"
  fi
  live=$(attempt_live_for "$slug" "$role" "$criterion" "$task" 2>/dev/null || true)
  [ -z "$live" ] || die "refused: live attempt $live already owns $slug/$role/$criterion"
  attempt_pass_exists "$slug" "$wid" "$role" "$agent" "$criterion" "$task" \
    && die "refused: $agent already has current-work PASS for $role/$criterion"
  case $class in FULL_SUITE|EXTERNAL)
    canonical_pass_exists "$slug" "$wid" "$class" \
      && die "refused: canonical $class PASS already exists for $slug at $wid" ;;
  esac
  case $role in
    maker) seconds=${CRUCIBLE_MAKER_SECONDS:-2700} ;;
    judge|adversary) seconds=${CRUCIBLE_REVIEW_SECONDS:-1800} ;;
  esac
  posint "$seconds" || die "attempt budget must be a positive integer"
  mkdir -p "$ROOT/attempts"
  now=$(date +%s); n=1
  while :; do
    id="A$now.$$.${n}"
    target_attempt="$ROOT/attempts/$id"
    staging="$ROOT/attempts/.$id.$$.tmp"
    [ ! -e "$target_attempt" ] && mkdir "$staging" 2>/dev/null && break
    n=$((n+1))
  done
  if [ "$task" != - ]; then
    program=$(sed -n 's/^program: //p' "$ROOT/PROGRAM" | head -1)
    task_branch="ai/${program}-${slug}-${task}-${id}"
    task_worktree="$ROOT/worktrees/$id"
    mkdir -p "$ROOT/worktrees"
    git -C "$task_repo" worktree add -q -b "$task_branch" "$task_worktree" "$wid" \
      || die "could not create isolated worktree for $task"
  fi
  ad=$staging
  deadline=$((now + seconds)); kind=$(kind_of "$agent")
  printf 'attempt_id\titem\ttask_id\twork_id\trole\tagent\tkind\tcriterion\tevidence_class\tstate\tstarted_epoch\tdeadline_epoch\tretry_of\n' > "$ad/meta.tsv"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tDISPATCHED\t%s\t%s\t%s\n' \
    "$id" "$slug" "$task" "$wid" "$role" "$agent" "$kind" "$criterion" "$class" "$now" "$deadline" "$retry" >> "$ad/meta.tsv"
  printf 'state\tepoch\tpid\treason\nDISPATCHED\t%s\t-\tdispatch-recorded\n' "$now" > "$ad/events.tsv"
  if [ "$task" != - ]; then
    printf 'repo\tbranch\tworktree\titem_branch\tpaths_file\tverify_script\n' > "$ad/task.tsv"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$task_repo" "$task_branch" "$task_worktree" "$item_branch" \
      "$(task_field "$slug" "$task" 3)" "$(task_field "$slug" "$task" 4)" >> "$ad/task.tsv"
  fi
  self=$(self_path)
  [ "$task" = - ] || self="$ROOT/crucible"
  {
    printf '# Attempt %s — %s — %s\n\n' "$id" "$role" "$slug"
    printf 'This attempt is bound to item `%s`, task `%s`, work `%s`, criterion `%s`, and evidence class `%s`.\n\n' "$slug" "$task" "$wid" "$criterion" "$class"
    printf 'Read this file and follow it exactly. Do not accept coach notes outside this contract.\n\n'
    printf '## Independence seal (before start)\n\n'
    printf 'While DISPATCHED, record transport and a contract-audit PASS:\n\n'
    printf '    %s attempt transport %s multi-agent|acp|subagent\n' "$self" "$id"
    printf '    %s contract-audit %s <contract-auditor> PASS\n\n' "$self" "$id"
    printf 'Then record the observed PID:\n\n    %s attempt start %s <PID>\n\n' "$self" "$id"
    printf 'Record commands through:\n\n    %s run %s %s -- <command>\n\n' "$self" "$slug" "$agent"
    printf 'When the process exits, record RETURNED, TIMEOUT, STOPPED, or ABANDONED:\n\n'
    printf '    %s attempt finish %s <STATE> "<observation>"\n\n' "$self" "$id"
    printf 'After RETURNED, record exactly one result:\n\n'
    printf '    %s result %s <OUTCOME> <EVIDENCE-FILE> <NEXT> [FINGERPRINT]\n\n' "$self" "$id"
    printf '## Role\n\n'; sed -n '/^## Instructions/,$p' "$role_file"
    printf '\n## Item\n\n'; cat "$d/ITEM.md"
    if [ "$role" = maker ]; then
      printf '\n## Work location\n\n'
      if [ "$task" != - ]; then
        printf 'Work only in isolated worktree `%s` on branch `%s`.\n\n' "$task_worktree" "$task_branch"
        printf 'Owned paths:\n\n'
        while IFS= read -r owned_path; do printf -- '- `%s`\n' "$owned_path"; done < "$d/$(task_field "$slug" "$task" 3)"
        printf '\nBefore returning, commit your changes and run the task verifier through `crucible run`:\n\n'
        printf '    %s run %s %s -- %s/%s <task-commit>\n' "$self" "$slug" "$agent" "$d" "$(task_field "$slug" "$task" 4)"
      elif [ -f "$d/TARGET" ]; then
        printf 'Repository: `%s`\n\nBranch: `%s`\n\nBase: `%s`\n' \
          "$(tgt "$slug" repo)" "$(tgt "$slug" branch)" "$(tgt "$slug" base)"
      else
        printf 'Write only under `%s/work/`.\n' "$d"
      fi
      printf '\n## Maker inner loop\n\n'
      printf 'Run the item falsifier until it passes, or stop after one infrastructure retry.\n'
      printf 'Do not admit the next backlog row. Do not merge.\n'
    else
      printf '\n## Review independence\n\nRelation to recorded maker families: `%s`.\n' \
        "$(review_relation "$slug" "$agent")"
      printf '\n## Work — work id %s\n\n' "$wid"
      emit_work "$slug" "$wid"
      printf '\n## Recorded evidence\n\n'
      if [ -z "$(find "$d/evidence" -type f 2>/dev/null | head -1)" ]; then
        printf '(none. Absence of evidence is a finding, never a pass.)\n'
      else
        find "$d/evidence" -type f -print | LC_ALL=C sort | while IFS= read -r evidence_file; do
          printf '### %s\n```\n' "${evidence_file##*/}"
          cat "$evidence_file"
          printf '```\n'
        done
      fi
    fi
    printf '\n## Rules\n\n'; cat "$ROOT/RULES.md" 2>/dev/null || true
  } > "$ad/contract.md"
  mv "$staging" "$target_attempt"
  staging=
  ad=$target_attempt
  [ "$role" = maker ] && record_maker "$slug" "$agent"
  risk=$(state_value "$slug" 5)
  if [ "$task" != - ]; then
    item_wid=$(workid "$slug")
    (state_update_item "$slug" ACTIVE "$stage" "$item_wid" "$risk" TASKS -)
  else
    (state_update_item "$slug" ACTIVE "$stage" "$wid" "$risk" "$id" -)
  fi
  printf '%s/contract.md\n' "$ad"
  { printf '\n# %s as %s. Run this:\n' "$agent" "$role"
    printf '%s\n' "$(invocation "$agent" "$ad/contract.md")"; } >&2
  rmdir "$dispatch_lock"; dispatch_lock=
  trap - 0 1 2 15
)

cmd_dispatch() {
  slug=${1:-}; role=${2:-}; name=${3:-}
  [ -n "$slug" ] && [ -n "$role" ] && [ -n "$name" ] \
    || die "usage: crucible dispatch CN|ITEM ROLE AGENT"
  case $slug in C[0-9]*) cmd_dispatch_claim "$@"; return $? ;; esac
  if uses_managed_lifecycle; then cmd_dispatch_managed "$@"; return $?; fi
  need "$slug"
  [ -n "$role" ] && [ -n "$name" ] || die "usage: crucible dispatch SLUG ROLE AGENT"
  require_panel_approval
  rf="$ROOT/roles/$role.md"; [ -f "$rf" ] || die "no such role: $role (see $ROOT/roles/)"
  reg "$name"; d=$(D "$slug"); wid=$(workid "$slug"); self=$(self_path)
  ph=$(phase_of "$slug")
  fld() { sed -n "s/^$1: //p" "$rf" | head -1; }
  maker=""; [ -f "$d/MAKER" ] && maker=$(head -1 "$d/MAKER")
  case $role in
    judge|adversary) case $wid in EMPTY|NOBRANCH) die "refused: no work yet, nothing to judge" ;; esac
                     [ "$name" = "$maker" ] && die "refused: $name is the maker of $slug"
                     # Archive a verdict this agent gave on different work rather than letting it be
                     # overwritten. Without this the defect history is unreproducible: each round's
                     # findings vanish when the next round's verdict lands on the same filename.
                     old="$d/verdicts/$name.md"
                     if [ -f "$old" ]; then
                       ow=$(sed -n 's/^WORK-ID: //p' "$old" | head -1)
                       if [ -n "$ow" ] && [ "$ow" != "$wid" ]; then
                         mkdir -p "$d/verdicts/history"
                         a="$d/verdicts/history/$ow-$name.md"
                         n2=1; while [ -e "$a" ]; do a="$d/verdicts/history/$ow-$name.$n2.md"; n2=$((n2+1)); done
                         mv "$old" "$a"
                         printf 'archived the superseded verdict: %s\n' "${a#"$ROOT/"}" >&2
                       fi
                     fi ;;
    maker) printf '%s\n' "$name" > "$d/MAKER" ;;
  esac
  mkdir -p "$d/dispatches"
  n=1; while [ -e "$d/dispatches/$n-$role-$name.md" ]; do n=$((n+1)); done
  out="$d/dispatches/$n-$role-$name.md"
  { echo "# Dispatch $n — $role — $name"
    echo
    echo "You are **$name**, acting as **$role**, on item **$slug**, phase **$ph**."
    echo "This file is your complete task. Read it and follow it exactly. Do not ask for more"
    echo "context: if this file is insufficient, return NEEDS_CONTEXT naming what is missing."
    echo
    echo "- **Purpose right now:** $(fld purpose)"
    echo "- **You may read:** $(fld may-read)"
    echo "- **You must not read:** $(fld must-not-read)"
    echo "- **You must write:** $(fld must-write)"
    echo "- **You may dispatch:** $(fld may-call)"
    echo "- **You must return:** $(fld return)"
    echo "- **How to verify your own work:** $(fld verify)"
    echo
    echo "Record every command you run, and name at least one of those files in what you write:"
    echo
    echo "    $self run $slug $name -- <command>"
    echo
    echo "Hand-written evidence is refused. Check what still blocks this item with"
    echo "\`$self check $slug\`. Current work id: **$wid**."
    if [ -f "$d/TARGET" ]; then
      echo
      echo "**Where the work lives:** repository \`$(tgt "$slug" repo)\`, branch"
      echo "\`$(tgt "$slug" branch)\`, branched from \`$(tgt "$slug" base)\`. Commit there."
      echo "Do not push, do not merge, do not touch any other branch. The work id above is that"
      echo "branch's tree, so every commit changes it and voids any verdict already given."
      echo
      echo "**Order matters: commit first, then record your evidence.** Evidence is stamped with the"
      echo "branch tree at the moment it runs, so anything you record before your final commit goes"
      echo "stale the instant you commit. Finish the code, commit, then run your checks."
    else
      echo
      echo "**Where the work lives:** \`$d/work/\`. No symlinks, no newlines in filenames."
    fi
    if [ "$role" = judge ] || [ "$role" = adversary ]; then
      echo
      echo "Write your verdict to \`$d/verdicts/$name.md\`. First two lines exactly:"
      echo
      echo "    VERDICT: PASS"
      echo "    WORK-ID: $wid"
      echo
      echo "substituting REJECT, INSUFFICIENT_EVIDENCE or SCOPE_CONFLICT as warranted."
    fi
    echo; echo "---"; echo; echo "## Your role in full"; echo
    sed -n '/^## Instructions/,$p' "$rf"
    echo; echo "---"; echo; echo "## The rules that bind you"; echo
    cat "$ROOT/RULES.md" 2>/dev/null || echo "(RULES.md missing)"
    echo; echo "---"; echo; echo "## The item"; echo
    cat "$d/ITEM.md"
    for f in DESIGN.md TASKS.md; do
      [ -f "$d/$f" ] && { echo; echo "## $f"; echo; cat "$d/$f"; }
    done
    if [ -s "$ROOT/LESSONS.md" ] && [ "$role" != judge ] && [ "$role" != adversary ]; then
      echo; echo "## Lessons from earlier items — these bind you"; echo; cat "$ROOT/LESSONS.md"
    fi
    if [ "$role" = judge ] || [ "$role" = adversary ]; then
      echo; echo "## The work — work id $wid"; echo
      emit_work "$slug" "$wid"
      echo; echo "## Recorded evidence"; echo
      if [ -z "$(find "$d/evidence" -type f 2>/dev/null | head -1)" ]; then
        echo "(none. Absence of evidence is a finding, never a pass.)"
      else
        find "$d/evidence" -type f -print | LC_ALL=C sort | while IFS= read -r f; do
          echo "### ${f##*/}"; echo '```'; cat "$f"; echo '```'; done
      fi
    fi
  } > "$out"
  printf '%s\n' "$out"
  { printf '\n# %s as %s. Run this:\n' "$name" "$role"
    printf '%s\n' "$(invocation "$name" "$out")"
    printf '# or give %s any way you like, with exactly: read %s and follow it exactly\n' "$name" "$out"
  } >&2
}

item_section_body() {
  file=$1; heading=$2
  awk -v h="## $heading" '
    $0 == h { in_section=1; next }
    in_section && /^## / { exit }
    in_section && $0 !~ /^[[:space:]]*$/ { print }
  ' "$file"
}

validate_managed_item() {
  slug=$1; file=$(D "$slug")/ITEM.md
  expected=$(printf '%s\n' '## Goal' '## Non-goals' '## Risk' '## Owned files' \
    '## Acceptance criteria' '## Focused falsifier' '## Expensive evidence' '## Stop conditions')
  actual=$(grep '^## ' "$file" 2>/dev/null || true)
  [ "$actual" = "$expected" ] || die "refused: ITEM.md sections are missing, duplicated, or out of order"

  risk=$(item_section_body "$file" Risk)
  case $risk in LOW|MEDIUM|HIGH) : ;; *) die "refused: risk must be exactly LOW, MEDIUM, or HIGH" ;; esac

  owned_error=$(item_section_body "$file" 'Owned files' | awk '
    !/^- / { print "owned paths must be list items"; exit }
    {
      path=$0; sub(/^- /, "", path)
      if (path == "" || path ~ /^\// || path ~ /(^|\/)\.\.($|\/)/ || path ~ /(^|\/)\.($|\/)/ || path ~ /\/\// || path ~ /[*?\[]/) {
        print "unsafe owned path " path; exit
      }
      count++
    }
    END { if (!count) print "owned files are empty" }
  ')
  [ -z "$owned_error" ] || die "refused: $owned_error"

  criteria=$(item_section_body "$file" 'Acceptance criteria' | grep -Ec '^- \[[ xX]\] A[1-3]([:@ ]|$)' 2>/dev/null || true)
  criteria=${criteria:-0}
  [ "$criteria" -ge 1 ] && [ "$criteria" -le 3 ] || die "refused: need one to three A1-A3 acceptance criteria"

  falsifier=$(item_section_body "$file" 'Focused falsifier')
  [ -n "$falsifier" ] || die "refused: focused falsifier is empty"
  case $falsifier in *TEMPLATE-FALSIFIER-UNWRITTEN*) die "refused: focused falsifier is not written" ;; esac
  lines=$(printf '%s\n' "$falsifier" | wc -l | tr -d ' ')
  [ "$lines" -eq 1 ] || die "refused: focused falsifier must be one bounded command or script"
}

validate_task_dag() {
  slug=$1; d=$(D "$slug"); tasks="$d/TASKS.tsv"
  [ -f "$tasks" ] && [ ! -L "$tasks" ] || die "invalid TASKS.tsv: missing regular file"
  header=$(printf 'task_id\tdepends_on\tpaths_file\tverify_script')
  [ "$(sed -n '1p' "$tasks")" = "$header" ] || die "invalid TASKS.tsv: header mismatch"
  task_error=$(awk -F '\t' '
    NR == 1 { next }
    NF != 4 { print "row " NR " has " NF " fields, need 4"; exit }
    $1 !~ /^T[1-9][0-9]*$/ { print "invalid task id at row " NR; exit }
    seen[$1]++ { print "duplicate task id " $1; exit }
    $2 !~ /^(-|T[1-9][0-9]*(,T[1-9][0-9]*)*)$/ { print "invalid dependencies for " $1; exit }
    $3 !~ /^tasks\/[A-Za-z0-9._-]+\.paths$/ { print "invalid paths file for " $1; exit }
    $4 !~ /^tasks\/[A-Za-z0-9._-]+\.verify\.sh$/ { print "invalid verify script for " $1; exit }
    { count++ }
    END { if (!count) print "no tasks"; else if (count > 32) print "more than 32 tasks" }
  ' "$tasks")
  [ -z "$task_error" ] || die "invalid TASKS.tsv: $task_error"

  graph_error=$(awk -F '\t' '
    NR == 1 { next }
    { order[++n]=$1; deps[$1]=$2; exists[$1]=1 }
    END {
      edges=0
      for (i=1; i<=n; i++) {
        id=order[i]
        if (deps[id] == "-") continue
        count=split(deps[id], part, ",")
        for (j=1; j<=count; j++) {
          edges++
          if (!exists[part[j]]) { print "unknown dependency " part[j] " for " id; exit }
          if (part[j] == id) { print "dependency cycle at " id; exit }
        }
      }
      if (edges > 128) { print "more than 128 dependency edges"; exit }
      completed=0
      for (round=1; round<=n; round++) {
        progressed=0
        for (i=1; i<=n; i++) {
          id=order[i]; if (done[id]) continue
          ready=1
          if (deps[id] != "-") {
            count=split(deps[id], part, ",")
            for (j=1; j<=count; j++) if (!done[part[j]]) ready=0
          }
          if (ready) { done[id]=1; completed++; progressed=1 }
        }
        if (!progressed) break
      }
      if (completed != n) print "dependency cycle"
    }
  ' "$tasks")
  [ -z "$graph_error" ] || die "invalid TASKS.tsv: $graph_error"

  while IFS="$(printf '\t')" read -r task deps paths_file verify_script; do
    [ "$task" = task_id ] && continue
    paths="$d/$paths_file"; verify="$d/$verify_script"
    [ -f "$paths" ] && [ ! -L "$paths" ] || die "invalid task $task: missing regular $paths_file"
    [ -s "$paths" ] || die "invalid task $task: empty $paths_file"
    [ -f "$verify" ] && [ ! -L "$verify" ] || die "invalid task $task: missing regular $verify_script"
    [ -x "$verify" ] || die "invalid task $task: $verify_script is not executable"
    [ "$(sed -n '1p' "$verify")" = '#!/bin/sh' ] \
      || die "invalid task $task: $verify_script must start with #!/bin/sh"
  done < "$tasks"

  path_error=$(
    while IFS="$(printf '\t')" read -r task deps paths_file verify_script; do
      [ "$task" = task_id ] && continue
      while IFS= read -r owned_path || [ -n "$owned_path" ]; do
        printf '%s\t%s\n' "$task" "$owned_path"
      done < "$d/$paths_file"
    done < "$tasks" | awk -F '\t' '
      NF != 2 || $2 == "" { print "blank or malformed owned path"; exit }
      $2 ~ /^\// || $2 ~ /(^|\/)\.\.($|\/)/ || $2 ~ /(^|\/)\.($|\/)/ || $2 ~ /\/\// || $2 ~ /[*?\[]/ {
        print "unsafe owned path " $2 " for " $1; exit
      }
      {
        task[++n]=$1; path[n]=$2
        for (i=1; i<n; i++) {
          if (path[i] == path[n] || index(path[i], path[n] "/") == 1 || index(path[n], path[i] "/") == 1) {
            print "ownership overlap " path[i] " (" task[i] ") and " path[n] " (" task[n] ")"; exit
          }
        }
      }
    '
  )
  [ -z "$path_error" ] || die "invalid TASKS.tsv: $path_error"

  scope_error=$(
    {
      item_section_body "$d/ITEM.md" 'Owned files' | sed 's/^- /I\t/'
      while IFS="$(printf '\t')" read -r task deps paths_file verify_script; do
        [ "$task" = task_id ] && continue
        while IFS= read -r owned_path || [ -n "$owned_path" ]; do
          printf 'T\t%s\t%s\n' "$task" "$owned_path"
        done < "$d/$paths_file"
      done < "$tasks"
    } | awk -F '\t' '
      $1 == "I" { item[++n]=$2; next }
      $1 == "T" {
        allowed=0
        for (i=1; i<=n; i++) if ($3 == item[i] || index($3, item[i] "/") == 1) allowed=1
        if (!allowed) { print "task " $2 " owns undeclared item path " $3; exit }
      }
    '
  )
  [ -z "$scope_error" ] || die "invalid TASKS.tsv: $scope_error"
}

task_contract_id() {
  slug=$1; d=$(D "$slug"); tasks="$d/TASKS.tsv"
  {
    printf 'TASKS.tsv %s\n' "$(hashfile "$tasks")"
    while IFS="$(printf '\t')" read -r task deps paths_file verify_script; do
      [ "$task" = task_id ] && continue
      printf '%s %s %s %s\n' "$task" "$deps" "$paths_file" "$(hashfile "$d/$paths_file")"
      mode=$(ls -l "$d/$verify_script" | cut -c1-10)
      printf '%s %s %s\n' "$verify_script" "$mode" "$(hashfile "$d/$verify_script")"
    done < "$tasks"
  } | h12
}

task_assert_frozen() {
  slug=$1; d=$(D "$slug")
  [ -f "$d/TASKS.id" ] && [ ! -L "$d/TASKS.id" ] || die "task DAG is not frozen: $slug"
  frozen=$(sed -n '1p' "$d/TASKS.id"); current=$(task_contract_id "$slug")
  [ "$frozen" = "$current" ] || die "task DAG changed after READY: $frozen -> $current"
}

task_pass_exists() (
  slug=$1; task=$2
  [ -d "$ROOT/attempts" ] || return 1
  for result_file in "$ROOT"/attempts/*/result.md; do
    [ -f "$result_file" ] || continue
    [ "$(sed -n 's/^OUTCOME: //p' "$result_file" | head -1)" = PASS ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^TASK-ID: //p' "$result_file" | head -1)" = "$task" ] || continue
    return 0
  done
  return 1
)

task_field() {
  slug=$1; task=$2; column=$3
  awk -F '\t' -v t="$task" -v c="$column" 'NR > 1 && $1 == t { print $c; exit }' "$(D "$slug")/TASKS.tsv"
}

task_result_file() (
  slug=$1; task=$2
  [ -d "$ROOT/attempts" ] || return 1
  found=
  for result_file in "$ROOT"/attempts/*/result.md; do
    [ -f "$result_file" ] || continue
    [ "$(sed -n 's/^OUTCOME: //p' "$result_file" | head -1)" = PASS ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^TASK-ID: //p' "$result_file" | head -1)" = "$task" ] || continue
    found=$result_file
  done
  [ -n "$found" ] || return 1
  printf '%s' "$found"
)

task_live_attempt() (
  slug=$1; task=$2
  [ -d "$ROOT/attempts" ] || return 1
  for attempt_path in "$ROOT"/attempts/*; do
    [ -d "$attempt_path" ] || continue
    attempt_id=${attempt_path##*/}
    [ "$(attempt_meta "$attempt_id" 2)" = "$slug" ] || continue
    [ "$(attempt_meta "$attempt_id" 3)" = "$task" ] || continue
    attempt_status=$(attempt_state "$attempt_id")
    if ! attempt_terminal "$attempt_status" || { [ "$attempt_status" = RETURNED ] && [ ! -f "$attempt_path/result.md" ]; }; then
      printf '%s' "$attempt_id"; return 0
    fi
  done
  return 1
)

task_retry_available() (
  slug=$1; task=$2
  [ -d "$ROOT/attempts" ] || return 1
  for attempt_path in "$ROOT"/attempts/*; do
    [ -d "$attempt_path" ] || continue
    attempt_id=${attempt_path##*/}
    [ "$(attempt_meta "$attempt_id" 2)" = "$slug" ] || continue
    [ "$(attempt_meta "$attempt_id" 3)" = "$task" ] || continue
    [ "$(attempt_meta "$attempt_id" 13)" = - ] || continue
    [ "$(attempt_state "$attempt_id")" = TIMEOUT ] || continue
    retried=0
    for child_path in "$ROOT"/attempts/*; do
      [ -d "$child_path" ] || continue
      child_id=${child_path##*/}
      [ "$(attempt_meta "$child_id" 13)" = "$attempt_id" ] && { retried=1; break; }
    done
    [ "$retried" -eq 1 ] || { printf '%s' "$attempt_id"; return 0; }
  done
  return 1
)

task_live_count() (
  slug=$1; count=0
  [ -d "$ROOT/attempts" ] || { printf '0'; return; }
  for attempt_path in "$ROOT"/attempts/*; do
    [ -d "$attempt_path" ] || continue
    attempt_id=${attempt_path##*/}
    [ "$(attempt_meta "$attempt_id" 2)" = "$slug" ] || continue
    [ "$(attempt_meta "$attempt_id" 3)" != - ] || continue
    attempt_status=$(attempt_state "$attempt_id")
    if ! attempt_terminal "$attempt_status" || { [ "$attempt_status" = RETURNED ] && [ ! -f "$attempt_path/result.md" ]; }; then
      count=$((count + 1))
    fi
  done
  printf '%s' "$count"
)

task_attempt_for_run() (
  slug=$1; agent=$2; cwd=$3
  [ -d "$ROOT/attempts" ] || return 1
  for attempt_path in "$ROOT"/attempts/*; do
    [ -f "$attempt_path/task.tsv" ] || continue
    attempt_id=${attempt_path##*/}
    [ "$(attempt_meta "$attempt_id" 2)" = "$slug" ] || continue
    [ "$(attempt_meta "$attempt_id" 6)" = "$agent" ] || continue
    attempt_terminal "$(attempt_state "$attempt_id")" && continue
    recorded_worktree=$(awk -F '\t' 'NR == 2 { print $3 }' "$attempt_path/task.tsv")
    recorded_worktree=$(cd "$recorded_worktree" 2>/dev/null && pwd -P) || continue
    [ "$recorded_worktree" = "$cwd" ] || continue
    printf '%s' "$attempt_id"; return 0
  done
  return 1
)

task_topological_order() {
  slug=$1
  awk -F '\t' '
    NR == 1 { next }
    { order[++n]=$1; deps[$1]=$2 }
    END {
      emitted=0
      for (round=1; round<=n; round++) {
        for (i=1; i<=n; i++) {
          id=order[i]; if (done[id]) continue
          ready=1
          if (deps[id] != "-") {
            count=split(deps[id], part, ",")
            for (j=1; j<=count; j++) if (!done[part[j]]) ready=0
          }
          if (ready) { print id; done[id]=1; emitted++ }
        }
      }
      if (emitted != n) exit 2
    }
  ' "$(D "$slug")/TASKS.tsv"
}

task_all_pass() {
  slug=$1
  for task in $(task_topological_order "$slug"); do
    task_pass_exists "$slug" "$task" || return 1
  done
  return 0
}

task_integration_complete() {
  slug=$1; d=$(D "$slug"); [ -f "$d/INTEGRATION.tsv" ] || return 1
  recorded=$(awk -F '\t' 'NR > 1 { value=$4 } END { print value }' "$d/INTEGRATION.tsv")
  [ -n "$recorded" ] && [ "$recorded" = "$(workid "$slug")" ]
}

task_owns_path() {
  slug=$1; task=$2; changed=$3
  paths_file=$(task_field "$slug" "$task" 3)
  while IFS= read -r owned_path || [ -n "$owned_path" ]; do
    [ "$changed" = "$owned_path" ] && return 0
    case $changed in "$owned_path"/*) return 0 ;; esac
  done < "$(D "$slug")/$paths_file"
  return 1
}

task_dependencies_pass() {
  slug=$1; deps=$2
  [ "$deps" = - ] && return 0
  old_ifs=$IFS; IFS=,
  for dependency in $deps; do
    task_pass_exists "$slug" "$dependency" || { IFS=$old_ifs; return 1; }
  done
  IFS=$old_ifs
  return 0
}

task_render_file() {
  slug=$1; out=$2; d=$(D "$slug")
  {
    printf '# TASKS — %s\n\n' "$slug"
    printf 'Generated from frozen `TASKS.tsv`; do not edit this file by hand.\n\n'
    printf '| Task | Dependencies | Owned paths | Verify script | Derived state |\n'
    printf '| --- | --- | --- | --- | --- |\n'
    while IFS="$(printf '\t')" read -r task deps paths_file verify_script; do
      [ "$task" = task_id ] && continue
      owned=$(awk 'BEGIN { first=1 } { if (!first) printf "<br>"; printf "`%s`", $0; first=0 }' "$d/$paths_file")
      if task_pass_exists "$slug" "$task"; then
        derived=PASS
      elif task_dependencies_pass "$slug" "$deps"; then
        derived=READY
      else
        derived=WAITING
      fi
      printf '| %s | %s | %s | `%s` | %s |\n' "$task" "$deps" "$owned" "$verify_script" "$derived"
    done < "$d/TASKS.tsv"
  } > "$out"
}

cmd_integrate_tasks() {
  slug=$1; d=$(D "$slug")
  [ "$(phase_of "$slug")" = BUILD ] || die "task integration requires BUILD"
  [ "$(task_live_count "$slug")" -eq 0 ] || die "task attempts are still live"
  task_all_pass "$slug" || die "task integration requires PASS for every task"
  [ -f "$d/TARGET" ] || die "task integration requires a Git target"
  [ ! -e "$d/INTEGRATION.tsv" ] || die "task integration is already recorded"
  repo=$(tgt "$slug" repo); item_branch=$(tgt "$slug" branch)
  git -C "$repo" rev-parse --verify --quiet "$item_branch" >/dev/null \
    || die "item integration branch does not exist: $item_branch"
  integration_worktree="$ROOT/worktrees/integrate-$slug"
  [ ! -e "$integration_worktree" ] || die "integration worktree already exists: $integration_worktree"
  mkdir -p "$ROOT/worktrees"
  git -C "$repo" worktree add -q "$integration_worktree" "$item_branch" \
    || die "could not create integration worktree for $item_branch"
  integration_tmp="$d/.INTEGRATION.$$.tmp"
  printf 'task_id\ttask_result\tsource_commit\tintegration_commit\n' > "$integration_tmp"
  for task in $(task_topological_order "$slug"); do
    result_file=$(task_result_file "$slug" "$task")
    dispatch_wid=$(sed -n 's/^DISPATCH-WORK-ID: //p' "$result_file" | head -1)
    output_wid=$(sed -n 's/^WORK-ID: //p' "$result_file" | head -1)
    git -C "$repo" merge-base --is-ancestor "$dispatch_wid" "$output_wid" \
      || { state_attempt_update "$slug" BLOCKED - INTEGRATION_CONFLICT; die "task $task result is not descended from its dispatch base"; }
    commits=$(git -C "$repo" rev-list --reverse "$dispatch_wid..$output_wid")
    [ -n "$commits" ] || { state_attempt_update "$slug" BLOCKED - TASK_BLOCKED; die "task $task has no commits to integrate"; }
    for commit in $commits; do
      if ! git -C "$integration_worktree" cherry-pick "$commit" >/dev/null 2>&1; then
        state_attempt_update "$slug" BLOCKED - INTEGRATION_CONFLICT
        printf 'task %s conflict retained in %s\n' "$task" "$integration_worktree" >&2
        die "integration conflict while applying $commit"
      fi
    done
    integrated=$(git -C "$integration_worktree" rev-parse --verify HEAD | cut -c1-12)
    printf '%s\t%s\t%s\t%s\n' "$task" "${result_file#"$ROOT/"}" "$output_wid" "$integrated" >> "$integration_tmp"
  done
  mv "$integration_tmp" "$d/INTEGRATION.tsv"
  integrated=$(workid "$slug"); risk=$(state_value "$slug" 5)
  state_update_item "$slug" ACTIVE BUILD "$integrated" "$risk" - -
  printf 'integrated %s at %s; worktree retained at %s\n' "$slug" "$integrated" "$integration_worktree"
}

cmd_task() {
  uses_managed_lifecycle || die "task requires managed lifecycle behavior"
  sub=${1:-}; slug=${2:-}; [ -n "$slug" ] || die "usage: crucible task list|ready|dispatch|integrate ITEM ..."
  need "$slug"; d=$(D "$slug"); [ -f "$d/TASKS.tsv" ] || die "item has no task DAG: $slug"
  validate_task_dag "$slug"; task_assert_frozen "$slug"
  case $sub in
    list) task_render_file "$slug" /dev/stdout ;;
    ready)
      if task_all_pass "$slug"; then
        printf 'READY INTEGRATE\n'
        return
      fi
      found=0
      while IFS="$(printf '\t')" read -r task deps paths_file verify_script; do
        [ "$task" = task_id ] && continue
        task_pass_exists "$slug" "$task" && continue
        live=$(task_live_attempt "$slug" "$task" 2>/dev/null || true)
        if [ -n "$live" ]; then
          [ "$(attempt_state "$live")" = RETURNED ] && { printf 'RESULT %s %s\n' "$task" "$live"; found=1; }
          continue
        fi
        retry=$(task_retry_available "$slug" "$task" 2>/dev/null || true)
        if [ -n "$retry" ]; then printf 'RETRY %s %s\n' "$task" "$retry"; found=1; continue; fi
        if task_dependencies_pass "$slug" "$deps"; then printf 'READY %s\n' "$task"; found=1; fi
      done < "$d/TASKS.tsv"
      if [ "$found" -eq 0 ]; then
        live_count=$(task_live_count "$slug")
        [ "$live_count" -eq 0 ] && printf 'WAIT TASK_DEPENDENCIES\n' || printf 'WAIT TASK_ATTEMPTS %s\n' "$live_count"
      fi
      ;;
    dispatch)
      task=${3:-}; agent=${4:-}; criterion=${5:-}; class=${6:-FOCUSED}; retry=${7:--}
      [ -n "$task" ] && [ -n "$agent" ] && [ -n "$criterion" ] \
        || die "usage: crucible task dispatch ITEM TASK AGENT CRITERION [EVIDENCE_CLASS] [RETRY_OF]"
      cmd_dispatch_managed "$slug" maker "$agent" "$criterion" "$class" "$retry" "$task"
      ;;
    integrate)
      [ $# -eq 2 ] || die "usage: crucible task integrate ITEM"
      cmd_integrate_tasks "$slug"
      ;;
    *) die "usage: crucible task list|ready|dispatch|integrate ITEM ..." ;;
  esac
}

cmd_ready() {
  uses_managed_lifecycle || die "ready requires managed lifecycle behavior"
  need "${1:-}"; slug=$1
  state_validate_file "$ROOT/STATE.tsv"
  old=$(state_value "$slug" 3)
  [ "$old" = DRAFT ] || die "refused: ready requires DRAFT, found ${old:-missing}"
  validate_managed_item "$slug"
  d=$(D "$slug")
  if [ -f "$d/TASKS.tsv" ]; then
    validate_task_dag "$slug"
    task_view_tmp="$d/.TASKS.md.$$.tmp"; task_id_tmp="$d/.TASKS.id.$$.tmp"
    trap 'rm -f "$task_view_tmp" "$task_id_tmp"' 0 1 2 15
    task_render_file "$slug" "$task_view_tmp"
    task_contract_id "$slug" > "$task_id_tmp"
    mv "$task_view_tmp" "$d/TASKS.md"; mv "$task_id_tmp" "$d/TASKS.id"
    trap - 0 1 2 15
  else
    [ ! -e "$d/TASKS.md" ] && [ ! -e "$d/TASKS.id" ] \
      || die "refused: generated task artifacts exist without TASKS.tsv"
  fi
  risk=$(item_section_body "$(D "$slug")/ITEM.md" Risk)
  state_update_item "$slug" ACTIVE READY "$(workid "$slug")" "$risk" - -
  printf '%s is now READY\n' "$slug"
}

phase_of() {
  if uses_managed_lifecycle; then
    state_validate_file "$ROOT/STATE.tsv"
    p=$(state_value "$1" 3)
    printf '%s' "$p"
  else
    p=$(sed -n 's/^PHASE: //p' "$(D "$1")/ITEM.md" 2>/dev/null | head -1)
    printf '%s' "${p:-SPEC}"
  fi
}

proposal_file() { printf '%s/PROPOSAL.md' "$ROOT"; }

proposal_id() {
  pf=$(proposal_file)
  [ -s "$pf" ] && [ ! -L "$pf" ] || return 1
  hashfile "$pf" | cut -c1-12
}

proposal_valid() {
  pf=$(proposal_file)
  [ -s "$pf" ] && [ ! -L "$pf" ] || return 1
  for heading in '## Verified problem' '## Proposed outcome' '## Non-goals' \
    '## Backlog' '## Verification'; do
    grep -qF "$heading" "$pf" || return 1
  done
  ! grep -q 'TEMPLATE-\|TODO-REPLACE' "$pf"
}

approval_current() {
  [ -f "$ROOT/APPROVAL" ] && [ ! -L "$ROOT/APPROVAL" ] || return 1
  approved=$(sed -n 's/^proposal-id: //p' "$ROOT/APPROVAL" | head -1)
  [ -n "$approved" ] && [ "$approved" = "$(proposal_id 2>/dev/null || true)" ]
}

panel_file() { printf '%s/PANEL.md' "$ROOT"; }

# Placeholder agent rows must not leave CONFIGURE. Real CLIs, ACP, or labelled
# subagent commands are required before investigation. kindA/kindB alone are fine
# as kind labels; the adopt seed uses MODEL + AGENT_CLI/OTHER_CLI as placeholders.
agents_registry_ready() {
  [ -f "$ROOT/agents.tsv" ] && [ ! -L "$ROOT/agents.tsv" ] || return 1
  rows=$(grep -v '^#' "$ROOT/agents.tsv" | grep -v '^[[:space:]]*$' | wc -l | tr -d ' ')
  [ "$rows" -ge 2 ] || return 1
  if grep -v '^#' "$ROOT/agents.tsv" | grep -v '^[[:space:]]*$' |
    awk -F '\t' '
      $3 == "MODEL" || $5 ~ /AGENT_CLI|OTHER_CLI/ { bad=1 }
      END { exit bad ? 0 : 1 }
    '
  then
    return 1
  fi
  return 0
}

assign_file() { printf '%s/PANEL.ASSIGN.tsv' "$ROOT"; }

# Known castable roles (roles/*.md stems + coordinator + reviewer alias for judge).
assign_role_known() {
  case $1 in
    coordinator|claim-auditor|contract-auditor|maker|reviewer|judge|adversary|scout|specifier|architect|planner|integrator)
      return 0 ;;
    *) return 1 ;;
  esac
}

# Normalize dispatch role names onto assignment roles.
assign_role_normalize() {
  case $1 in
    judge) printf 'reviewer' ;;
    *) printf '%s' "$1" ;;
  esac
}

panel_required_count() {
  want=$1
  af=$(assign_file)
  [ -f "$af" ] || { printf '0'; return; }
  awk -F '\t' -v r="$want" '
    $1 ~ /^#/ || $1 == "role" { next }
    {
      role=$1; req=tolower($3)
      if (role == "judge") role="reviewer"
      if (role == r && (req == "yes" || req == "required")) n++
    }
    END { print n+0 }
  ' "$af"
}

guided_min_auditors() {
  if [ -n "${CRUCIBLE_MIN_AUDITORS:-}" ]; then
    printf '%s' "$CRUCIBLE_MIN_AUDITORS"
    return
  fi
  if uses_guided_cycle; then
    n=$(panel_required_count claim-auditor)
    [ "$n" -ge 1 ] && { printf '%s' "$n"; return; }
  fi
  printf '2'
}

guided_min_judges() {
  if [ -n "${CRUCIBLE_MIN_JUDGES:-}" ]; then
    printf '%s' "$CRUCIBLE_MIN_JUDGES"
    return
  fi
  if uses_guided_cycle; then
    n=$(panel_required_count reviewer)
    [ "$n" -ge 1 ] && { printf '%s' "$n"; return; }
  fi
  printf '%s' "$MIN_JUDGES"
}

claims_absent_only() {
  f=$(claims_file)
  [ -f "$f" ] || return 1
  total=$(grep -c '^### C' "$f" 2>/dev/null || true); total=${total:-0}
  [ "$total" -gt 0 ] || return 1
  absent=$(grep -c '^    polarity: ABSENT$' "$f" 2>/dev/null || true); absent=${absent:-0}
  [ "$absent" -eq "$total" ]
}

cycle_worth() {
  f=$(claims_file)
  [ -f "$f" ] || { printf 'UNKNOWN'; return; }
  st=$(cycle_investigation_state)
  [ "$st" = COMPLETE ] || { printf 'UNKNOWN'; return; }
  truec=0
  if [ -d "$ROOT/claims" ]; then
    grep -l '^CLAIM-VERDICT: TRUE$' "$ROOT"/claims/*/verdicts/*.md >/dev/null 2>&1 && truec=1 || true
  fi
  if [ "$truec" -eq 0 ]; then printf 'NO-BUILD'; return; fi
  absent=0; partly=0
  absent=$(grep -c '^    scout: ABSENT$' "$f" 2>/dev/null || true)
  partly=$(grep -c '^    scout: PARTLY-EXISTS$' "$f" 2>/dev/null || true)
  [ -n "$absent" ] || absent=0
  [ -n "$partly" ] || partly=0
  if [ "$absent" -gt 0 ]; then printf 'BUILD'; return; fi
  if [ "$partly" -gt 0 ]; then printf 'DOCS'; return; fi
  printf 'NO-BUILD'
}

panel_has_maker_reviewer_waiver() {
  [ -f "$(panel_file)" ] || return 1
  # Only explicit waiver lines count — "do not grant maker-reviewer-same-agent" must not grant it.
  grep -qiE '^[[:space:]]*(LADDER_WAIVER|WAIVER):[[:space:]]*maker-reviewer-same-agent\b' "$(panel_file)"
}

# Guided cycles: execution commands refuse when the approved panel hash is stale.
require_panel_approval() {
  uses_guided_cycle || return 0
  panel_approval_current \
    || die "refused: agent panel is not current — update PANEL.md / PANEL.ASSIGN.tsv / agents.tsv and run: $(self_path) cycle approve-panel"
}

# Validate PANEL.ASSIGN.tsv: role→agent casting for independent agents.
assign_valid() {
  af=$(assign_file)
  [ -f "$af" ] && [ ! -L "$af" ] && [ -s "$af" ] || return 1
  agents_registry_ready || return 1
  # shellcheck disable=SC2034
  has_coord=0; has_claim=0; has_maker=0; has_reviewer=0; has_caudit=0
  makers=''; reviewers=''; coords=''; claim_auditors=''; contract_auditors=''
  while IFS="$(printf '\t')" read -r role agent required notes; do
    [ -n "$role" ] || continue
    case $role in \#*|role) continue ;; esac
    assign_role_known "$role" || return 1
    [ -n "$agent" ] || return 1
    [ -n "$(kind_of "$agent")" ] || return 1
    case $required in yes|no|'') : ;; *) return 1 ;; esac
    nrole=$(assign_role_normalize "$role")
    case $nrole in
      coordinator) has_coord=1; coords="$coords $agent" ;;
      claim-auditor) has_claim=1; claim_auditors="$claim_auditors $agent" ;;
      maker) has_maker=1; makers="$makers $agent" ;;
      reviewer) has_reviewer=1; reviewers="$reviewers $agent" ;;
      contract-auditor) has_caudit=1; contract_auditors="$contract_auditors $agent" ;;
    esac
  done < "$af"
  [ "$has_coord" -eq 1 ] && [ "$has_claim" -eq 1 ] && [ "$has_maker" -eq 1 ] \
    && [ "$has_reviewer" -eq 1 ] && [ "$has_caudit" -eq 1 ] || return 1
  # Maker and reviewer must be distinct agents unless waived.
  if ! panel_has_maker_reviewer_waiver; then
    for m in $makers; do
      case " $reviewers " in *" $m "*) return 1 ;; esac
    done
  fi
  # Coordinator must not also be maker or reviewer unless waived.
  if ! panel_has_maker_reviewer_waiver; then
    for c in $coords; do
      case " $makers $reviewers " in *" $c "*) return 1 ;; esac
    done
  fi
  # Coordinator must not wear independence hats (claim/contract auditor).
  for c in $coords; do
    case " $claim_auditors $contract_auditors " in *" $c "*) return 1 ;; esac
  done
  # Contract-auditor must not be a maker (reviewer-as-auditor of maker work is allowed).
  for ca in $contract_auditors; do
    case " $makers " in *" $ca "*) return 1 ;; esac
  done
  # HIGH risk in PANEL requires an adversary cast.
  if [ -f "$(panel_file)" ] && grep -qiE 'risk posture|## Risk' "$(panel_file)"; then
    if grep -A5 '^## Risk posture' "$(panel_file)" | grep -qiE '\bHIGH\b'; then
      grep -v '^#' "$af" | awk -F '\t' '$1=="adversary"{found=1} END{exit !found}' || return 1
    fi
  fi
  return 0
}

# True if agent is cast for role in PANEL.ASSIGN.tsv (guided only).
# Do not assign to `role` — POSIX functions share the caller's variables, and
# cmd_dispatch_managed needs the dispatch role to stay `judge`.
agent_cast_for_role() {
  lookup=$(assign_role_normalize "$1")
  want=$2
  af=$(assign_file)
  [ -f "$af" ] || return 1
  awk -F '\t' -v r="$lookup" -v a="$want" '
    $1 ~ /^#/ || $1 == "role" { next }
    {
      assigned=$1; who=$2
      if (assigned == "judge") assigned="reviewer"
      if (assigned == r && who == a) { found=1; exit }
    }
    END { exit !found }
  ' "$af"
}

require_role_cast() {
  requested=$1
  who=$2
  uses_guided_cycle || return 0
  nrole=$(assign_role_normalize "$requested")
  agent_cast_for_role "$nrole" "$who" \
    || die "refused: agent $who is not cast as $nrole in PANEL.ASSIGN.tsv — update casting and cycle approve-panel"
}

panel_id() {
  pf=$(panel_file); af=$(assign_file); ag="$ROOT/agents.tsv"
  [ -s "$pf" ] && [ ! -L "$pf" ] || return 1
  [ -s "$af" ] && [ ! -L "$af" ] || return 1
  [ -s "$ag" ] && [ ! -L "$ag" ] || return 1
  # Content-bind panel narrative, casting, and the approved agent registry/invocations.
  {
    hashfile "$pf"
    hashfile "$af"
    hashfile "$ag"
  } | h12
}

panel_valid() {
  pf=$(panel_file)
  [ -s "$pf" ] && [ ! -L "$pf" ] || return 1
  for heading in '## Agents' '## Roles' '## Risk posture' '## Isolation transport' \
    '## Independence ladder' '## Waivers'; do
    grep -qF "$heading" "$pf" || return 1
  done
  ! grep -q 'TEMPLATE-\|TODO-REPLACE' "$pf" || return 1
  agents_registry_ready || return 1
  # Transport policy must name the ladder preference.
  grep -qiE 'multi-agent|acp|subagent' "$pf" || return 1
  # Operator role casting: required independent agent assignments.
  assign_valid || return 1
  return 0
}

panel_approval_current() {
  [ -f "$ROOT/PANEL.APPROVAL" ] && [ ! -L "$ROOT/PANEL.APPROVAL" ] || return 1
  approved=$(sed -n 's/^panel-id: //p' "$ROOT/PANEL.APPROVAL" | head -1)
  [ -n "$approved" ] && [ "$approved" = "$(panel_id 2>/dev/null || true)" ]
}

attempt_transport() {
  ad=$(attempt_dir "$1")
  [ -f "$ad/transport" ] && [ ! -L "$ad/transport" ] || return 1
  tr=$(sed -n '1p' "$ad/transport" | tr -d '\r')
  case $tr in multi-agent|acp|subagent) printf '%s' "$tr"; return 0 ;; *) return 1 ;; esac
}

attempt_contract_audit_pass() {
  ad=$(attempt_dir "$1")
  [ -f "$ad/contract-audit.md" ] && [ ! -L "$ad/contract-audit.md" ] || return 1
  [ "$(sed -n 's/^VERDICT: //p' "$ad/contract-audit.md" | head -1)" = PASS ]
}

# Subagent transport is weaker isolation; only allowed after a recorded ACP probe failure
# on single-product hosts. A prior ok probe blocks unlock even if PANEL prose claims ACP is down.
acp_probe_failed() {
  # Prior successful probe cannot unlock subagent (PANEL note cannot override recorded ok).
  if [ -d "$ROOT/acp-probes" ]; then
    if grep -ql '^status: ok$' "$ROOT"/acp-probes/*.md 2>/dev/null; then
      return 1
    fi
  fi
  if [ -f "$ROOT/ACP-PROBE.md" ] && [ ! -L "$ROOT/ACP-PROBE.md" ]; then
    prev=$(sed -n 's/^status: //p' "$ROOT/ACP-PROBE.md" | head -1 | tr '[:upper:]' '[:lower:]')
    [ "$prev" = ok ] && return 1
    case $prev in failed|unavailable|error) return 0 ;; esac
  fi
  # Explicit PANEL line only when no successful probe exists.
  if [ -f "$(panel_file)" ]; then
    grep -qiE '^[[:space:]]*ACP:[[:space:]]*(failed|unavailable)\b' "$(panel_file)" && return 0
  fi
  return 1
}

suggest_contract_auditor() {
  af=$(assign_file)
  if [ -f "$af" ]; then
    awk -F '\t' '$1=="contract-auditor" && $2!=""{print $2; exit}' "$af"
    return
  fi
  printf '<auditor-name>'
}

require_attempt_independence() {
  id=$1
  uses_guided_cycle || return 0
  require_panel_approval
  transport=$(attempt_transport "$id") || die "refused: attempt $id has no transport (multi-agent|acp|subagent) — run: $(self_path) attempt transport $id <transport> while DISPATCHED"
  # Re-check ladder against the *current* approved panel/registry so a temporary
  # kind-collapse or waiver cannot leave a dishonest seal after files are restored.
  enforce_transport_ladder "$transport"
  attempt_contract_audit_pass "$id" \
    || die "refused: attempt $id lacks contract-audit PASS — run: $(self_path) contract-audit $id $(suggest_contract_auditor) PASS while DISPATCHED"
  case $transport in
    subagent)
      acp_probe_failed \
        || die "refused: subagent transport requires a recorded ACP probe failure before weaker isolation"
      ;;
  esac
}

# Claim attempt stamps must name this claim + agent + claim-auditor|scout role.
claim_attempt_matches() {
  id=$1; cn=$2; agent=$3; want_role=${4:-}
  [ -f "$ROOT/attempts/$id/meta.tsv" ] || return 1
  [ "$(attempt_meta "$id" 2)" = "$cn" ] || return 1
  [ "$(attempt_meta "$id" 6)" = "$agent" ] || return 1
  role=$(attempt_meta "$id" 5)
  if [ -n "$want_role" ]; then
    [ "$role" = "$want_role" ] || return 1
  else
    case $role in claim-auditor|scout) : ;; *) return 1 ;; esac
  fi
  return 0
}

# A claim dispatch is usable only after transport + contract-audit PASS.
# First-match would bind a leftover DISPATCHED file from an earlier redispatch.
claim_attempt_is_sealed() {
  id=$1
  ad="$ROOT/attempts/$id"
  [ -f "$ad/transport" ] || return 1
  [ -f "$ad/contract-audit.md" ] || return 1
  grep -q '^VERDICT: PASS' "$ad/contract-audit.md"
}

write_independence_receipt() {
  uses_guided_cycle || return 0
  out="$ROOT/INDEPENDENCE.md"
  tmp="$ROOT/.INDEPENDENCE.md.$$.tmp"
  {
    printf '# Independence receipt\n\n'
    printf 'Generated from attempt ledger and contract audits. Not a cryptographic proof.\n\n'
    printf '| Attempt | Role | Agent | Kind | Transport | Contract audit |\n'
    printf '| --- | --- | --- | --- | --- | --- |\n'
    if [ -d "$ROOT/attempts" ]; then
      for ad in "$ROOT"/attempts/A*; do
        [ -d "$ad" ] || continue
        id=${ad##*/}
        [ -f "$ad/meta.tsv" ] || continue
        role=$(attempt_meta "$id" 5); agent=$(attempt_meta "$id" 6); kind=$(attempt_meta "$id" 7)
        tr=-; attempt_transport "$id" >/dev/null 2>&1 && tr=$(attempt_transport "$id")
        audit=MISSING
        if [ -f "$ad/contract-audit.md" ]; then
          audit=$(sed -n 's/^VERDICT: //p' "$ad/contract-audit.md" | head -1)
          [ -n "$audit" ] || audit=MISSING
        fi
        printf '| %s | %s | %s | %s | %s | %s |\n' "$id" "$role" "$agent" "$kind" "$tr" "$audit"
      done
    fi
    printf '\n## Ladder\n\n1. multi-agent (preferred)\n2. acp (single-product isolation)\n3. subagent (only after ACP probe failure)\n4. stop if none invocable\n'
  } > "$tmp"
  mv "$tmp" "$out"
}

# Soft check: does agent have a sealed matching claim attempt for cn?
claim_agent_independence_ok() {
  cn=$1; agent=$2
  panel_approval_current || return 1
  ca=
  cdir="$ROOT/claims/$cn/dispatches"
  if [ -d "$cdir" ]; then
    for df in "$cdir"/*-claim-auditor-"$agent".md "$cdir"/*-scout-"$agent".md; do
      [ -f "$df" ] || continue
      stamped=$(sed -n 's/^attempt-id: //p' "$df" | head -1)
      if [ -n "$stamped" ] && claim_attempt_matches "$stamped" "$cn" "$agent"; then
        ca=$stamped; break
      fi
    done
  fi
  if [ -z "$ca" ] && [ -d "$ROOT/attempts" ]; then
    for ad in "$ROOT"/attempts/A*; do
      [ -d "$ad" ] || continue
      aid=${ad##*/}
      claim_attempt_matches "$aid" "$cn" "$agent" || continue
      ca=$aid
    done
  fi
  [ -n "$ca" ] || return 1
  attempt_transport "$ca" >/dev/null 2>&1 || return 1
  attempt_contract_audit_pass "$ca" || return 1
  return 0
}

# Same bar as claim admit: enough sealed TRUE verdicts and kinds.
claim_true_bar_met() {
  cn=$1
  min_a=${CRUCIBLE_MIN_AUDITORS:-2}
  t=0; kinds=""
  vd="$ROOT/claims/$cn/verdicts"
  [ -d "$vd" ] || return 1
  for vf in "$vd"/*.md; do
    [ -f "$vf" ] || continue
    [ "$(sed -n 's/^CLAIM-VERDICT: //p' "$vf" | head -1)" = TRUE ] || continue
    agent=${vf##*/}; agent=${agent%.md}
    [ -n "$(kind_of "$agent")" ] || continue
    if uses_guided_cycle; then
      claim_agent_independence_ok "$cn" "$agent" || continue
    fi
    t=$((t + 1))
    k=$(kind_of "$agent")
    case " $kinds " in *" $k "*) : ;; *) kinds="$kinds $k" ;; esac
  done
  kn=0; for k in $kinds; do kn=$((kn + 1)); done
  [ "$t" -ge "$min_a" ] && [ "$kn" -ge "$MIN_KINDS" ]
}

# A sealed FALSE or STALE from a distinct agent means the claim is not current work,
# even if an earlier TRUE remains on file (write-once verdicts cannot be rewritten).
claim_true_superseded() {
  cn=$1
  vd="$ROOT/claims/$cn/verdicts"
  [ -d "$vd" ] || return 1
  true_agents=""
  for vf in "$vd"/*.md; do
    [ -f "$vf" ] || continue
    [ "$(sed -n 's/^CLAIM-VERDICT: //p' "$vf" | head -1)" = TRUE ] || continue
    agent=${vf##*/}; agent=${agent%.md}
    if uses_guided_cycle; then
      claim_agent_independence_ok "$cn" "$agent" || continue
    fi
    true_agents="$true_agents $agent"
  done
  [ -n "$true_agents" ] || return 1
  for vf in "$vd"/*.md; do
    [ -f "$vf" ] || continue
    word=$(sed -n 's/^CLAIM-VERDICT: //p' "$vf" | head -1)
    case $word in FALSE|STALE) : ;; *) continue ;; esac
    agent=${vf##*/}; agent=${agent%.md}
    case " $true_agents " in *" $agent "*) continue ;; esac
    if uses_guided_cycle; then
      claim_agent_independence_ok "$cn" "$agent" || continue
    fi
    return 0
  done
  return 1
}

cycle_investigation_state() {
  f=$(claims_file)
  [ -f "$f" ] || { printf 'EMPTY'; return; }
  total=$(grep -c '^### C' "$f" 2>/dev/null || true); total=${total:-0}
  [ "$total" -gt 0 ] || { printf 'EMPTY'; return; }
  i=1
  while [ "$i" -le "$total" ]; do
    vd="$ROOT/claims/C$i/verdicts"; verdicts=0; truth=0
    if [ -d "$vd" ]; then
      for vf in "$vd"/*.md; do
        [ -f "$vf" ] || continue
        agent=${vf##*/}; agent=${agent%.md}
        # Consume-time: guided cycles ignore verdicts that lack a sealed matching attempt
        # (covers temporary cycle: guided toggle while writing verdict files).
        if uses_guided_cycle; then
          claim_agent_independence_ok "C$i" "$agent" || continue
        fi
        verdicts=$((verdicts + 1))
        [ "$(sed -n 's/^CLAIM-VERDICT: //p' "$vf" | head -1)" = TRUE ] && truth=$((truth + 1))
      done
    fi
    [ "$verdicts" -gt 0 ] || { printf 'NEEDS_AUDIT'; return; }
    if [ "$truth" -gt 0 ]; then
      scout=$(sed -n "/^### C$i /,/^### C[0-9]/{s/^    scout: //p;}" "$f" | head -1)
      [ -n "$scout" ] || { printf 'NEEDS_SCOUT'; return; }
      # Admit-ready TRUEs need the admit bar. FULLY-EXISTS or a later STALE/FALSE
      # means the claim is not new work — do not demand a second TRUE.
      if ! claim_true_superseded "C$i"; then
        case $scout in
          ABSENT|PARTLY-EXISTS)
            claim_true_bar_met "C$i" || { printf 'NEEDS_AUDIT'; return; } ;;
        esac
      fi
    fi
    i=$((i + 1))
  done
  printf 'COMPLETE'
}

cycle_unadmitted_work() {
  f=$(claims_file); [ -f "$f" ] || return 1
  total=$(grep -c '^### C' "$f" 2>/dev/null || true); total=${total:-0}; i=1
  while [ "$i" -le "$total" ]; do
    item=$(sed -n "/^### C$i /,/^### C[0-9]/{s/^    item: //p;}" "$f" | head -1)
    if [ -z "$item" ]; then
      scout=$(sed -n "/^### C$i /,/^### C[0-9]/{s/^    scout: //p;}" "$f" | head -1)
      case $scout in
        ABSENT|PARTLY-EXISTS)
          if claim_true_bar_met "C$i"; then
            return 0
          fi ;;
      esac
    fi
    i=$((i + 1))
  done
  return 1
}

drive_product_repo() {
  sed -n 's/^repo: //p' "$ROOT/PROGRAM" 2>/dev/null | head -1
}

drive_coordinator_agent() {
  af=$(assign_file)
  [ -f "$af" ] || return 1
  awk -F '\t' '$1=="coordinator" && $2!=""{print $2; exit}' "$af"
}

drive_cast_agents() {
  role=$1
  af=$(assign_file)
  [ -f "$af" ] || return 0
  awk -F '\t' -v r="$role" '$1==r && $2!=""{print $2}' "$af"
}

drive_state_name() {
  line=$1
  case $line in
    NEXT\ CONFIGURE*) printf 'CONFIGURE' ;;
    WAIT\ PANEL*) printf 'WAIT_PANEL' ;;
    NEXT\ INTAKE*) printf 'INTAKE' ;;
    NEXT\ INVESTIGATE*) printf 'INVESTIGATE' ;;
    NEXT\ PROPOSE*) printf 'PROPOSE' ;;
    WAIT\ APPROVAL*) printf 'WAIT_APPROVAL' ;;
    NEXT\ PLAN*) printf 'PLAN' ;;
    NEXT\ EXECUTE*) printf 'EXECUTE' ;;
    NEXT\ REVIEW*) printf 'REVIEW' ;;
    WAIT\ *) printf 'WAIT' ;;
    ESCALATE*) printf 'ESCALATE' ;;
    DONE*) printf 'DONE' ;;
    *) printf 'UNKNOWN' ;;
  esac
}

drive_human_gate() {
  case $1 in
    WAIT_PANEL) printf 'approve-panel' ;;
    WAIT_APPROVAL) printf 'approve' ;;
    ESCALATE) printf 'escalate' ;;
    DONE) printf 'cycle-clean' ;;
    *) printf 'none' ;;
  esac
}

drive_last_evidence() {
  last=
  if [ -d "$ROOT/claims" ] || [ -d "$ROOT/items" ]; then
    last=$(find "$ROOT/claims" "$ROOT/items" -type f -path '*/evidence/*' 2>/dev/null \
      | LC_ALL=C sort | while IFS= read -r f; do
          ts=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || printf '0')
          printf '%s\t%s\n' "$ts" "$f"
        done | LC_ALL=C sort -n | tail -1 | cut -f2-)
  fi
  [ -n "$last" ] && printf '%s' "${last#"$ROOT"/}" || printf '-'
}

drive_active_item() {
  uses_managed_lifecycle || { printf '-'; return; }
  [ -f "$ROOT/STATE.tsv" ] || { printf '-'; return; }
  awk -F '\t' 'NR > 1 && ($2 == "ACTIVE" || $2 == "BLOCKED") { print $1; exit }' "$ROOT/STATE.tsv"
  :
}

drive_inflight() {
  slug=$(drive_active_item)
  [ -n "$slug" ] && [ "$slug" != - ] || { printf '-'; return; }
  inf=$(state_value "$slug" 6 2>/dev/null || true)
  [ -n "$inf" ] && printf '%s' "$inf" || printf '-'
}

engine_version() {
  if [ -s "$ROOT/VERSION" ] && [ ! -L "$ROOT/VERSION" ]; then
    sed -n '1p' "$ROOT/VERSION"
  else
    printf 'unknown'
  fi
}

write_cycle_status() {
  cycle_sync_panel_context
  line=$(cmd_cycle_status)
  state=$(drive_state_name "$line")
  item=$(drive_active_item); [ -n "$item" ] || item=-
  inflight=$(drive_inflight); [ -n "$inflight" ] || inflight=-
  evidence=$(drive_last_evidence)
  gate=$(drive_human_gate "$state")
  tmp="$ROOT/.STATUS.md.$$.tmp"
  {
    printf '# STATUS\n\n'
    printf 'line: %s\n' "$line"
    printf 'state: %s\n' "$state"
    printf 'engine: %s\n' "$(engine_version)"
    printf 'worth: %s\n' "$(cycle_worth)"
    printf 'active-item: %s\n' "$item"
    printf 'inflight-attempt: %s\n' "$inflight"
    printf 'last-evidence: %s\n' "$evidence"
    printf 'next-human-gate: %s\n' "$gate"
    printf 'updated-epoch: %s\n' "$(date +%s)"
    printf '\nRead this after `cycle`. If drive is running, perform only the single next legal orchestrator action.\n'
    if [ "$state" = DONE ]; then
      printf '\n'
      cycle_cleanup_report
    fi
  } > "$tmp"
  mv "$tmp" "$ROOT/STATUS.md"
  printf '%s\n' "$line"
  if [ "$state" = DONE ]; then
    cycle_cleanup_report
  fi
}

drive_snap_dir() { printf '%s/.drive-snap' "$ROOT"; }

drive_live_attempt_ids() {
  [ -d "$ROOT/attempts" ] || return 0
  for ad in "$ROOT"/attempts/A*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    st=$(attempt_state "$id")
    case $st in DISPATCHED|RUNNING|OVERDUE) printf '%s\n' "$id" ;; esac
  done | LC_ALL=C sort
}

drive_progress_token() {
  line=$1
  nd=0; na=0
  [ -d "$ROOT/claims" ] && nd=$(find "$ROOT/claims" -path '*/dispatches/*' -type f 2>/dev/null | wc -l | tr -d ' ')
  [ -d "$ROOT/attempts" ] && na=$(find "$ROOT/attempts" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  ev=$(drive_last_evidence)
  seals=-
  if [ -d "$ROOT/attempts" ]; then
    seals=$(find "$ROOT/attempts" -type f \( -name transport -o -name 'contract-audit.md' -o -name events.tsv \) 2>/dev/null \
      | LC_ALL=C sort | while IFS= read -r f; do
          printf '%s %s\n' "$f" "$(hashfile "$f")"
        done | h12)
    [ -n "$seals" ] || seals=-
  fi
  claims=-; [ -f "$ROOT/CLAIMS.md" ] && claims=$(hashfile "$ROOT/CLAIMS.md")
  proposal=-; [ -f "$ROOT/PROPOSAL.md" ] && proposal=$(hashfile "$ROOT/PROPOSAL.md")
  live=$(drive_live_attempt_ids | h12)
  [ -n "$live" ] || live=-
  printf '%s|%s|%s|%s|%s|%s|%s|%s' "$line" "$nd" "$na" "$ev" "$seals" "$claims" "$proposal" "$live"
}

drive_write_brief() {
  self=$(self_path)
  cat > "$ROOT/DRIVE.BRIEF.md" <<EOF
# DRIVE BRIEF

If drive is running, only do the next cycle action. Conversational "keep looping" is not a waiver to implement.

1. Read START.md and STATUS.md.
2. Run: $self cycle
3. Perform only the single next legal orchestrator action for the current state.
4. Dispatch and seal (transport + contract-audit). Do not start ACP workers — drive starts sealed attempts.
5. Write nothing a maker, reviewer, or auditor should write.
6. Do not edit owned product paths. Do not write verdicts. Do not merge.
7. Exit.

Legal actions: see STATUS.md and docs/drive.md. INVESTIGATE fallback dispatches one missing claim contract. Do not implement, commit, merge, write verdicts, or flip cycle: guided.
EOF
}

drive_porcelain_path() {
  # git status --porcelain: XY<space>path  or  XY<space>old -> new
  line=$1
  rest=${line#?? }
  case $rest in
    *' -> '*) printf '%s' "${rest#* -> }" ;;
    *) printf '%s' "$rest" ;;
  esac
}

drive_path_is_program() {
  path=$1
  # Task worktrees live under the program dir but are product work.
  case $path in
    *worktrees|*worktrees/*) return 1 ;;
    .crucible|/*/.crucible|.crucible/*|*/.crucible/*) return 0 ;;
  esac
  return 1
}

drive_product_hashes() {
  repo=$1
  git -C "$repo" status --porcelain -uall | while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=$(drive_porcelain_path "$line")
    drive_path_is_program "$path" && continue
    if [ -f "$repo/$path" ]; then
      printf '%s %s\n' "$path" "$(hashfile "$repo/$path")"
    elif [ -d "$repo/$path" ]; then
      printf '%s DIR\n' "$path"
    fi
  done | LC_ALL=C sort
}

drive_verdict_hashes() {
  find "$ROOT/items" "$ROOT/claims" -type f -path '*/verdicts/*.md' 2>/dev/null \
    | LC_ALL=C sort | while IFS= read -r f; do
        printf '%s %s\n' "${f#"$ROOT"/}" "$(hashfile "$f")"
      done
}

drive_worktree_hashes() {
  [ -d "$ROOT/worktrees" ] || return 0
  find "$ROOT/worktrees" -type f ! -path '*/.git/*' 2>/dev/null \
    | LC_ALL=C sort | while IFS= read -r f; do
        printf '%s %s\n' "${f#"$ROOT"/}" "$(hashfile "$f")"
      done
}

drive_take_snapshot() {
  repo=$1
  d=$(drive_snap_dir)
  rm -rf "$d"
  mkdir -p "$d/verdicts" "$d/wt"
  git -C "$repo" rev-parse HEAD > "$d/head"
  if [ -f "$repo/.git/MERGE_HEAD" ]; then printf 'yes\n' > "$d/merge_head"; else printf 'no\n' > "$d/merge_head"; fi
  git -C "$repo" status --porcelain -uall > "$d/porcelain"
  drive_product_hashes "$repo" > "$d/product_hashes"
  drive_verdict_hashes > "$d/verdicts_hashes"
  drive_worktree_hashes > "$d/worktree_hashes"
  drive_live_attempt_ids > "$d/live_ids"
  [ -f "$ROOT/PROGRAM" ] && cp "$ROOT/PROGRAM" "$d/PROGRAM"
  find "$ROOT/items" "$ROOT/claims" -type f -path '*/verdicts/*.md' 2>/dev/null | while IFS= read -r f; do
    rel=${f#"$ROOT"/}
    mkdir -p "$d/verdicts/$(dirname "$rel")"
    cp "$f" "$d/verdicts/$rel"
  done
  if [ -d "$ROOT/worktrees" ]; then
    find "$ROOT/worktrees" -type f ! -path '*/.git/*' 2>/dev/null | while IFS= read -r f; do
      rel=${f#"$ROOT"/}
      mkdir -p "$d/wt/$(dirname "$rel")"
      cp "$f" "$d/wt/$rel"
    done
  fi
}

drive_restore_all() {
  repo=$1
  d=$(drive_snap_dir)
  [ -n "$repo" ] && [ -d "$repo/.git" ] || return 0
  if [ -f "$d/head" ]; then
    before=$(sed -n '1p' "$d/head")
    now=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
    if [ -n "$before" ] && [ "$now" != "$before" ]; then
      git -C "$repo" reset --hard "$before" >/dev/null 2>&1 || true
    fi
  fi
  if [ -f "$d/PROGRAM" ]; then
    cp "$d/PROGRAM" "$ROOT/PROGRAM"
  fi
  git -C "$repo" status --porcelain -uall | while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=$(drive_porcelain_path "$line")
    drive_path_is_program "$path" && continue
    if [ -f "$d/porcelain" ] && grep -Fxq "$line" "$d/porcelain"; then
      # Same porcelain line: restore content from HEAD if hash drifted.
      if [ -f "$repo/$path" ] && [ -f "$d/product_hashes" ]; then
        old=$(awk -v p="$path" '$1==p {print $2; exit}' "$d/product_hashes")
        nowh=$(hashfile "$repo/$path")
        if [ -n "$old" ] && [ "$old" != "$nowh" ]; then
          git -C "$repo" checkout -- "$path" >/dev/null 2>&1 || true
        fi
      fi
      continue
    fi
    case $line in
      "?? "*) rm -rf "$repo/$path" ;;
      *) git -C "$repo" checkout -- "$path" >/dev/null 2>&1 || true ;;
    esac
  done
  if [ -d "$ROOT/items" ] || [ -d "$ROOT/claims" ]; then
    find "$ROOT/items" "$ROOT/claims" -type f -path '*/verdicts/*.md' 2>/dev/null | while IFS= read -r f; do
      rel=${f#"$ROOT"/}
      [ -f "$d/verdicts/$rel" ] || rm -f "$f"
    done
    if [ -d "$d/verdicts" ]; then
      find "$d/verdicts" -type f | while IFS= read -r f; do
        rel=${f#"$d/verdicts/"}
        mkdir -p "$(dirname "$ROOT/$rel")"
        cp "$f" "$ROOT/$rel"
      done
    fi
  fi
  if [ -d "$ROOT/worktrees" ]; then
    find "$ROOT/worktrees" -type f ! -path '*/.git/*' 2>/dev/null | while IFS= read -r f; do
      rel=${f#"$ROOT"/}
      [ -f "$d/wt/$rel" ] || rm -f "$f"
    done
  fi
  if [ -d "$d/wt" ]; then
    find "$d/wt" -type f | while IFS= read -r f; do
      rel=${f#"$d/wt/"}
      mkdir -p "$(dirname "$ROOT/$rel")"
      cp "$f" "$ROOT/$rel"
    done
  fi
}

drive_check_discipline() {
  repo=$1
  d=$(drive_snap_dir)
  [ -n "$repo" ] && [ -d "$repo" ] || return 0
  if ! uses_guided_cycle; then
    drive_restore_all "$repo"
    die "refused: coordinator removed cycle: guided"
  fi
  if [ -f "$d/head" ]; then
    before=$(sed -n '1p' "$d/head")
    now=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
    if [ -n "$before" ] && [ "$now" != "$before" ]; then
      drive_restore_all "$repo"
      die "refused: coordinator committed or merged product history"
    fi
  fi
  if [ -f "$repo/.git/MERGE_HEAD" ]; then
    drive_restore_all "$repo"
    die "refused: coordinator merged — drive does not allow merge"
  fi
  git -C "$repo" status --porcelain -uall > "$d/porcelain_after"
  : > "$d/product_hits"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    path=$(drive_porcelain_path "$line")
    drive_path_is_program "$path" && continue
    if [ -f "$d/porcelain" ] && grep -Fxq "$line" "$d/porcelain"; then
      if [ -f "$repo/$path" ] && [ -f "$d/product_hashes" ]; then
        old=$(awk -v p="$path" '$1==p {print $2; exit}' "$d/product_hashes")
        nowh=$(hashfile "$repo/$path")
        if [ -n "$old" ] && [ "$old" != "$nowh" ]; then
          printf '%s\n' "$path" >> "$d/product_hits"
        fi
      fi
      continue
    fi
    printf '%s\n' "$path" >> "$d/product_hits"
  done < "$d/porcelain_after"
  if [ -s "$d/product_hits" ]; then
    hit=$(head -1 "$d/product_hits")
    drive_restore_all "$repo"
    die "refused: coordinator edited owned product path: $hit"
  fi
  drive_verdict_hashes > "$d/verdicts_after"
  if ! cmp -s "$d/verdicts_hashes" "$d/verdicts_after"; then
    drive_restore_all "$repo"
    die "refused: coordinator wrote a verdict file"
  fi
  drive_worktree_hashes > "$d/worktree_after"
  if ! cmp -s "$d/worktree_hashes" "$d/worktree_after"; then
    drive_restore_all "$repo"
    die "refused: coordinator wrote a task worktree"
  fi
}

drive_has_claim_dispatch() {
  cn=$1; role=$2; agent=$3
  [ -d "$ROOT/claims/$cn/dispatches" ] || return 1
  for f in "$ROOT/claims/$cn/dispatches/"*-"$role"-"$agent".md; do
    [ -f "$f" ] && return 0
  done
  return 1
}

drive_claim_hop_transport() {
  agent=$1
  nk=$(registered_kind_count)
  ak=$(kind_of "$agent")
  coord=$(drive_coordinator_agent) || coord=
  ck=
  [ -n "$coord" ] && ck=$(kind_of "$coord")
  if [ "$nk" -ge 2 ] && [ -n "$ak" ] && [ -n "$ck" ] && [ "$ak" != "$ck" ]; then
    printf 'multi-agent'
  else
    printf 'acp'
  fi
}

drive_claim_attempt_id() {
  cn=$1; role=$2; agent=$3
  [ -d "$ROOT/attempts" ] || return 1
  for ad in "$ROOT"/attempts/A*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    claim_attempt_matches "$id" "$cn" "$agent" "$role" || continue
    printf '%s' "$id"
    return 0
  done
  return 1
}

drive_investigate_dispatch() {
  f=$(claims_file)
  [ -f "$f" ] || return 1
  total=$(grep -c '^### C' "$f" 2>/dev/null || true); total=${total:-0}
  [ "$total" -gt 0 ] || return 1
  agent=$(drive_cast_agents claim-auditor | head -1)
  [ -n "$agent" ] || return 1
  dispatched=0
  i=1
  while [ "$i" -le "$total" ]; do
    cn="C$i"
    if ! drive_has_claim_dispatch "$cn" claim-auditor "$agent"; then
      cmd_dispatch "$cn" claim-auditor "$agent" || true
      dispatched=1
    fi
    i=$((i + 1))
  done
  i=1
  while [ "$i" -le "$total" ]; do
    cn="C$i"
    truth=0
    if [ -d "$ROOT/claims/$cn/verdicts" ]; then
      grep -l '^CLAIM-VERDICT: TRUE$' "$ROOT/claims/$cn/verdicts"/*.md >/dev/null 2>&1 && truth=1 || true
    fi
    scout=$(sed -n "/^### $cn /,/^### C[0-9]/{s/^    scout: //p;}" "$f" | head -1)
    if [ "$truth" -eq 1 ] && [ -z "$scout" ]; then
      scout_agent=$(drive_cast_agents scout | head -1)
      [ -n "$scout_agent" ] || scout_agent=$agent
      if [ -n "$scout_agent" ] && ! drive_has_claim_dispatch "$cn" scout "$scout_agent"; then
        cmd_dispatch "$cn" scout "$scout_agent" || true
        dispatched=1
      fi
    fi
    i=$((i + 1))
  done
  [ "$dispatched" -eq 1 ]
}

drive_parent_seal_unsealed() {
  auto_pass=${1:-0}
  [ -d "$ROOT/attempts" ] || return 0
  for ad in "$ROOT"/attempts/A*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    [ "$(attempt_state "$id")" = DISPATCHED ] || continue
    role=$(attempt_meta "$id" 5)
    case $role in claim-auditor|scout) : ;; *) continue ;; esac
    agent=$(attempt_meta "$id" 6)
    if ! attempt_transport "$id" >/dev/null 2>&1; then
      hop=$(drive_claim_hop_transport "$agent")
      ( cmd_attempt transport "$id" "$hop" >/dev/null ) || \
        ( cmd_attempt transport "$id" multi-agent >/dev/null ) || true
    fi
  done
  [ "$auto_pass" = 1 ] || return 0
  auditor=$(suggest_contract_auditor)
  [ -n "$auditor" ] && [ "$auditor" != '<auditor-name>' ] || return 0
  for ad in "$ROOT"/attempts/A*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    [ "$(attempt_state "$id")" = DISPATCHED ] || continue
    role=$(attempt_meta "$id" 5)
    case $role in claim-auditor|scout) : ;; *) continue ;; esac
    claim_attempt_is_sealed "$id" && continue
    agent=$(attempt_meta "$id" 6)
    [ "$auditor" != "$agent" ] || continue
    contract_structural_ok "$ad" "$role" || continue
    attempt_transport "$id" >/dev/null 2>&1 || continue
    if ( cmd_contract_audit "$id" "$auditor" PASS \
      "engine-template INVESTIGATE fallback; parent sealed without coordinator ACP" >/dev/null ); then
      break
    fi
  done
}

drive_apply_isomorphic_verdicts() {
  [ -d "$ROOT/claims" ] || return 0
  for vd in "$ROOT"/claims/C*/verdicts/*.md; do
    [ -f "$vd" ] || continue
    word=$(sed -n 's/^CLAIM-VERDICT: //p' "$vd" | head -1)
    case $word in STALE|FALSE|UNVERIFIABLE) : ;; *) continue ;; esac
    who=$(sed -n 's/^AGENT: //p' "$vd" | head -1)
    from=${vd##*/claims/}; from=${from%%/*}
    [ -n "$who" ] && [ -n "$from" ] || continue
    from_id=$(drive_claim_attempt_id "$from" claim-auditor "$who") || continue
    for cdir in "$ROOT"/claims/C*; do
      [ -d "$cdir" ] || continue
      to=${cdir##*/}
      [ "$to" = "$from" ] && continue
      [ -f "$cdir/verdicts/$who.md" ] && continue
      to_id=$(drive_claim_attempt_id "$to" claim-auditor "$who") || continue
      [ -f "$ROOT/attempts/$from_id/contract.md" ] || continue
      [ -f "$ROOT/attempts/$to_id/contract.md" ] || continue
      contracts_isomorphic "$ROOT/attempts/$from_id/contract.md" "$ROOT/attempts/$to_id/contract.md" || continue
      claim_copy_verdict_like "$from" "$to" "$who" >/dev/null 2>&1 || true
    done
  done
}

drive_any_claim_dispatch() {
  [ -d "$ROOT/claims" ] || return 1
  find "$ROOT/claims" -path '*/dispatches/*' -type f 2>/dev/null | grep -q .
}

drive_investigate_parent_tick() {
  repo=$1
  dispatched=0
  drive_investigate_dispatch && dispatched=1
  drive_parent_seal_unsealed "$dispatched"
  drive_apply_isomorphic_audits
  drive_apply_isomorphic_verdicts
  started=0
  nid=$(drive_next_sealed_id) || nid=
  if [ -n "$nid" ]; then
    nrole=$(attempt_meta "$nid" 5)
    case $nrole in
      claim-auditor|scout)
        if drive_invoke_sealed_worker "$repo"; then
          started=1
          drive_apply_isomorphic_audits
          drive_apply_isomorphic_verdicts
        fi
        ;;
    esac
  fi
  [ "$dispatched" -eq 1 ] || [ "$started" -eq 1 ]
}

drive_live_attempt_count() {
  n=0
  [ -d "$ROOT/attempts" ] || { printf '0'; return; }
  for ad in "$ROOT"/attempts/A*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    st=$(attempt_state "$id")
    case $st in DISPATCHED|RUNNING|OVERDUE) n=$((n + 1)) ;; esac
  done
  printf '%s' "$n"
}

drive_apply_isomorphic_audits() {
  [ -d "$ROOT/attempts" ] || return 0
  for tad in "$ROOT"/attempts/A*; do
    [ -d "$tad" ] || continue
    [ -f "$tad/contract-audit.md" ] || continue
    grep -q '^VERDICT: PASS' "$tad/contract-audit.md" || continue
    tid=${tad##*/}
    for dad in "$ROOT"/attempts/A*; do
      [ -d "$dad" ] || continue
      did=${dad##*/}
      [ "$did" = "$tid" ] && continue
      [ -e "$dad/contract-audit.md" ] && continue
      contract_audit_copy_like "$tid" "$did" >/dev/null || true
    done
  done
}

drive_attempt_is_runnable() {
  id=$1
  [ "$(attempt_state "$id")" = DISPATCHED ] || return 1
  claim_attempt_is_sealed "$id"
}

drive_next_sealed_id() {
  [ -d "$ROOT/attempts" ] || return 1
  inflight=$(drive_inflight)
  if [ -n "$inflight" ] && [ "$inflight" != - ] && drive_attempt_is_runnable "$inflight"; then
    printf '%s' "$inflight"
    return 0
  fi
  item=$(drive_active_item)
  if [ -n "$item" ] && [ "$item" != - ]; then
    for ad in "$ROOT"/attempts/A*; do
      [ -d "$ad" ] || continue
      id=${ad##*/}
      [ "$(attempt_meta "$id" 2)" = "$item" ] || continue
      drive_attempt_is_runnable "$id" || continue
      printf '%s' "$id"
      return 0
    done
  fi
  for ad in "$ROOT"/attempts/A*; do
    [ -d "$ad" ] || continue
    id=${ad##*/}
    drive_attempt_is_runnable "$id" || continue
    printf '%s' "$id"
    return 0
  done
  return 1
}

drive_invoke_sealed_worker() {
  repo=$1
  id=$(drive_next_sealed_id) || return 1
  ad="$ROOT/attempts/$id"
  agent=$(attempt_meta "$id" 6)
  brief="$ad/contract.md"
  [ -f "$brief" ] || return 1
  cmd=$(invocation "$agent" "$brief")
  case $cmd in
    '(no command registered'*|'')
      printf 'HUMAN — sealed attempt %s has no agents.tsv command for %s\n' "$id" "$agent"
      return 1
      ;;
  esac
  now=$(date +%s)
  timeout=${CRUCIBLE_DRIVE_WORKER_TIMEOUT:-900}
  posint "$timeout" || timeout=900
  dl=$(attempt_meta "$id" 12)
  if posint "$dl"; then
    rem=$((dl - now))
    if [ "$rem" -gt 0 ] && [ "$rem" -lt "$timeout" ]; then
      timeout=$rem
    fi
  fi
  ( cd "$repo" && sh -c "$cmd" ) > "$ad/invoke.log" 2>&1 &
  pid=$!
  cmd_attempt start "$id" "$pid" >/dev/null || {
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    return 1
  }
  elapsed=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$elapsed" -ge "$timeout" ]; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      cmd_attempt finish "$id" TIMEOUT "drive worker exceeded ${timeout}s" >/dev/null
      printf 'drive: %s TIMEOUT after %ss\n' "$id" "$timeout"
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  rc=0
  wait "$pid" || rc=$?
  if [ "$rc" -eq 0 ]; then
    cmd_attempt finish "$id" RETURNED "drive worker exit 0" >/dev/null
    drive_worker_returned=1
  else
    cmd_attempt finish "$id" STOPPED "drive worker exit $rc" >/dev/null
  fi
  printf 'drive: started %s pid %s (%s); finish recorded\n' "$id" "$pid" "$agent"
}

drive_finish_tick() {
  line2=$(write_cycle_status)
  state2=$(drive_state_name "$line2")
  token=$(drive_progress_token "$line2")
  prev=
  [ -f "$ROOT/DRIVE.state" ] && prev=$(sed -n 's/^token: //p' "$ROOT/DRIVE.state" | head -1)
  stalls=0
  [ -f "$ROOT/DRIVE.state" ] && stalls=$(sed -n 's/^stalls: //p' "$ROOT/DRIVE.state" | head -1)
  [ -n "$stalls" ] || stalls=0
  if [ -n "$prev" ] && [ "$prev" = "$token" ]; then
    stalls=$((stalls + 1))
  else
    stalls=0
  fi
  printf 'token: %s\nstalls: %s\n' "$token" "$stalls" > "$ROOT/DRIVE.state"
  if [ "${drive_worker_returned:-0}" -eq 1 ]; then
    stalls=0
    printf 'token: %s\nstalls: %s\n' "$token" "$stalls" > "$ROOT/DRIVE.state"
    if drive_is_human_gate "$state2"; then
      drive_print_human "$state2" "$line2"
    fi
    return 0
  fi
  if [ "$stalls" -ge 1 ]; then
    printf 'STOP — no progress (same status and no new evidence twice)\n'
    drive_unlock; trap - 0 1 2 15
    return 2
  fi
  if drive_is_human_gate "$state2"; then
    drive_print_human "$state2" "$line2"
    drive_unlock; trap - 0 1 2 15
    return 2
  fi
  return 0
}

drive_perform_legal() {
  state=$1
  line=$2
  case $state in
    INVESTIGATE)
      drive_investigate_dispatch || true
      ;;
    WAIT)
      # CHECK: a second live attempt must not appear because of drive.
      :
      ;;
    EXECUTE)
      slug=$(printf '%s\n' "$line" | awk '{print $3}')
      item=$(drive_active_item)
      [ -n "$slug" ] && [ "$slug" != — ] || slug=$item
      inflight=$(drive_inflight)
      if [ -n "$slug" ] && [ "$slug" != - ] && { [ -z "$inflight" ] || [ "$inflight" = - ]; }; then
        maker=$(drive_cast_agents maker | head -1)
        if [ -n "$maker" ] && [ "$(state_value "$slug" 3 2>/dev/null || true)" = BUILD ]; then
          cmd_dispatch "$slug" maker "$maker" || true
        fi
      fi
      ;;
    REVIEW)
      slug=$(printf '%s\n' "$line" | awk '{print $3}')
      item=$(drive_active_item)
      [ -n "$slug" ] && [ "$slug" != — ] || slug=$item
      if [ -n "$slug" ] && [ "$slug" != - ]; then
        inflight=$(drive_inflight)
        ast=; role=
        if [ -n "$inflight" ] && [ "$inflight" != - ]; then
          ast=$(attempt_state "$inflight" 2>/dev/null || true)
          role=$(attempt_meta "$inflight" 5 2>/dev/null || true)
        fi
        if judge_requested_fix "$slug" \
          && [ "$(state_value "$slug" 3 2>/dev/null || true)" = REVIEW ]; then
          if [ -z "$inflight" ] || [ "$inflight" = - ] \
            || { [ "$ast" = RETURNED ] && [ "$role" = judge ]; }; then
            cmd_phase "$slug" BUILD || true
            maker=$(drive_cast_agents maker | head -1)
            [ -n "$maker" ] && cmd_dispatch "$slug" maker "$maker" || true
          fi
        elif [ "$ast" = RETURNED ] && [ "$role" = maker ]; then
          reviewer=$(drive_cast_agents reviewer | head -1)
          [ -z "$reviewer" ] && reviewer=$(drive_cast_agents judge | head -1)
          if [ -n "$reviewer" ] && [ "$(state_value "$slug" 3 2>/dev/null || true)" = REVIEW ]; then
            cmd_dispatch "$slug" judge "$reviewer" || true
          fi
        fi
      fi
      ;;
  esac
}

drive_print_human() {
  state=$1
  line=$2
  self=$(self_path)
  case $state in
    WAIT_PANEL)
      printf 'HUMAN — approve the agent panel: %s cycle approve-panel\n' "$self" ;;
    WAIT_APPROVAL)
      printf 'HUMAN — approve the current proposal: %s cycle approve\n' "$self" ;;
    ESCALATE)
      printf 'HUMAN — %s\n' "$line" ;;
    DONE)
      printf 'HUMAN — cycle is DONE. Next: %s cycle clean --dry-run\n' "$self"
      printf 'HUMAN — or bind the next problem: %s cycle problem FILE --next\n' "$self"
      printf 'HUMAN — drive never runs cycle clean --apply and never --nexts\n' "$self" ;;
  esac
}

drive_is_human_gate() {
  case $1 in WAIT_PANEL|WAIT_APPROVAL|ESCALATE|DONE) return 0 ;; *) return 1 ;; esac
}

drive_invoke_coordinator() {
  repo=$1
  # After seal, the parent starts the worker. Do not start coordinator ACP.
  if drive_next_sealed_id >/dev/null 2>&1; then
    return 0
  fi
  agent=$(drive_coordinator_agent) || agent=
  [ -n "$agent" ] || return 0
  drive_write_brief
  cmd=$(invocation "$agent" "$ROOT/DRIVE.BRIEF.md")
  case $cmd in
    '(no command registered'*|'') return 0 ;;
  esac
  if ! ( cd "$repo" && sh -c "$cmd" ); then
    die "refused: coordinator invoke failed — $cmd"
  fi
}

drive_stop() {
  # Human/operator: release a leftover lock. Reclaim dead RUNNING. Do not
  # kill a live worker. Drive never --nexts or --apply.
  if [ -d "$ROOT/attempts" ]; then
    for ad in "$ROOT"/attempts/A*; do
      [ -d "$ad" ] || continue
      id=${ad##*/}
      st=$(attempt_state "$id")
      case $st in
        RUNNING|OVERDUE)
          if attempt_pid_alive "$id"; then
            printf 'live-attempt: %s %s pid %s (not reclaimed)\n' "$id" "$st" "$(attempt_pid "$id")"
          else
            cmd_attempt reclaim "$id" >/dev/null
            printf 'reclaimed %s (dead pid)\n' "$id"
          fi
          ;;
      esac
    done
  fi
  if [ -d "$ROOT/.drive.lock" ]; then
    rmdir "$ROOT/.drive.lock" 2>/dev/null \
      || die "refused: could not remove $ROOT/.drive.lock"
    printf 'released %s/.drive.lock\n' "$ROOT"
  else
    printf 'no .drive.lock\n'
  fi
}

cmd_drive() {
  uses_guided_cycle || die 'drive requires a guided cycle'
  uses_managed_lifecycle || die 'drive requires managed lifecycle behavior'
  # Do not name this `sub`: cmd_attempt/cmd_cycle overwrite `sub` in this shell.
  drive_mode=${1:-loop}
  case $drive_mode in
    stop)
      [ $# -eq 1 ] || die 'usage: crucible drive stop'
      drive_stop
      return
      ;;
    tick|loop|'') : ;;
    *) die 'usage: crucible drive [tick|loop|stop]' ;;
  esac
  [ $# -eq 0 ] || shift
  [ $# -eq 0 ] || die 'usage: crucible drive [tick|loop|stop]'
  mkdir "$ROOT/.drive.lock" 2>/dev/null || die 'drive already running'
  # shellcheck disable=SC2329
  drive_unlock() { rmdir "$ROOT/.drive.lock" 2>/dev/null || true; }
  trap 'drive_unlock' 0 1 2 15
  max=${CRUCIBLE_DRIVE_MAX:-32}
  posint "$max" || die 'CRUCIBLE_DRIVE_MAX must be a positive integer'
  n=0
  while :; do
    n=$((n + 1))
    [ "$n" -le "$max" ] || die "drive stopped: iteration cap $max"
    drive_worker_returned=0
    uses_guided_cycle || die 'drive requires a guided cycle (PROGRAM cycle: guided was removed)'
    uses_managed_lifecycle || die 'drive requires managed lifecycle behavior'
    repo=$(drive_product_repo)
    [ -n "$repo" ] && [ -d "$repo" ] || die 'drive requires PROGRAM repo:'
    line=$(write_cycle_status)
    state=$(drive_state_name "$line")
    if drive_is_human_gate "$state"; then
      drive_print_human "$state" "$line"
      drive_unlock; trap - 0 1 2 15
      return 0
    fi
    # P2: a tick whose last inflight attempt is already RETURNED is success.
    if [ "$drive_mode" = tick ]; then
      inflight=$(drive_inflight)
      if [ -n "$inflight" ] && [ "$inflight" != - ]; then
        ast=$(attempt_state "$inflight" 2>/dev/null || true)
        if [ "$ast" = RETURNED ] && ! drive_next_sealed_id >/dev/null 2>&1; then
          if [ -f "$ROOT/attempts/$inflight/result.md" ]; then
            nxta=$(sed -n 's/^NEXT: //p' "$ROOT/attempts/$inflight/result.md" | head -1)
            if [ "$nxta" != FIX ]; then
              printf 'drive: attempt %s already RETURNED\n' "$inflight"
              drive_unlock; trap - 0 1 2 15
              return 0
            fi
          fi
        fi
      fi
    fi
    mkdir -p "$ROOT/items"
    if [ "$state" = INVESTIGATE ]; then
      if drive_investigate_parent_tick "$repo"; then
        if drive_finish_tick; then
          case $drive_mode in
            tick) drive_unlock; trap - 0 1 2 15; return 0 ;;
          esac
          continue
        fi
        return 0
      fi
    fi
    drive_apply_isomorphic_audits
    if drive_invoke_sealed_worker "$repo"; then
      if drive_finish_tick; then
        case $drive_mode in
          tick) drive_unlock; trap - 0 1 2 15; return 0 ;;
        esac
        continue
      fi
      return 0
    fi
    drive_take_snapshot "$repo"
    before_disp=0
    [ -d "$ROOT/claims" ] && before_disp=$(find "$ROOT/claims" -path '*/dispatches/*' -type f 2>/dev/null | wc -l | tr -d ' ')
    drive_invoke_coordinator "$repo"
    drive_check_discipline "$repo"
    if [ "$state" = WAIT ]; then
      d=$(drive_snap_dir)
      drive_live_attempt_ids > "$d/live_ids_after"
      extra=
      while IFS= read -r id; do
        [ -n "$id" ] || continue
        grep -Fxq "$id" "$d/live_ids" 2>/dev/null && continue
        extra=$id
        break
      done < "$d/live_ids_after"
      if [ -n "$extra" ]; then
        drive_restore_all "$repo"
        die "refused: WAIT inflight — do not start a second attempt ($extra)"
      fi
    fi
    after_disp=0
    [ -d "$ROOT/claims" ] && after_disp=$(find "$ROOT/claims" -path '*/dispatches/*' -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "$after_disp" -le "$before_disp" ]; then
      drive_perform_legal "$state" "$line"
    fi
    drive_apply_isomorphic_audits
    if drive_invoke_sealed_worker "$repo"; then
      if drive_finish_tick; then
        case $drive_mode in
          tick) drive_unlock; trap - 0 1 2 15; return 0 ;;
        esac
        continue
      fi
      return 0
    fi
    if drive_finish_tick; then
      case $drive_mode in
        tick) drive_unlock; trap - 0 1 2 15; return 0 ;;
      esac
    else
      return 0
    fi
  done
}

cmd_cycle_status() {
  # Guided cycles require panel configure/approval before investigation.
  if uses_guided_cycle; then
    if ! panel_valid; then
      if ! agents_registry_ready; then
        printf 'NEXT CONFIGURE — replace placeholder agents.tsv; ask operator for agents AND role casting; write PANEL.md + PANEL.ASSIGN.tsv\n'
      elif [ ! -f "$(assign_file)" ]; then
        printf 'NEXT CONFIGURE — cast personas to independent agents in PANEL.ASSIGN.tsv (role→agent) and complete PANEL.md\n'
      else
        printf 'NEXT CONFIGURE — fix PANEL.md / PANEL.ASSIGN.tsv (agents inventory, role casting, risk, isolation, ladder, waivers)\n'
      fi
      return
    fi
    if ! panel_approval_current; then
      printf 'WAIT PANEL — show agent inventory and role casting %s to the operator; do not investigate or build\n' "$(panel_id)"
      return
    fi
  fi
  problem="$ROOT/PROBLEM.md"
  if [ ! -s "$problem" ] || grep -q 'TEMPLATE-PROBLEM-NEEDS-INPUT' "$problem" 2>/dev/null; then
    printf 'NEXT INTAKE — capture the operator\047s problem in PROBLEM.md\n'
    return
  fi
  investigation=$(cycle_investigation_state)
  case $investigation in
    EMPTY) printf 'NEXT INVESTIGATE — split PROBLEM.md into atomic claims and verify them via independent agents\n'; return ;;
    NEEDS_AUDIT)
      if claims_absent_only; then
        printf 'NEXT INVESTIGATE — independently fact-check every unresolved ABSENT claim (NO-BUILD if all FALSE/STALE)\n'
      else
        printf 'NEXT INVESTIGATE — independently fact-check every unresolved claim (FALSE/STALE closes a claim; admit needs %s sealed TRUE to create work)\n' "$(guided_min_auditors)"
      fi
      return ;;
    NEEDS_SCOUT) printf 'NEXT INVESTIGATE — search for existing behavior before proposing work\n'; return ;;
  esac
  if ! proposal_valid; then
    case $(cycle_worth) in
      DOCS) printf 'NEXT PROPOSE — no ABSENT capability; propose DOCS-ONLY or live-observation\n' ;;
      NO-BUILD) printf 'NEXT PROPOSE — no missing capability; propose NO-BUILD or stop\n' ;;
      *) printf 'NEXT PROPOSE — write a refined, evidence-grounded PROPOSAL.md\n' ;;
    esac
    return
  fi
  pid=$(proposal_id)
  if ! approval_current; then
    printf 'WAIT APPROVAL — show proposal %s to the operator; do not plan or build\n' "$pid"
    return
  fi
  if uses_managed_lifecycle; then
    state_validate_file "$ROOT/STATE.tsv"
    # Surface independence escalation from blocked items first.
    blocked=$(awk -F '\t' 'NR > 1 && $2 == "BLOCKED" && $7 == "INDEPENDENCE_UNAVAILABLE" { print $1; exit }' "$ROOT/STATE.tsv")
    if [ -n "$blocked" ]; then
      printf 'ESCALATE INDEPENDENCE_UNAVAILABLE %s — cannot invoke required independent agent; stop and warn; do not continue as solo theatre\n' "$blocked"
      return
    fi
    slug=$(awk -F '\t' 'NR > 1 && ($2 == "ACTIVE" || $2 == "BLOCKED") { print $1; exit }' "$ROOT/STATE.tsv")
    if [ -n "$slug" ]; then
      status=$(state_value "$slug" 2); stage=$(state_value "$slug" 3); inflight=$(state_value "$slug" 6)
      if [ "$status" = BLOCKED ]; then
        printf 'ESCALATE %s — %s\n' "$slug" "$(state_value "$slug" 7)"
      elif [ "$inflight" = TASKS ]; then
        printf 'NEXT EXECUTE %s — dispatch dependency-ready tasks or integrate passing work\n' "$slug"
      elif [ "$inflight" != - ]; then
        attempt_status=$(attempt_state "$inflight")
        case $attempt_status in
          DISPATCHED|RUNNING) printf 'WAIT %s — agent work or review is in flight (%s)\n' "$slug" "$inflight" ;;
          OVERDUE) printf 'ESCALATE %s — observe and record the overdue process outcome (%s)\n' "$slug" "$inflight" ;;
          RETURNED) printf 'NEXT REVIEW %s — reconcile returned attempt %s against its evidence\n' "$slug" "$inflight" ;;
          TIMEOUT) printf 'NEXT EXECUTE %s — use the one bounded retry for attempt %s\n' "$slug" "$inflight" ;;
          *) printf 'ESCALATE %s — inconsistent attempt state %s for %s\n' "$slug" "$attempt_status" "$inflight" ;;
        esac
      else
        case $stage in
          DRAFT|READY) printf 'NEXT PLAN %s — validate the bounded breakdown before execution\n' "$slug" ;;
          BUILD) printf 'NEXT EXECUTE %s — make, verify, review, and fix until accepted\n' "$slug" ;;
          REVIEW) printf 'NEXT REVIEW %s — independently falsify current work; close or return findings\n' "$slug" ;;
        esac
      fi
      return
    fi
  fi
  if cycle_unadmitted_work; then
    printf 'NEXT PLAN — admit the next bounded item from approved proposal %s\n' "$pid"
    return
  fi
  write_independence_receipt
  printf 'DONE — no admittable claim remains. Next: cycle clean --dry-run (or cycle problem FILE --next). Drive never --apply.\n'
}

cycle_worktree_records() {
  program_repo=$(sed -n 's/^repo: //p' "$ROOT/PROGRAM" | head -1)
  if [ -d "$ROOT/worktrees" ]; then
    worktree_prefix=$(cd "$ROOT/worktrees" && pwd -P)/
  else
    worktree_prefix="$ROOT/worktrees/"
  fi
  {
    [ -n "$program_repo" ] && printf '%s\n' "$program_repo"
    if [ -d "$ROOT/attempts" ]; then
      for task_meta in "$ROOT"/attempts/*/task.tsv; do
        [ -f "$task_meta" ] || continue
        awk -F '\t' 'NR == 2 { print $1 }' "$task_meta"
      done
    fi
  } | LC_ALL=C sort -u | while IFS= read -r task_repo; do
    [ -n "$task_repo" ] && [ -d "$task_repo" ] || continue
    git -C "$task_repo" worktree list --porcelain 2>/dev/null | awk -v repo="$task_repo" -v prefix="$worktree_prefix" '
      /^worktree / {
        path=substr($0, 10); keep=(index(path, prefix) == 1); branch="-"; next
      }
      keep && /^branch / { branch=substr($0, 8); sub(/^refs\/heads\//, "", branch) }
      keep && /^$/ { printf "%s\t%s\t%s\n", repo, path, branch; keep=0 }
      END { if (keep) printf "%s\t%s\t%s\n", repo, path, branch }
    '
  done
}

item_stale_evidence_files() {
  slug=$1
  wid=$2
  d=$(D "$slug")
  [ -d "$d/evidence" ] || return 1
  found=0
  for f in "$d/evidence"/*; do
    [ -f "$f" ] || continue
    b=${f##*/}
    case $b in .partial.*) continue ;; *.txt) : ;; *) continue ;; esac
    stem=${b%.txt}
    id=${stem##*.}
    [ "$id" = "$wid" ] && continue
    printf '%s\n' "${f#"$ROOT"/}"
    found=1
  done
  [ "$found" -eq 1 ]
}

cycle_cleanup_report() {
  printf 'CLEANUP — next verb: cycle clean --dry-run (drive never --apply). Or cycle problem FILE --next.\n'
  printf 'KEEP panel: agents.tsv and PANEL.ASSIGN.tsv (do not destroy the panel after NO-BUILD).\n'
  if [ -f "$ROOT/STATE.tsv" ]; then
    awk -F '\t' 'NR > 1 && $2 == "CLOSED" { printf "closed-item: %s work %s\n", $1, $4 }' "$ROOT/STATE.tsv"
  fi
  if [ -d "$ROOT/items" ]; then
    for idir in "$ROOT"/items/*; do
      [ -d "$idir" ] || continue
      slug=${idir##*/}
      [ -d "$idir/evidence" ] || continue
      wid=$(workid "$slug" 2>/dev/null || printf '')
      item_stale_evidence_files "$slug" "$wid" 2>/dev/null | while IFS= read -r p; do
        printf 'stale-evidence: %s\n' "$p"
      done
    done
  fi
  if [ -d "$ROOT/.drive.lock" ]; then
    printf 'stale-lock: .drive.lock\n'
  fi
  if [ -d "$ROOT/attempts" ]; then
    for attempt_path in "$ROOT"/attempts/A*; do
      [ -d "$attempt_path" ] || continue
      aid=${attempt_path##*/}
      ast=$(attempt_state "$aid" 2>/dev/null || true)
      case $ast in
        RUNNING|OVERDUE)
          if attempt_pid_alive "$aid"; then
            printf 'live-attempt: %s %s\n' "$aid" "$ast"
          else
            printf 'dead-pid: %s %s (attempt reclaim)\n' "$aid" "$ast"
          fi
          ;;
      esac
    done
  fi
  if [ -f "$ROOT/PROBLEM.md" ] && [ -f "$ROOT/PANEL.CONTEXT.md" ]; then
    ptitle=$(cycle_problem_title "$ROOT/PROBLEM.md")
    ctitle=$(sed -n 's/^problem-title: //p' "$ROOT/PANEL.CONTEXT.md" | head -1)
    [ "$ptitle" = "$ctitle" ] || printf 'panel-title-stale: context %s vs PROBLEM %s\n' "$ctitle" "$ptitle"
  fi
  if [ -f "$(claims_file)" ]; then
    grep -n '^    status: NEW$' "$(claims_file)" >/dev/null 2>&1 \
      && printf 'claims-status-new: CLAIMS.md still has status NEW after close/audit\n'
  fi
  printf 'NOT cycle clean: Jira leftovers, ignored .validation/, husk programs (work/, b3/).\n'
}

cycle_cleanup() {
  flag=${1:-}; case $flag in --dry-run|--apply) : ;; *) die 'usage: crucible cycle clean --dry-run|--apply' ;; esac
  uses_guided_cycle || die 'cleanup requires a guided cycle'
  status=$(cmd_cycle_status)
  case $status in DONE*) : ;; *) die "cleanup requires DONE; current cycle says: $status" ;; esac
  if [ -d "$ROOT/attempts" ]; then
    for attempt_path in "$ROOT"/attempts/*; do
      [ -d "$attempt_path" ] || continue
      attempt_id=${attempt_path##*/}; attempt_status=$(attempt_state "$attempt_id")
      case $attempt_status in
        RUNNING|OVERDUE)
          if attempt_pid_alive "$attempt_id"; then
            die "cleanup refuses while attempt $attempt_id is $attempt_status (live pid)"
          fi
          cmd_attempt reclaim "$attempt_id" >/dev/null
          ;;
        DISPATCHED) : ;;
        *)
          attempt_terminal "$attempt_status" \
            || die "cleanup refuses while attempt $attempt_id is $attempt_status"
          ;;
      esac
    done
  fi
  cycle_cleanup_report
  found=0
  if [ -f "$ROOT/agents.tsv" ]; then
    printf 'KEEP %s (panel identity — not leftover evidence)\n' "$ROOT/agents.tsv"
  fi
  if [ -f "$ROOT/PANEL.ASSIGN.tsv" ]; then
    printf 'KEEP %s (panel identity — not leftover evidence)\n' "$ROOT/PANEL.ASSIGN.tsv"
  fi
  worktree_records=$(cycle_worktree_records)
  if [ -n "$worktree_records" ]; then
    while IFS="$(printf '\t')" read -r task_repo task_worktree task_branch; do
      [ -n "$task_worktree" ] || continue
      printf 'REMOVE_WORKTREE %s\nPRESERVE_BRANCH %s %s\n' "$task_worktree" "$task_repo" "$task_branch"
      found=1
    done <<EOF
$worktree_records
EOF
  fi
  printf 'PRESERVE %s (problem, proposal, work, reviews, and evidence)\n' "$ROOT"
  [ "$found" -eq 1 ] || printf 'NO_SESSION_ARTIFACTS\n'
  [ "$flag" = --apply ] || return 0
  if [ -n "$worktree_records" ]; then
    while IFS="$(printf '\t')" read -r task_repo task_worktree task_branch; do
      [ -n "$task_worktree" ] && [ -d "$task_worktree" ] || continue
      git -C "$task_repo" worktree remove "$task_worktree" \
        || die "could not safely remove worktree: $task_worktree"
    done <<EOF
$worktree_records
EOF
  fi
  [ ! -d "$ROOT/worktrees" ] \
    || { find "$ROOT/worktrees" -depth -type d -exec rmdir {} \; 2>/dev/null || true; }
  printf 'session cleanup applied; panel identity and evidence preserved\n'
}

cycle_live_attempts_terminal() {
  [ -d "$ROOT/attempts" ] || return 0
  for attempt_path in "$ROOT"/attempts/*; do
    [ -d "$attempt_path" ] || continue
    attempt_id=${attempt_path##*/}
    attempt_status=$(attempt_state "$attempt_id")
    # --next archives the investigation. Block only attempts that may still have a
    # process. DISPATCHED-never-started leftovers are not live workers.
    case $attempt_status in
      RUNNING|OVERDUE)
        if attempt_pid_alive "$attempt_id"; then
          die "refused: attempt $attempt_id is $attempt_status"
        fi
        cmd_attempt reclaim "$attempt_id" >/dev/null
        ;;
    esac
  done
}

cycle_no_current_item() {
  uses_managed_lifecycle || return 0
  [ -f "$ROOT/STATE.tsv" ] || return 0
  slug=$(awk -F '\t' 'NR > 1 && ($2 == "ACTIVE" || $2 == "BLOCKED") { print $1; exit }' "$ROOT/STATE.tsv")
  [ -z "$slug" ]
}

cycle_archive_investigation() {
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  pid=noproposal
  if try=$(proposal_id); then
    pid=$try
  fi
  dest="$ROOT/history/$stamp-$pid"
  [ ! -e "$dest" ] || die "archive already exists: $dest"
  mkdir -p "$dest"
  for f in PROBLEM.md CLAIMS.md PROPOSAL.md APPROVAL STATE.tsv STATE.md INDEPENDENCE.md BACKLOG.md DRIVE.state DRIVE.BRIEF.md STATUS.md; do
    [ -e "$ROOT/$f" ] || continue
    mv "$ROOT/$f" "$dest/"
  done
  for d in claims items approvals attempts; do
    [ -e "$ROOT/$d" ] || continue
    mv "$ROOT/$d" "$dest/"
  done
  mkdir -p "$ROOT/items"
  printf '# CLAIMS — %s\n\nOne heading per finding from the problem document, quoting its source sentence\nverbatim. Nothing becomes an item until it survives audit.\n' \
    "$(sed -n 's/^program: //p' "$ROOT/PROGRAM" 2>/dev/null | head -1)" > "$ROOT/CLAIMS.md"
  printf -- '- [ ] example — replace this line with real items as claims are admitted\n' > "$ROOT/BACKLOG.md"
  if uses_managed_lifecycle; then
    printf 'item\tstatus\tstage\twork_id\trisk\tinflight_attempt\tblock_code\tupdated_epoch\n' > "$ROOT/STATE.tsv"
    state_render_file "$ROOT/STATE.md"
  fi
  printf '%s' "$dest"
}

cycle_bind_problem() {
  src=$1
  [ -s "$src" ] && [ -f "$src" ] && [ ! -L "$src" ] || die "problem must be a non-empty regular file: $src"
  tmp="$ROOT/.PROBLEM.md.$$.tmp"; trap 'rm -f "$tmp"' 0 1 2 15
  cp "$src" "$tmp"; mv "$tmp" "$ROOT/PROBLEM.md"; trap - 0 1 2 15
  cycle_sync_panel_context
  printf '%s/PROBLEM.md\n' "$ROOT"
}

cycle_problem_title() {
  sed -n '/[^[:space:]]/{s/^#[[:space:]]*//;s/`//g;p;q;}' "$1" 2>/dev/null
}

cycle_refuse_leftover_title() {
  leftover_title=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case $leftover_title in
    *pr-status*|prstatus)
      die "refused: leftover pr-status title — bind the real PROBLEM, not a leftover title"
      ;;
  esac
}

cycle_refuse_non_problem() {
  # A PROBLEM is a falsifiable outcome in current behavior. One-line
  # "X is not a CLI verb" is claim polarity. Leftover RFC catalogs are
  # not a PROBLEM unless the file names one outcome.
  src=$1
  title=$(cycle_problem_title "$src")
  cycle_refuse_leftover_title "$title"
  nlines=$(grep -c '[^[:space:]]' "$src" 2>/dev/null || true)
  nlines=${nlines:-0}
  folded=$(tr '\n' ' ' < "$src")
  ncli=$(grep -ciE 'is not a CLI verb' "$src" 2>/dev/null || true)
  ncli=${ncli:-0}
  if [ "$ncli" -ge 8 ]; then
    die "refused: leftover catalog of CLI-verb claims is not a PROBLEM — file one falsifiable outcome"
  fi
  if printf '%s' "$title $folded" | grep -qiE 'is not a CLI verb'; then
    [ "$nlines" -gt 3 ] \
      || die "refused: 'is not a CLI verb' is claim polarity, not a PROBLEM"
  fi
  lt=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]')
  if printf '%s' "$lt" | grep -Eq 'leftover|remainder|what.?s left'; then
    grep -qiE 'falsif|## outcome|must [a-z]' "$src" \
      || die "refused: leftover/remainder catalog is not a PROBLEM — file one falsifiable outcome"
  fi
}

cycle_sync_panel_context() {
  [ -s "$ROOT/PROBLEM.md" ] || return 0
  title=$(cycle_problem_title "$ROOT/PROBLEM.md")
  [ -n "$title" ] || return 0
  if [ -f "$ROOT/PANEL.CONTEXT.md" ]; then
    ctitle=$(sed -n 's/^problem-title: //p' "$ROOT/PANEL.CONTEXT.md" | head -1)
    [ "$title" = "$ctitle" ] && return 0
  fi
  risk=LOW
  if grep -qiE '\bHIGH\b' "$ROOT/PROBLEM.md" 2>/dev/null; then
    risk=HIGH
  elif grep -qiE '\bMEDIUM\b' "$ROOT/PROBLEM.md" 2>/dev/null; then
    risk=MEDIUM
  fi
  {
    printf 'problem-title: %s\n' "$title"
    printf 'risk: %s\n' "$risk"
    printf 'refreshed-epoch: %s\n' "$(date +%s)"
    printf '\nSynced from PROBLEM.md. Cast is unchanged.\n'
  } > "$ROOT/PANEL.CONTEXT.md"
}

cycle_refresh_panel_context() {
  # Title/risk overlay. Cast (ASSIGN + agents) stays. First PANEL.md heading
  # is refreshed and PANEL.APPROVAL is rewritten to the new panel-id.
  title=$(cycle_problem_title "$ROOT/PROBLEM.md")
  [ -n "$title" ] || title='(untitled)'
  cycle_refuse_leftover_title "$title"
  risk=LOW
  if grep -qiE '\bHIGH\b' "$ROOT/PROBLEM.md" 2>/dev/null; then
    risk=HIGH
  elif grep -qiE '\bMEDIUM\b' "$ROOT/PROBLEM.md" 2>/dev/null; then
    risk=MEDIUM
  fi
  {
    printf 'problem-title: %s\n' "$title"
    printf 'risk: %s\n' "$risk"
    printf 'refreshed-epoch: %s\n' "$(date +%s)"
    printf '\nRefreshed by cycle problem --next. Cast is unchanged.\n'
  } > "$ROOT/PANEL.CONTEXT.md"
  pf=$(panel_file)
  if [ -f "$pf" ]; then
    awk -v t="$title" 'BEGIN{d=0} /^# / && !d { print "# " t; d=1; next } { print }' "$pf" \
      > "$pf.$$.tmp" && mv "$pf.$$.tmp" "$pf"
    if uses_guided_cycle && [ -f "$ROOT/PANEL.APPROVAL" ]; then
      pid=$(panel_id) || pid=
      if [ -n "$pid" ]; then
        now=$(date +%s)
        printf 'panel-id: %s\napproved-epoch: %s\ndecision: APPROVED\nrefreshed-by: cycle-problem-next\n' \
          "$pid" "$now" > "$ROOT/PANEL.APPROVAL"
      fi
    fi
  fi
}

cmd_cycle() {
  sub=${1:-status}; [ $# -eq 0 ] || shift
  case $sub in
    status) [ $# -eq 0 ] || die 'usage: crucible cycle [status]'; write_cycle_status ;;
    problem)
      src=; next=0; abandon=0; reason=
      while [ $# -gt 0 ]; do
        case $1 in
          --next) next=1 ;;
          --abandon)
            abandon=1
            shift
            reason=$*
            break
            ;;
          -*) die 'usage: crucible cycle problem FILE [--next] | --abandon REASON' ;;
          *)
            [ -z "$src" ] || die 'usage: crucible cycle problem FILE [--next] | --abandon REASON'
            src=$1
            ;;
        esac
        shift
      done
      if [ "$abandon" -eq 1 ]; then
        [ "$next" -eq 0 ] || die 'usage: crucible cycle problem FILE [--next] | --abandon REASON'
        [ -n "$reason" ] || die 'usage: crucible cycle problem --abandon REASON'
        [ -d "$ROOT/.drive.lock" ] \
          && die 'refused: cycle problem --abandon is a human gate — stop drive first'
        uses_guided_cycle || die 'cycle problem --abandon requires a guided cycle'
        uses_managed_lifecycle || die 'cycle problem --abandon requires managed lifecycle behavior'
        cycle_no_current_item \
          || die 'refused: an ACTIVE or BLOCKED item is current — close or escalate it first'
        dest=$(cycle_archive_investigation)
        printf 'reason: %s\nepoch: %s\ndecision: ABANDONED\n' "$reason" "$(date +%s)" \
          > "$dest/ABANDON.md"
        printf 'abandoned %s\n' "$dest"
        return
      fi
      [ -n "$src" ] || die 'usage: crucible cycle problem FILE [--next] | --abandon REASON'
      [ -s "$src" ] && [ -f "$src" ] && [ ! -L "$src" ] || die "problem must be a non-empty regular file: $src"
      cycle_refuse_non_problem "$src"
      if uses_guided_cycle; then
        panel_approval_current || die 'refused: approve the agent panel before binding a problem (cycle approve-panel)'
      fi
      if [ "$next" -eq 1 ]; then
        [ -d "$ROOT/.drive.lock" ] \
          && die 'refused: cycle problem --next is a human gate — stop drive first'
        uses_guided_cycle || die 'cycle problem --next requires a guided cycle'
        uses_managed_lifecycle || die 'cycle problem --next requires managed lifecycle behavior'
        cycle_no_current_item \
          || die 'refused: an ACTIVE or BLOCKED item is current — close or escalate it first'
        cycle_live_attempts_terminal
        dest=$(cycle_archive_investigation)
        printf 'archived %s\n' "$dest"
        cycle_bind_problem "$src"
        cycle_refresh_panel_context
        return
      fi
      [ "$(cycle_investigation_state)" = EMPTY ] || die 'refused: investigation already has claims'
      [ ! -f "$ROOT/APPROVAL" ] || die 'refused: a proposal is already approved'
      cycle_bind_problem "$src" ;;
    approve-panel)
      [ $# -eq 0 ] || die 'usage: crucible cycle approve-panel'
      [ -d "$ROOT/.drive.lock" ] \
        && die 'refused: cycle approve-panel is a human gate — stop drive first (drive never auto-approves)'
      uses_guided_cycle || die 'approve-panel requires a guided cycle'
      panel_valid || die 'refused: PANEL.md / PANEL.ASSIGN.tsv incomplete (need agents inventory, role→agent casting, non-placeholder agents.tsv, transport policy)'
      # Archive approved agents.tsv for operator inspection. Execution binds live files via
      # panel_id hash; dispatch/transport/audit/start/result refuse when that hash is stale.
      cp "$ROOT/agents.tsv" "$ROOT/PANEL.AGENTS.tsv"
      pid=$(panel_id)
      if panel_approval_current; then printf 'panel %s is already approved\n' "$pid"; return; fi
      mkdir -p "$ROOT/panel-approvals"
      record="$ROOT/panel-approvals/$pid.md"
      now=$(date +%s); tmp="$ROOT/.PANEL.APPROVAL.$$.tmp"; rtmp="$ROOT/panel-approvals/.$pid.$$.tmp"
      trap 'rm -f "$tmp" "$rtmp"' 0 1 2 15
      # Re-approving a prior content hash after an intermediate panel change re-points
      # PANEL.APPROVAL; do not die on the existing immutable history file.
      if [ ! -e "$record" ]; then
        printf 'panel-id: %s\napproved-epoch: %s\ndecision: APPROVED\nagents-hash: %s\n' \
          "$pid" "$now" "$(hashfile "$ROOT/agents.tsv" | cut -c1-12)" > "$rtmp"
        mv "$rtmp" "$record"
      else
        printf 'panel-id: %s\nreapproved-epoch: %s\ndecision: APPROVED\nagents-hash: %s\n' \
          "$pid" "$now" "$(hashfile "$ROOT/agents.tsv" | cut -c1-12)" >> "$record"
        rm -f "$rtmp"
      fi
      printf 'panel-id: %s\nrecord: panel-approvals/%s.md\n' "$pid" "$pid" > "$tmp"
      mv "$tmp" "$ROOT/PANEL.APPROVAL"; trap - 0 1 2 15
      printf 'approved panel %s\n' "$pid" ;;
    approve)
      [ $# -eq 0 ] || die 'usage: crucible cycle approve'
      [ -d "$ROOT/.drive.lock" ] \
        && die 'refused: cycle approve is a human gate — stop drive first (drive never auto-approves)'
      if uses_guided_cycle; then
        panel_approval_current || die 'refused: panel is not operator-approved'
      fi
      [ "$(cycle_investigation_state)" = COMPLETE ] || die 'refused: investigation is incomplete'
      proposal_valid || die 'refused: PROPOSAL.md is missing required sections or contains placeholders'
      pid=$(proposal_id)
      if approval_current; then printf 'proposal %s is already approved\n' "$pid"; return; fi
      mkdir -p "$ROOT/approvals"
      record="$ROOT/approvals/$pid.md"
      [ ! -e "$record" ] || die "approval record already exists but is not current: $record"
      now=$(date +%s); tmp="$ROOT/.APPROVAL.$$.tmp"; rtmp="$ROOT/approvals/.$pid.$$.tmp"
      trap 'rm -f "$tmp" "$rtmp"' 0 1 2 15
      printf 'proposal-id: %s\napproved-epoch: %s\ndecision: APPROVED\n' "$pid" "$now" > "$rtmp"
      mv "$rtmp" "$record"
      printf 'proposal-id: %s\nrecord: approvals/%s.md\n' "$pid" "$pid" > "$tmp"
      mv "$tmp" "$ROOT/APPROVAL"; trap - 0 1 2 15
      printf 'approved proposal %s\n' "$pid" ;;
    clean) [ $# -eq 1 ] || die 'usage: crucible cycle clean --dry-run|--apply'; cycle_cleanup "$1" ;;
    *) die 'usage: crucible cycle [status]|problem FILE [--next]|problem --abandon REASON|approve-panel|approve|clean --dry-run|--apply' ;;
  esac
}

judge_requested_fix() {
  slug=$1
  [ -d "$ROOT/attempts" ] || return 1
  latest=
  for rf in "$ROOT"/attempts/*/result.md; do
    [ -f "$rf" ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$rf" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^ROLE: //p' "$rf" | head -1)" = judge ] || continue
    latest=$rf
  done
  [ -n "$latest" ] || return 1
  [ "$(sed -n 's/^NEXT: //p' "$latest" | head -1)" = FIX ]
}

cmd_phase() {
  need "${1:-}"; slug=$1; new=${2:-}
  d=$(D "$slug")
  [ -n "$new" ] || { phase_of "$slug"; echo; return; }
  if uses_managed_lifecycle; then
    old=$(phase_of "$slug")
    [ ! -f "$d/TASKS.tsv" ] || { validate_task_dag "$slug"; task_assert_frozen "$slug"; }
    inflight=$(state_value "$slug" 6)
    if [ "$inflight" != - ]; then
      ast=$(attempt_state "$inflight" 2>/dev/null || true)
      if [ "$old:$new" = REVIEW:BUILD ] && [ "$ast" = RETURNED ] && judge_requested_fix "$slug"; then
        :
      else
        die "refused: attempt $inflight is still in flight"
      fi
    fi
    case "$old:$new" in
      READY:BUILD|BUILD:REVIEW) : ;;
      REVIEW:BUILD)
        judge_requested_fix "$slug" \
          || die "refused: REVIEW -> BUILD requires a judge result NEXT:FIX"
        ;;
      *) die "refused: invalid transition $old -> $new" ;;
    esac
    if [ "$old:$new" = BUILD:REVIEW ]; then
      current_wid=$(workid "$slug")
      if [ -f "$d/TASKS.tsv" ]; then
        task_integration_complete "$slug" \
          || die "refused: REVIEW requires current-work task integration"
      else
        maker_pass_exists "$slug" "$current_wid" \
          || die "refused: REVIEW requires a current-work maker PASS"
      fi
    fi
    status=$(state_value "$slug" 2); risk=$(state_value "$slug" 5)
    state_update_item "$slug" "$status" "$new" "$(workid "$slug")" "$risk" - -
    printf '%s is now in %s\n' "$slug" "$new"
    return
  fi
  case $new in SPEC|DESIGN|TASKS|BUILD|VERIFY|ADVERSARY|GRADUATE) : ;;
    *) die "phase must be one of SPEC DESIGN TASKS BUILD VERIFY ADVERSARY GRADUATE" ;; esac
  req=""
  case $new in
    TASKS)     req="DESIGN.md" ;;
    BUILD)     req="TASKS.md" ;;
    GRADUATE)  req="ADVERSARY.md" ;;
  esac
  [ -z "$req" ] || [ -f "$d/$req" ] || die "refused: $new requires $req and it does not exist"
  if grep -q '^PHASE: ' "$d/ITEM.md"; then
    sed "s|^PHASE: .*|PHASE: $new|" "$d/ITEM.md" > "$d/ITEM.$$.tmp" && mv "$d/ITEM.$$.tmp" "$d/ITEM.md"
  else
    sed "s|^STATUS: |PHASE: $new\\nSTATUS: |" "$d/ITEM.md" > "$d/ITEM.$$.tmp" && mv "$d/ITEM.$$.tmp" "$d/ITEM.md"
  fi
  printf '%s is now in %s\n' "$slug" "$new"
}

# What to do now. Reads the files, not your memory.
cmd_next() {
  if uses_managed_lifecycle; then
    state_validate_file "$ROOT/STATE.tsv"
    slug=$(awk -F '\t' 'NR > 1 && ($2 == "ACTIVE" || $2 == "BLOCKED") { print $1; exit }' "$ROOT/STATE.tsv")
    [ -n "$slug" ] || { printf 'DONE\n'; return; }
    status=$(state_value "$slug" 2); stage=$(state_value "$slug" 3)
    inflight=$(state_value "$slug" 6); block=$(state_value "$slug" 7); self=$(self_path)
    if [ "$status" = BLOCKED ]; then
      printf 'BLOCKED %s %s see %s/items/%s/ITEM.md\n' "$slug" "$block" "$ROOT" "$slug"
      return
    fi
    if [ "$inflight" = TASKS ]; then
      printf 'NEXT %s TASK_READY %s task ready %s\n' "$slug" "$self" "$slug"
      return
    fi
    if [ "$inflight" != - ]; then
      st=$(attempt_state "$inflight"); deadline=$(attempt_meta "$inflight" 12)
      case $st in
        DISPATCHED|RUNNING) printf 'WAIT %s %s\n' "$inflight" "$deadline" ;;
        OVERDUE) printf 'BLOCKED %s OVERDUE_PROCESS record an observed finish for %s\n' "$slug" "$inflight" ;;
        RETURNED) printf 'NEXT %s RESULT %s result %s <OUTCOME> <EVIDENCE-FILE> <NEXT> [FINGERPRINT]\n' "$slug" "$self" "$inflight" ;;
        TIMEOUT)
          printf 'NEXT %s RETRY %s dispatch %s %s %s %s %s %s\n' \
            "$slug" "$self" "$slug" "$(attempt_meta "$inflight" 5)" \
            "$(attempt_meta "$inflight" 6)" "$(attempt_meta "$inflight" 8)" \
            "$(attempt_meta "$inflight" 9)" "$inflight" ;;
        *) die "state points to terminal attempt $inflight ($st)" ;;
      esac
      return
    fi
    case $stage in
      DRAFT)  printf 'NEXT %s READY %s ready %s\n' "$slug" "$self" "$slug" ;;
      READY)  printf 'NEXT %s BUILD %s phase %s BUILD\n' "$slug" "$self" "$slug" ;;
      BUILD)
        if [ -f "$(D "$slug")/TASKS.tsv" ]; then
          task_assert_frozen "$slug"
          if task_integration_complete "$slug"; then
            printf 'NEXT %s REVIEW %s phase %s REVIEW\n' "$slug" "$self" "$slug"
          elif task_all_pass "$slug"; then
            printf 'NEXT %s INTEGRATE %s task integrate %s\n' "$slug" "$self" "$slug"
          else
            printf 'NEXT %s TASK_READY %s task ready %s\n' "$slug" "$self" "$slug"
          fi
        else
          printf 'NEXT %s REVIEW %s phase %s REVIEW\n' "$slug" "$self" "$slug"
        fi ;;
      REVIEW) printf 'NEXT %s CHECK %s check %s\n' "$slug" "$self" "$slug" ;;
    esac
    return
  fi
  f="$ROOT/CLAIMS.md"
  if [ -f "$f" ]; then
    tot=$(grep -c '^### C' "$f" 2>/dev/null || true); tot=${tot:-0}
    if [ "$tot" -gt 0 ]; then
      un=0; ad=0; i=1
      while [ "$i" -le "$tot" ]; do
        v=0; [ -d "$ROOT/claims/C$i/verdicts" ] && v=$(find "$ROOT/claims/C$i/verdicts" -name '*.md' 2>/dev/null | wc -l | tr -d ' ')
        [ "${v:-0}" -eq 0 ] && un=$((un+1))
        sed -n "/^### C$i /,/^### C/{s/^    item: //p;}" "$f" | grep -q . && ad=$((ad+1))
        i=$((i+1))
      done
      printf 'outer loop: %s claim(s), %s unaudited, %s admitted\n' "$tot" "$un" "$ad"
      if [ "$un" -gt 0 ]; then
        printf '  do this first: dispatch two claim-auditors of DIFFERENT kinds per unaudited claim,\n'
        printf '  record with: crucible claim verdict CN AGENT TRUE|FALSE|STALE|UNVERIFIABLE\n'
        printf '  nothing should be planned or built until the report has been fact-checked.\n\n'
      elif [ "$ad" -eq 0 ]; then
        printf '  every claim is audited. now: crucible triage — then take it to the operator\n'
        printf '  and agree the backlog before admitting anything.\n\n'
      fi
    elif [ -f "$ROOT/PROGRAM" ]; then
      printf 'no claims yet. Ask the operator for the problem document, then one claim per finding:\n'
      printf '  crucible claim add "<claim>" "<the exact sentence from the document>"\n\n'
    fi
  fi
  [ -d "$ROOT/items" ] || { echo "no items yet. Read START.md, then: crucible add SLUG \"TITLE\""; return; }
  found=0
  for d in "$ROOT"/items/*; do
    [ -d "$d" ] || continue
    slug=${d##*/}
    grep -q '^STATUS: CLOSED' "$d/ITEM.md" 2>/dev/null && continue
    found=1; ph=$(phase_of "$slug"); [ -n "$ph" ] || ph=SPEC
    printf '%s — phase %s\n' "$slug" "$ph"
    case $ph in
      SPEC)      [ -f "$d/DESIGN.md" ] || printf '  dispatch: specifier, then judge\n' ;;
      DESIGN)    printf '  dispatch: architect, then judge\n' ;;
      TASKS)     printf '  dispatch: planner, then judge\n' ;;
      BUILD)     printf '  dispatch: maker per task, then judge each\n' ;;
      VERIFY)    printf '  dispatch: maker to record the named checks, then judges\n' ;;
      ADVERSARY) printf '  dispatch: adversary\n' ;;
      GRADUATE)  printf '  dispatch: integrator, then close\n' ;;
    esac
    cmd_check "$slug" 2>/dev/null | sed -n 's/^  FAIL/  blocked: /p' | head -6 || true
    printf '  when ready: crucible dispatch %s <role> <agent>\n' "$slug"
  done
  [ "$found" = 1 ] || echo "every item is closed."
}


# Install a program into the repository you are standing in. Run this from anywhere
# inside the target repo. The program and its memory live in that repo from then on.
adopt_install_engine() {
  src=$1
  dst=$2
  mkdir -p "$dst/items" "$dst/scripts" "$dst/docs" "$dst/roles"
  for f in crucible BOOTSTRAP.md START.md RULES.md LOOP.md CONFIGURE.md VERSION; do
    [ -f "$src/$f" ] && cp "$src/$f" "$dst/"
  done
  if [ -d "$src/roles" ]; then
    for f in "$src/roles"/*.md; do
      [ -f "$f" ] && cp "$f" "$dst/roles/"
    done
  fi
  for f in "$src"/scripts/*.sh; do
    case ${f##*/} in package-release.sh|verify-package.sh) continue ;; esac
    [ -f "$f" ] && cp "$f" "$dst/scripts/"
  done
  if [ -d "$src/docs" ]; then
    for f in "$src"/docs/*.md; do
      [ -f "$f" ] && cp "$f" "$dst/docs/"
    done
  fi
  chmod +x "$dst/crucible" 2>/dev/null || true
  chmod +x "$dst/scripts/"*.sh 2>/dev/null || true
}

cmd_adopt() {
  prog=; managed=0; refresh=0
  while [ $# -gt 0 ]; do
    case $1 in
      --managed) managed=1 ;;
      --refresh) refresh=1 ;;
      -*) die 'usage: crucible adopt [PROGRAM] [--managed] [--refresh]' ;;
      *)
        [ -z "$prog" ] || die 'usage: crucible adopt [PROGRAM] [--managed] [--refresh]'
        prog=$1
        ;;
    esac
    shift
  done
  [ -n "$prog" ] || prog=main
  [ "$refresh" -eq 0 ] || [ "$managed" -eq 0 ] \
    || die 'usage: crucible adopt [PROGRAM] --refresh  (--managed is install-only)'
  case $prog in *[!A-Za-z0-9._-]*) die "program name may only contain A-Za-z0-9._-" ;; esac
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository — cd into the repo you want to work on"
  src=$(cd "$(dirname "$0")" && pwd)
  dst="$repo/.crucible/$prog"
  if [ "$refresh" -eq 1 ]; then
    if [ -d "$dst" ] && [ ! -f "$dst/PROGRAM" ]; then
      die "refused: $dst is a husk (no PROGRAM). Keep it, trash it, or adopt a different program name"
    fi
    [ -d "$dst" ] && [ -f "$dst/PROGRAM" ] || die "program does not exist: $dst"
    old=unknown
    [ -s "$dst/VERSION" ] && old=$(sed -n '1p' "$dst/VERSION")
    new=unknown
    [ -s "$src/VERSION" ] && new=$(sed -n '1p' "$src/VERSION")
    adopt_install_engine "$src" "$dst"
    printf 'refreshed engine %s -> %s\n%s\n' "$old" "$new" "$dst"
    if [ -f "$dst/scripts/acp-brief.py" ]; then
      printf 'kept local adapter: scripts/acp-brief.py\n'
    fi
    return
  fi
  [ -d "$dst" ] && die "program already exists: $dst"
  mkdir -p "$dst"
  adopt_install_engine "$src" "$dst"
  base=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo main)
  printf 'repo: %s\nprogram: %s\nbase: %s\n' "$repo" "$prog" "$base" > "$dst/PROGRAM"
  if [ "$managed" -eq 1 ]; then
    printf 'lifecycle: managed\ncycle: guided\n' >> "$dst/PROGRAM"
  fi
  printf -- '- Conversational "keep looping" is not a waiver to implement. Drive ticks one legal orchestrator action; makers stay inside EXECUTE for the admitted item.\n' > "$dst/LESSONS.md"
  printf -- '- [ ] example — replace this line with real items as claims are admitted\n' > "$dst/BACKLOG.md"
  if [ "$managed" -eq 1 ]; then
    printf 'item\tstatus\tstage\twork_id\trisk\tinflight_attempt\tblock_code\tupdated_epoch\n' > "$dst/STATE.tsv"
    cat > "$dst/STATE.md" <<STATEEOF
# STATE — $prog

Generated from \`STATE.tsv\`; do not edit this file by hand.

| Item | Status | Stage | Work ID | Risk | In-flight attempt | Block code | Updated epoch |
| --- | --- | --- | --- | --- | --- | --- | --- |
STATEEOF
  else
    cat > "$dst/STATE.md" <<STATEEOF
# STATE — $prog

The resume point. Trust this over your memory, always, and especially after a restart or a
context compaction. The orchestrator writes it after every transition; nobody else writes it.

program: $prog
repo: $repo
phase: INTAKE

## In flight

item: (none)
dispatch: (none — the path of the contract file)
awaiting: (none — the output file that must appear)

## Escalations awaiting the human

(none)

---

Recover with: cat STATE.md; .crucible/$prog/crucible next; git log --oneline -10
Never re-dispatch a phase this file marks complete.
STATEEOF
  fi
  printf '# CLAIMS — %s\n\nOne heading per finding from the problem document, quoting its source sentence\nverbatim. Nothing becomes an item until it survives audit.\n' "$prog" > "$dst/CLAIMS.md"
  cat > "$dst/PROBLEM.md" <<'EOF'
# Problem

TEMPLATE-PROBLEM-NEEDS-INPUT
EOF
  { printf '# Patterns here are relative to this .crucible/ directory.\n'
    printf '# agents.tsv names the agents on THIS machine, so it is not project state.\n'
    printf '*/agents.tsv\n'
    printf '# isolated task worktrees are retained machine state, not program artifacts.\n'
    printf '*/worktrees/\n'
  } > "$repo/.crucible/.gitignore"
  printf 'installed cycle "%s" into %s\n\n' "$prog" "$dst"
  printf 'Fresh-agent entrypoint:\n  read .crucible/%s/START.md and execute it\n\n' "$prog"
  printf 'The agent will configure its panel, investigate the problem, ask for proposal approval,\n'
  printf 'and coordinate build/review iterations. The operator does not drive protocol commands.\n'
  [ -f "$dst/agents.tsv" ] || {
    { printf '# name\tkind\tmodel\teffort\tcommand   ({BRIEF} {MODEL} {EFFORT} substituted)\n'
      printf '# Only names here may author a verdict. kind is the model family and is what\n'
      printf '# cross-model judging counts. Replace these with how YOUR agents are invoked.\n'
      printf 'mk1\tkindA\tMODEL\thigh\tAGENT_CLI --model {MODEL} --effort {EFFORT} "read {BRIEF} and follow it exactly"\n'
      printf 'j1\tkindA\tMODEL\thigh\tAGENT_CLI --model {MODEL} --effort {EFFORT} "read {BRIEF} and follow it exactly"\n'
      printf 'j2\tkindB\tMODEL\thigh\tOTHER_CLI --model {MODEL} "read {BRIEF} and follow it exactly"\n'
    } > "$dst/agents.tsv"; }
}

# Claims: the outer loop. The script keeps the ledger honest; the agent supplies meaning.
claims_file() { printf '%s/CLAIMS.md' "$ROOT"; }
claim_looks_bundled() {
  printf '%s' "$1" | grep -qiE ' and |; | \+ | / | as well as | along with |, .* and '
}

claim_present_desired() {
  printf '%s' "$1" | grep -qiE ' writes | should | must | will | needs to | ought to ' \
    && ! printf '%s' "$1" | grep -qiE ' not | never | no | isn.t | does not | do not | cannot '
}

claim_infer_polarity() {
  t=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case $t in
    *' is not '*|*' does not exist'*|*' has no '*|*' missing '*|*' not a '*) printf 'ABSENT'; return ;;
    *' already '*|*' exists '*|*' ships '*) printf 'EXISTS'; return ;;
    *' wrong '*|*' broken '*|*' defect'*|*' incorrect '*) printf 'DEFECT'; return ;;
  esac
  if claim_present_desired "$1"; then
    printf 'REFUSE-DESIRED'
    return
  fi
  printf 'ABSENT'
}

claims_set_status() {
  n=$1; st=$2; f=$(claims_file)
  [ -f "$f" ] || return 0
  awk -v c="### $n " -v s="$st" '
    $0 ~ "^"c {inc=1}
    inc && /^    status:/ {print "    status: " s; inc=0; next}
    /^### C/ && $0 !~ "^"c {inc=0}
    {print}' "$f" > "$ROOT/c.$$.tmp" && mv "$ROOT/c.$$.tmp" "$f"
}

claims_field() {
  n=$1; field=$2
  sed -n "/^### $n /,/^### C[0-9]/{s/^    $field: //p;}" "$(claims_file)" | head -1
}

claim_copy_verdict_like() {
  from=$1
  to=$2
  who=$3
  src="$ROOT/claims/$from/verdicts/$who.md"
  [ -f "$src" ] || return 1
  word=$(sed -n 's/^CLAIM-VERDICT: //p' "$src" | head -1)
  case $word in STALE|FALSE|UNVERIFIABLE) : ;; *) return 1 ;; esac
  dest="$ROOT/claims/$to/verdicts"
  mkdir -p "$dest"
  [ ! -e "$dest/$who.md" ] || return 1
  if uses_guided_cycle; then
    sealed=0
    if [ -d "$ROOT/attempts" ]; then
      for ad in "$ROOT"/attempts/A*; do
        [ -d "$ad" ] || continue
        aid=${ad##*/}
        claim_attempt_matches "$aid" "$to" "$who" || continue
        claim_attempt_is_sealed "$aid" || continue
        sealed=1
        break
      done
    fi
    [ "$sealed" -eq 1 ] || return 1
  fi
  cp "$src" "$dest/$who.md"
  case $word in
    STALE) claims_set_status "$to" STALE ;;
    *) claims_set_status "$to" AUDITED_FALSE ;;
  esac
  printf '%s/%s.md\n' "$dest" "$who"
}

cmd_claim() {
  sub=${1:-}; [ $# -eq 0 ] || shift
  f=$(claims_file)
  # The ledger creates itself. Requiring `adopt` first meant a program that was set up
  # any other way could not audit anything, which blocked the outer loop entirely.
  [ -f "$f" ] || printf '# CLAIMS\n\nOne heading per finding, quoting its source sentence verbatim.\nNothing becomes an item until it survives audit.\n' > "$f"
  case $sub in
  add)
    txt=${1:-}; src=${2:-}; pol=${3:-}
    [ -n "$txt" ] || die 'usage: crucible claim add "CLAIM" "EXACT SOURCE SENTENCE" [ABSENT|EXISTS|DEFECT]'
    [ -n "$src" ] || die 'refused: a claim needs its source sentence quoted verbatim'
    if uses_guided_cycle; then
      panel_approval_current || die 'refused: approve the agent panel before investigation (cycle approve-panel)'
    fi
    max_new=${CRUCIBLE_MAX_NEW_CLAIMS:-3}
    posint "$max_new" || die 'CRUCIBLE_MAX_NEW_CLAIMS must be a positive integer'
    newc=$(grep -c '^    status: NEW$' "$f" 2>/dev/null || true); newc=${newc:-0}
    [ "$newc" -lt "$max_new" ] \
      || die "refused: at most $max_new NEW claims (CRUCIBLE_MAX_NEW_CLAIMS); audit or drop before adding more"
    claim_looks_bundled "$txt" \
      && die 'refused: claim must be one predicate — do not bundle verbs or clauses (and/+/,/;)'
    if [ -n "$pol" ]; then
      case $pol in ABSENT|EXISTS|DEFECT) : ;; *) die 'polarity must be ABSENT, EXISTS, or DEFECT' ;; esac
    else
      pol=$(claim_infer_polarity "$txt")
      [ "$pol" != REFUSE-DESIRED ] \
        || die 'refused: present-tense desired behavior is not a gap — state ABSENT/DEFECT (e.g. "X is not a CLI verb")'
    fi
    cnt=$(grep -c '^### C' "$f" 2>/dev/null || true); cnt=${cnt:-0}
    n=$((cnt + 1))
    { printf '\n### C%s — %s\n\n' "$n" "$txt"
      printf '    source: "%s"\n' "$src"
      printf '    polarity: %s\n' "$pol"
      printf '    status: NEW\n    audited-by:\n    scout:\n    item:\n' ; } >> "$f"
    mkdir -p "$ROOT/claims/C$n/verdicts"
    printf 'C%s\n' "$n" ;;
  list)
    grep -E '^### C|^    status:' "$f" | paste - - 2>/dev/null || grep -E '^### C' "$f" ;;
  verdict)
    n=${1:-}; who=${2:-}; word=${3:-}
    [ -n "$n" ] && [ -n "$who" ] && [ -n "$word" ] || die 'usage: crucible claim verdict N AGENT TRUE|FALSE|STALE|UNVERIFIABLE [CITE] [--like C2 C3]'
    [ -n "$(kind_of "$who")" ] || die "unregistered agent: $who"
    case $word in TRUE|FALSE|STALE|UNVERIFIABLE) : ;; *) die "verdict must be TRUE FALSE STALE or UNVERIFIABLE" ;; esac
    d="$ROOT/claims/$n/verdicts"; [ -d "$d" ] || die "no such claim: $n"
    # An auditor's verdict must be backed by a check that auditor recorded. Without this the
    # outer loop is unauthenticated text: any name can assert TRUE about anything.
    ce=0
    for ef in "$ROOT/claims/$n/evidence/$who".*.txt; do
      [ -s "$ef" ] || continue
      [ "$(head -1 "$ef")" = "$MARK" ] || continue
      ce=$((ce+1))
    done
    [ "$ce" -gt 0 ] \
      || die "refused: $who recorded no usable evidence for $n — run: crucible run-claim $n $who -- <command>"
    # Guided cycles: every claim verdict (TRUE/FALSE/STALE/UNVERIFIABLE) requires a
    # claim-auditor or scout dispatch and a sealed independence-ledger attempt.
    if uses_guided_cycle; then
      require_panel_approval
      cdir="$ROOT/claims/$n/dispatches"
      found=0
      claim_attempt=
      if [ -d "$cdir" ]; then
        for df in "$cdir"/*-claim-auditor-"$who".md "$cdir"/*-scout-"$who".md; do
          [ -f "$df" ] || continue
          found=1
          stamped=$(sed -n 's/^attempt-id: //p' "$df" | head -1)
          if [ -n "$stamped" ] && claim_attempt_matches "$stamped" "$n" "$who" \
            && claim_attempt_is_sealed "$stamped"; then
            claim_attempt=$stamped
          fi
        done
      fi
      [ "$found" -eq 1 ] \
        || die "refused: guided claim verdict requires a claim dispatch for $who — run: $(self_path) dispatch $n claim-auditor $who"
      if [ -z "$claim_attempt" ] && [ -d "$ROOT/attempts" ]; then
        for ad in "$ROOT"/attempts/A*; do
          [ -d "$ad" ] || continue
          aid=${ad##*/}
          claim_attempt_matches "$aid" "$n" "$who" || continue
          claim_attempt_is_sealed "$aid" || continue
          claim_attempt=$aid
        done
      fi
      [ -n "$claim_attempt" ] \
        || die "refused: guided claim verdict requires a matching claim attempt (item+agent+role) on the independence ledger for $who"
      require_attempt_independence "$claim_attempt"
      # Terminalize the claim attempt so session cleanup is not blocked by DISPATCHED seals.
      case $(attempt_state "$claim_attempt") in
        DISPATCHED) attempt_event "$claim_attempt" SUPERSEDED - "claim-verdict-$word" ;;
      esac
    fi
    likes=
    cite=
    shift 3
    while [ $# -gt 0 ]; do
      case $1 in
        --like) shift; likes=$*; break ;;
        *) cite=$1; shift ;;
      esac
    done
    if [ -z "$cite" ]; then
      last=
      for ef in "$ROOT/claims/$n/evidence/$who".*.txt; do
        [ -s "$ef" ] || continue
        last=$ef
      done
      cite=${last#"$ROOT/"}
    fi
    [ -n "$cite" ] || die 'refused: claim verdict requires a citation (evidence path or quote)'
    if [ -s "$d/$who.md" ]; then
      mkdir -p "$d/history"
      ts=$(date +%s)
      mv "$d/$who.md" "$d/history/$who.$ts.md"
    fi
    {
      printf 'CLAIM-VERDICT: %s\nAGENT: %s\nKIND: %s\nCITATION: %s\n' \
        "$word" "$who" "$(kind_of "$who")" "$cite"
    } > "$d/$who.md"
    case $word in
      STALE) claims_set_status "$n" STALE ;;
      FALSE|UNVERIFIABLE) claims_set_status "$n" AUDITED_FALSE ;;
    esac
    if [ -n "$likes" ]; then
      for like_cn in $likes; do
        claim_copy_verdict_like "$n" "$like_cn" "$who" \
          || die "refused: cannot copy $word onto $like_cn from $n"
      done
    fi
    printf '%s\n' "$d/$who.md" ;;
  scout)
    n=${1:-}; res=${2:-}; who=${3:-}
    [ -n "$n" ] && [ -n "$res" ] || die 'usage: crucible claim scout CN ABSENT|PARTLY-EXISTS|FULLY-EXISTS|IN-FLIGHT AGENT'
    case $res in ABSENT|PARTLY-EXISTS|FULLY-EXISTS|IN-FLIGHT) : ;; *) die "scout result must be ABSENT, PARTLY-EXISTS, FULLY-EXISTS, or IN-FLIGHT" ;; esac
    grep -q "^### $n " "$f" || die "no such claim: $n"
    [ -n "$who" ] || die 'usage: crucible claim scout CN RESULT AGENT — name the scout that searched'
    [ -n "$(kind_of "$who")" ] || die "unregistered agent: $who"
    # ABSENT is a claim in its own right, so it needs the searches behind it recorded.
    se=0
    for ef in "$ROOT/claims/$n/evidence/$who".*.txt; do
      [ -s "$ef" ] && [ "$(head -1 "$ef")" = "$MARK" ] && se=$((se+1))
    done
    [ "$se" -gt 0 ] \
      || die "refused: $who recorded no usable searches for $n — run: crucible run-claim $n $who -- <search>"
    if [ "$res" = ABSENT ] && [ -f "$ROOT/PROGRAM" ]; then
      r=$(sed -n 's/^repo: //p' "$ROOT/PROGRAM")
      b=$(sed -n 's/^base: //p' "$ROOT/PROGRAM"); b=${b:-main}
      if [ -n "$r" ] && [ -d "$r/.git" ] || [ -f "$r/.git" ]; then
        inflight_br=
        for br in $(git -C "$r" branch --list 'ai/*' 2>/dev/null | sed 's/^[* ]*//'); do
          [ -n "$br" ] || continue
          ahead=$(git -C "$r" rev-list --count "${b}..${br}" 2>/dev/null || echo 0)
          [ "${ahead:-0}" -gt 0 ] || continue
          inflight_br=$br
          break
        done
        [ -z "$inflight_br" ] \
          || die "refused: unmerged branch $inflight_br implements work — record IN-FLIGHT, not ABSENT"
      fi
    fi
    if uses_guided_cycle; then
      require_panel_approval
      cdir="$ROOT/claims/$n/dispatches"
      found=0
      claim_attempt=
      if [ -d "$cdir" ]; then
        for df in "$cdir"/*-scout-"$who".md; do
          [ -f "$df" ] || continue
          found=1
          stamped=$(sed -n 's/^attempt-id: //p' "$df" | head -1)
          if [ -n "$stamped" ] && claim_attempt_matches "$stamped" "$n" "$who" scout \
            && claim_attempt_is_sealed "$stamped"; then
            claim_attempt=$stamped
          fi
        done
      fi
      [ "$found" -eq 1 ] \
        || die "refused: guided scout requires a scout dispatch for $who — run: $(self_path) dispatch $n scout $who"
      if [ -z "$claim_attempt" ] && [ -d "$ROOT/attempts" ]; then
        for ad in "$ROOT"/attempts/A*; do
          [ -d "$ad" ] || continue
          aid=${ad##*/}
          claim_attempt_matches "$aid" "$n" "$who" scout || continue
          claim_attempt_is_sealed "$aid" || continue
          claim_attempt=$aid
        done
      fi
      [ -n "$claim_attempt" ] \
        || die "refused: guided scout requires a matching scout attempt (item+agent+role) on the independence ledger for $who"
      require_attempt_independence "$claim_attempt"
      case $(attempt_state "$claim_attempt") in
        DISPATCHED) attempt_event "$claim_attempt" SUPERSEDED - "claim-scout-$res" ;;
      esac
    fi
    awk -v c="### $n " -v r="$res" '
      $0 ~ "^"c {inc=1} inc && /^    scout:/ {print "    scout: " r; inc=0; next}
      /^### C/ && $0 !~ "^"c {inc=0} {print}' "$f" > "$ROOT/c.$$.tmp" && mv "$ROOT/c.$$.tmp" "$f"
    printf '%s scout: %s (by %s)\n' "$n" "$res" "$who" ;;
  admit)
    n=${1:-}; slug=${2:-}
    [ -n "$n" ] && [ -n "$slug" ] || die 'usage: crucible claim admit CN SLUG'
    d="$ROOT/claims/$n/verdicts"; [ -d "$d" ] || die "no such claim: $n"
    t=0; kinds=""
    for v in "$d"/*.md; do
      [ -f "$v" ] || continue
      # only a registered agent's verdict counts; a hand-dropped file with any name does not
      vn=${v##*/}; vn=${vn%.md}
      [ -n "$(kind_of "$vn")" ] || { printf 'ignoring unregistered verdict file: %s\n' "$vn" >&2; continue; }
      ae=0
      for ef in "$ROOT/claims/$n/evidence/$vn".*.txt; do
        [ -s "$ef" ] && [ "$(head -1 "$ef")" = "$MARK" ] && ae=$((ae+1))
      done
      [ "$ae" -gt 0 ] || {
        printf 'ignoring %s: no usable evidence for %s\n' "$vn" "$n" >&2; continue; }
      [ "$(sed -n '1p' "$v")" = "CLAIM-VERDICT: TRUE" ] || continue
      # The kind comes from agents.tsv, not from the verdict file. Reading it from the file let a
      # writable KIND: line turn one agent into two kinds and satisfy a cross-model requirement.
      k=$(kind_of "$vn")
      case " $kinds " in *" $k "*) : ;; *) kinds="$kinds $k" ;; esac
      t=$((t+1))
      # Consume-time independence: TRUE verdicts must still resolve to a sealed matching attempt
      # even if someone toggled cycle: guided off while writing the verdict file.
      if uses_guided_cycle; then
        ca=
        cdir="$ROOT/claims/$n/dispatches"
        if [ -d "$cdir" ]; then
          for df in "$cdir"/*-claim-auditor-"$vn".md "$cdir"/*-scout-"$vn".md; do
            [ -f "$df" ] || continue
            stamped=$(sed -n 's/^attempt-id: //p' "$df" | head -1)
            if [ -n "$stamped" ] && claim_attempt_matches "$stamped" "$n" "$vn"; then
              ca=$stamped; break
            fi
          done
        fi
        if [ -z "$ca" ] && [ -d "$ROOT/attempts" ]; then
          for ad in "$ROOT"/attempts/A*; do
            [ -d "$ad" ] || continue
            aid=${ad##*/}
            claim_attempt_matches "$aid" "$n" "$vn" || continue
            ca=$aid
          done
        fi
        [ -n "$ca" ] \
          || die "refused: admit requires a sealed claim attempt for TRUE auditor $vn"
        require_attempt_independence "$ca"
      fi
    done
    [ "$t" -ge "$(guided_min_auditors)" ] || die "refused: $n has $t TRUE verdicts, need $(guided_min_auditors)"
    kn=0; for k in $kinds; do kn=$((kn+1)); done
    [ "$kn" -ge "$MIN_KINDS" ] || die "refused: $n audited by $kn kind(s), need $MIN_KINDS"
    # A scout that found the work already implemented blocks admission. LOOP.md said this and
    # the code did not check it, so a claim the scout had closed could still become work —
    # exactly the "proposing to build machinery that already exists" failure the role exists for.
    sc=$(sed -n "/^### $n /,/^### C[0-9]/{s/^    scout: //p;}" "$(claims_file)" | head -1)
    pol=$(claims_field "$n" polarity)
    [ -n "$pol" ] || pol=ABSENT
    case $sc in
      FULLY-EXISTS) die "refused: the scout found $n already implemented. Drop it, or record a narrowed claim for the gap." ;;
      IN-FLIGHT) die "refused: $n is IN-FLIGHT on an unmerged branch — merge or drop, do not admit" ;;
      ABSENT|PARTLY-EXISTS) : ;;
      *) die "refused: $n has no scout report. Dispatch a scout, then: crucible claim scout $n ABSENT|PARTLY-EXISTS|FULLY-EXISTS|IN-FLIGHT AGENT" ;;
    esac
    case $pol in
      EXISTS) die "refused: polarity EXISTS is not a gap — drop it or record ABSENT/DEFECT" ;;
      ABSENT)
        [ "$sc" = ABSENT ] \
          || die "refused: polarity ABSENT requires scout ABSENT (got $sc)"
        ;;
      DEFECT)
        case $sc in
          PARTLY-EXISTS|ABSENT) : ;;
          *) die "refused: polarity DEFECT requires scout PARTLY-EXISTS or ABSENT (got $sc)" ;;
        esac
        ;;
    esac
    if uses_managed_lifecycle; then
      if uses_guided_cycle; then
        require_panel_approval
      fi
      approval_current || die 'refused: the current PROPOSAL.md is not operator-approved'
    fi
    if [ -d "$(D "$slug")" ]; then
      if uses_managed_lifecycle; then
        current=$(awk -F '\t' 'NR > 1 && $2 == "ACTIVE" { print $1; exit }' "$ROOT/STATE.tsv")
        [ "$current" = "$slug" ] \
          || die "refused: item $slug exists but is not the current ACTIVE item"
      fi
    else
      cmd_add "$slug" "$(sed -n "/^### $n /s/^### $n — //p" "$(claims_file)" | head -1)"
    fi
    awk -v c="### $n " -v s="$slug" '
      $0 ~ "^"c {inc=1} inc && /^    item:/ {print "    item: " s; inc=0; next}
      /^### C/ && $0 !~ "^"c {inc=0} {print}' "$(claims_file)" > "$ROOT/c.$$.tmp" \
      && mv "$ROOT/c.$$.tmp" "$(claims_file)"
    if [ -f "$ROOT/PROGRAM" ]; then
      r=$(sed -n 's/^repo: //p' "$ROOT/PROGRAM"); b=$(sed -n 's/^base: //p' "$ROOT/PROGRAM")
      [ -n "$r" ] && cmd_target "$slug" "$r" "ai/$slug" "${b:-main}" >/dev/null 2>&1 || true
    fi
    claims_set_status "$n" ADMITTED
    printf 'admitted %s as item %s\n' "$n" "$slug" ;;
  *) die "usage: crucible claim add|list|verdict|admit|scout ..." ;;
  esac
}

# Overlay the live views onto the tmux session you are already in. This creates no
# session and replaces no session manager: whatever made the window keeps owning it,
# and this only decides what the non-active panes show. Run it when the views become
# useful — after adopt, before you dispatch anything.
cmd_panes() {
  [ -n "${TMUX:-}" ] || die "not inside tmux — start a session first (e.g. your session manager, then re-run)"
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed"
  w="$ROOT/scripts/watch.sh"
  [ -f "$w" ] || die "no watch.sh at $w"
  views=${*:-}
  [ -n "$views" ] || views="gate verdicts workids tail"
  for v in $views; do
    case $v in gate|verdicts|evidence|tail|git|workids|memory) : ;;
      *) die "unknown view: $v (gate verdicts evidence tail git workids memory)" ;; esac
  done
  keep=$(tmux display-message -p '#{pane_id}')
  tmux set-option -w pane-border-status top 2>/dev/null || true
  tmux select-pane -t "$keep" -T "agent" 2>/dev/null || true
  # panes already in this window, excluding the one you are working in
  avail=$(tmux list-panes -F '#{pane_id}' | grep -v "^$keep$" || true)
  n=0
  for v in $views; do
    n=$((n+1))
    target=$(printf '%s\n' $avail | sed -n "${n}p")
    if [ -z "$target" ]; then
      target=$(tmux split-window -h -d -P -F '#{pane_id}' -t "$keep" -c "$PWD")
      avail="$avail
$target"
    fi
    tmux respawn-pane -k -t "$target" "sh '$w' $v 5" 2>/dev/null \
      || tmux send-keys -t "$target" C-c "exec sh '$w' $v 5" C-m
    tmux select-pane -t "$target" -T "$v" 2>/dev/null || true
  done
  tmux select-layout -t "$keep" main-vertical 2>/dev/null || true
  tmux select-pane -t "$keep"
  printf 'overlaid %s view(s) onto this window: %s\n' "$n" "$views"
  printf 'your pane is titled "agent" and was left alone. re-run any time to reset them.\n'
}

# The evidence-grounded decision table taken to the operator before any planning.
# It refuses to recommend a disposition for a claim nobody audited, so the
# conversation starts from verdicts rather than from impressions.
cmd_triage() {
  f=$(claims_file); [ -f "$f" ] || die "no CLAIMS.md — run: <engine>/crucible adopt <program>"
  n=$(grep -c '^### C' "$f" 2>/dev/null || true); n=${n:-0}
  [ "$n" -gt 0 ] || die "no claims yet — crucible claim add \"<claim>\" \"<source sentence>\""
  unaudited=0
  printf 'TRIAGE — %s claim(s). Recommendations are derived from verdicts, not from opinion.\n\n' "$n"
  i=1
  while [ "$i" -le "$n" ]; do
    title=$(sed -n "/^### C$i /s/^### C$i — //p" "$f" | head -1)
    vd="$ROOT/claims/C$i/verdicts"
    t=0; fa=0; st=0; uv=0; kinds=""; who=""
    if [ -d "$vd" ]; then
      for v in "$vd"/*.md; do
        [ -f "$v" ] || continue
        w=$(sed -n 's/^CLAIM-VERDICT: //p' "$v" | head -1)
        a=$(sed -n 's/^AGENT: //p' "$v" | head -1)
        k=$(sed -n 's/^KIND: //p' "$v" | head -1)
        who="$who $a:$w"
        case " $kinds " in *" $k "*) : ;; *) kinds="$kinds $k" ;; esac
        case $w in TRUE) t=$((t+1)) ;; FALSE) fa=$((fa+1)) ;; STALE) st=$((st+1)) ;; UNVERIFIABLE) uv=$((uv+1)) ;; esac
      done
    fi
    kn=0; for k in $kinds; do kn=$((kn+1)); done
    scout=$(sed -n "/^### C$i /,/^### C/{s/^    scout: //p;}" "$f" | head -1)
    item=$(sed -n "/^### C$i /,/^### C/{s/^    item: //p;}" "$f" | head -1)
    total=$((t+fa+st+uv))
    if [ "$total" -eq 0 ]; then
      rec="NO RECOMMENDATION — unaudited. Dispatch claim-auditors before deciding this."
      unaudited=$((unaudited+1))
    elif [ -n "$item" ]; then rec="ADMITTED as item $item"
    elif [ "$fa" -gt 0 ] && [ "$t" -eq 0 ]; then rec="DROP — auditors found it untrue. This is work you do not have to do."
    elif [ "$st" -gt 0 ] && [ "$t" -eq 0 ]; then rec="DROP — already fixed. Record the change that fixed it."
    elif [ "$uv" -gt 0 ] && [ "$t" -eq 0 ]; then rec="ASK THE OPERATOR — unverifiable from the code. Do not resolve this yourself."
    elif [ "$t" -gt 0 ] && [ "$fa" -gt 0 ]; then rec="AUDITORS DISAGREE — $t TRUE, $fa FALSE. Dispatch a third of a different kind."
    else
      case $scout in
        FULLY-EXISTS) rec="DROP — the scout found this already implemented. Cite where." ;;
        PARTLY-EXISTS) rec="ADMIT, NARROWED — only the gap the scout could not find." ;;
        '') rec="SCOUT FIRST — audited TRUE but nobody checked whether it already exists." ;;
        *) if [ "$t" -ge "${CRUCIBLE_MIN_AUDITORS:-2}" ] && [ "$kn" -ge "$MIN_KINDS" ]; then
             rec="ADMIT — audited TRUE by $t agent(s) across $kn kind(s), and absent from the repo."
           else
             rec="MORE AUDIT — $t TRUE across $kn kind(s); need ${CRUCIBLE_MIN_AUDITORS:-2} across $MIN_KINDS."
           fi ;;
      esac
    fi
    printf 'C%s  %s\n' "$i" "${title:-(untitled)}"
    printf '     verdicts:%s   kinds: %s   scout: %s\n' "${who:- none}" "${kn}" "${scout:-not run}"
    printf '     -> %s\n\n' "$rec"
    i=$((i+1))
  done
  printf 'Take this to the operator. Say what the evidence says, say what you would do, and let\n'
  printf 'them decide. Propose merges for overlapping claims and splits for oversized ones —\n'
  printf 'neither is visible from verdicts alone, so that part is your judgement and theirs.\n'
  printf 'Report anything you found that the document never mentioned; do not silently add it.\n'
  if [ "$unaudited" -gt 0 ]; then
    printf '\nREFUSED: %s claim(s) have no verdicts, so no disposition was recommended for them.\n' "$unaudited"
    return 1
  fi
}

# THE GATE. Every branch is a refusal, never a warning.
cmd_check() {
  need "${1:-}"; slug=$1; d=$(D "$slug"); wid=$(workid "$slug"); bad=0
  say() { printf '  %s\n' "$*"; }
  printf 'check %s (work id %s)\n' "$slug" "$wid"

  scan="$d/evidence $d/verdicts"; [ -f "$d/TARGET" ] || scan="$d/work $scan"
  for dir in $scan; do
    f=$(faults "$dir"); [ -z "$f" ] || { printf '%s\n' "$f" | while IFS= read -r l; do say "FAIL $l"; done; bad=1; }
  done
  [ "$wid" = EMPTY ]    && { say "FAIL no work in $d/work/"; bad=1; }
  [ "$wid" = NOBRANCH ] && { say "FAIL branch $(tgt "$slug" branch) does not exist in $(tgt "$slug" repo)"; bad=1; }
  if uses_managed_lifecycle; then
    validate_managed_item "$slug"
    [ "$(phase_of "$slug")" = REVIEW ] || { say "FAIL managed item must be in REVIEW"; bad=1; }
  elif grep -q 'TEMPLATE-FALSIFIER-UNWRITTEN' "$d/ITEM.md" 2>/dev/null; then
    say "FAIL falsifier not written in ITEM.md"; bad=1
  else
    # Absence of the template marker is not presence of a falsifier. Deleting the whole
    # section used to pass, which made the strongest closure requirement optional.
    fbody=$(awk '/^## Falsifier/{f=1;next} f&&/^## /{exit} f{print}' "$d/ITEM.md" 2>/dev/null \
              | tr -d '[:space:]')
    if ! grep -q '^## Falsifier' "$d/ITEM.md" 2>/dev/null; then
      say "FAIL ITEM.md has no ## Falsifier section"; bad=1
    elif [ "${#fbody}" -lt 40 ]; then
      say "FAIL the falsifier is empty or too short to name a change and a check"; bad=1
    fi
  fi

  # Self-review is only refused if a maker was recorded, so an unrecorded maker made the
  # check vacuous — and that was the common case.
  if { [ ! -f "$d/MAKER" ] || [ ! -s "$d/MAKER" ]; } \
    && { [ ! -f "$d/MAKERS.tsv" ] || [ "$(awk 'END { print NR }' "$d/MAKERS.tsv")" -lt 2 ]; }; then
    say "FAIL no maker recorded — run: crucible brief $slug maker NAME (or dispatch a maker)"; bad=1
  fi

  # The phase's prerequisite must exist even if PHASE was written by hand rather
  # than through `crucible phase`. A hand-edited phase is still a phase.
  if ! uses_managed_lifecycle; then
    case $(phase_of "$slug") in
      TASKS)     [ -f "$d/DESIGN.md" ]    || { say "FAIL phase TASKS requires DESIGN.md"; bad=1; } ;;
      BUILD|VERIFY) for r in DESIGN.md TASKS.md; do
                     [ -f "$d/$r" ] || { say "FAIL phase $(phase_of "$slug") requires $r"; bad=1; }
                   done ;;
      ADVERSARY) for r in DESIGN.md TASKS.md; do
                     [ -f "$d/$r" ] || { say "FAIL phase ADVERSARY requires $r"; bad=1; }
                   done ;;
      GRADUATE)  for r in DESIGN.md TASKS.md ADVERSARY.md; do
                     [ -f "$d/$r" ] || { say "FAIL phase GRADUATE requires $r"; bad=1; }
                   done ;;
    esac
  fi

  ok_agents=""; en=0
  if [ -z "$(find "$d/evidence" -type f 2>/dev/null | head -1)" ]; then
    say "FAIL no evidence — use: crucible run $slug NAME -- CMD"; bad=1
  else
    for f in "$d/evidence"/*; do
      [ -f "$f" ] || continue
      b=${f##*/}
      case $b in .partial.*) continue ;; esac   # a run still in flight is not evidence
      stem=${b%.txt}
      case $b in *.txt) : ;; *) say "FAIL evidence $b must end in .txt"; bad=1; continue ;; esac
      id=${stem##*.}; rest=${stem%.*}; seq=${rest##*.}; an=${rest%.*}
      if uses_managed_lifecycle; then
        evidence_attempt=$(sed -n 's/^attempt-id: //p' "$f" | head -1)
        if [ -n "$evidence_attempt" ] && [ -f "$ROOT/attempts/$evidence_attempt/meta.tsv" ]; then
          evidence_task=$(awk -F '\t' 'NR == 2 { print $3 }' "$ROOT/attempts/$evidence_attempt/meta.tsv")
          [ "$evidence_task" = - ] || continue
        fi
      fi
      if [ "$id" != "$wid" ]; then say "FAIL stale evidence $b (not from $wid)"; bad=1; continue; fi
      case $an in *.*|'') say "FAIL evidence $b: name must be AGENT.TOKEN.WORKID.txt"; bad=1; continue ;; esac
      case $seq in ''|*[!A-Za-z0-9]*) say "FAIL evidence $b: name must be AGENT.TOKEN.WORKID.txt"; bad=1; continue ;; esac
      [ -n "$(kind_of "$an")" ] || { say "FAIL evidence $b: '$an' is not a registered agent"; bad=1; continue; }
      [ -s "$f" ] || { say "FAIL empty evidence $b"; bad=1; continue; }
      [ "$(head -1 "$f")" = "$MARK" ] ||
        { say "FAIL evidence $b was not produced by 'crucible run'"; bad=1; continue; }
      iw=$(sed -n 's/^work-id: //p' "$f" | head -1)
      [ "$iw" = "$wid" ] ||
        { say "FAIL evidence $b says work-id $iw inside — renamed, not re-run"; bad=1; continue; }
      ia=$(sed -n 's/^agent: //p' "$f" | head -1)
      [ "$ia" = "$an" ] ||
        { say "FAIL evidence $b says agent $ia inside — renamed"; bad=1; continue; }
      grep -q '^--- exit ' "$f" || { say "FAIL evidence $b has no exit line (truncated)"; bad=1; continue; }
      case " $ok_agents " in *" $an "*) : ;; *) ok_agents="$ok_agents $an" ;; esac
      en=$((en+1))
    done
    [ "$en" -gt 0 ] || { say "FAIL no usable evidence for $wid"; bad=1; }
  fi

  vn=0; kinds=""; bodies=""
  for v in "$d/verdicts"/*; do
    [ -e "$v" ] || continue
    nm=${v##*/}
    # the archive of superseded verdicts is a record, not a live verdict
    [ "$nm" = history ] && continue
    case $nm in *.md) nm=${nm%.md} ;; *) say "FAIL $nm: only NAME.md belongs in verdicts/"; bad=1; continue ;; esac
    [ -L "$v" ] && { say "FAIL $nm is a symlink"; bad=1; continue; }
    [ -f "$v" ] || { say "FAIL $nm is not a regular file"; bad=1; continue; }
    k=$(kind_of "$nm")
    [ -n "$k" ] || { say "FAIL $nm is not registered in agents.tsv, so it is not a judge"; bad=1; continue; }
    if is_maker "$slug" "$nm"; then
      say "FAIL $nm is a maker and may not judge its own work"; bad=1; continue
    fi
    [ -s "$v" ] || { say "FAIL empty verdict $nm.md"; bad=1; continue; }
    l1=$(sed -n '1p' "$v"); l2=$(sed -n '2p' "$v")
    case $l1 in "VERDICT: PASS") : ;;
      "VERDICT: REJECT"|"VERDICT: INSUFFICIENT_EVIDENCE"|"VERDICT: SCOPE_CONFLICT")
        say "FAIL $nm returned ${l1#VERDICT: }"; bad=1; continue ;;
      *) say "FAIL $nm: line 1 must be exactly 'VERDICT: <WORD>'"; bad=1; continue ;; esac
    vwid=""; case $l2 in "WORK-ID: "*) vwid=${l2#"WORK-ID: "} ;; esac
    case $vwid in ''|*[!A-Za-z0-9]*) say "FAIL $nm: line 2 must be exactly 'WORK-ID: <id>'"; bad=1; continue ;; esac
    [ "$vwid" = "$wid" ] || { say "FAIL $nm judged $vwid but work is $wid (stale)"; bad=1; continue; }
    if uses_managed_lifecycle; then
      l3=$(sed -n '3p' "$v")
      case $l3 in "result A"*"; see "*) : ;;
        *) say "FAIL $nm: managed verdict is not bound to an attempt result"; bad=1; continue ;;
      esac
      result_id=${l3#result }; result_id=${result_id%%; see *}; result_evidence=${l3#*; see }
      case $result_id in ''|*[!A0-9.]*)
        say "FAIL $nm: managed verdict has an invalid attempt id"; bad=1; continue ;;
      esac
      result_file="$ROOT/attempts/$result_id/result.md"
      [ -f "$result_file" ] && [ ! -L "$result_file" ] || {
        say "FAIL $nm: managed attempt result $result_id is missing"; bad=1; continue; }
      [ "$(sed -n 's/^OUTCOME: //p' "$result_file" | head -1)" = PASS ] \
        && [ "$(sed -n 's/^ITEM: //p' "$result_file" | head -1)" = "$slug" ] \
        && [ "$(sed -n 's/^WORK-ID: //p' "$result_file" | head -1)" = "$wid" ] \
        && [ "$(sed -n 's/^ATTEMPT-ID: //p' "$result_file" | head -1)" = "$result_id" ] \
        && [ "$(sed -n 's/^ROLE: //p' "$result_file" | head -1)" = judge ] \
        && [ "$(sed -n 's/^AGENT: //p' "$result_file" | head -1)" = "$nm" ] \
        && [ "$(sed -n 's/^EVIDENCE: //p' "$result_file" | head -1)" = "$result_evidence" ] \
        || { say "FAIL $nm: verdict and managed attempt result disagree"; bad=1; continue; }
      # Consume-time independence: results written with guided toggled off still fail check.
      if uses_guided_cycle; then
        if ! (require_attempt_independence "$result_id") 2>/dev/null; then
          say "FAIL $nm: attempt $result_id lacks independence seal under current panel"; bad=1; continue
        fi
      fi
    fi
    case " $ok_agents " in *" $nm "*) : ;;
      *) say "FAIL $nm passed but recorded no evidence of its own"; bad=1; continue ;; esac
    cited=0
    for e in "$d/evidence/$nm".*."$wid".txt; do
      [ -f "$e" ] || continue
      grep -qF "${e##*/}" "$v" && cited=1
    done
    [ "$cited" -eq 1 ] || {
      say "FAIL $nm passed without naming any evidence file it recorded"; bad=1; continue; }
    body=$(tail -n +3 "$v" | h12)
    case " $bodies " in *" $body "*) say "FAIL $nm is byte-identical to another verdict"; bad=1; continue ;; esac
    bodies="$bodies $body"
    case " $kinds " in *" $k "*) : ;; *) kinds="$kinds $k" ;; esac
    vn=$((vn+1)); say "ok   $nm PASS on $wid (kind $k, recorded its own evidence)"
  done
  need_j=$(guided_min_judges)
  [ "$vn" -lt "$need_j" ] && { say "FAIL $vn passing judges, need $need_j"; bad=1; }
  kn=0; for k in $kinds; do kn=$((kn+1)); done
  [ "$kn" -lt "$MIN_KINDS" ] && { say "FAIL $kn distinct kinds, need $MIN_KINDS"; bad=1; }

  [ "$bad" -eq 0 ] || { printf 'NOT CLOSEABLE\n'; return 1; }
  printf 'CLOSEABLE %s\n' "$wid"; return 0
}

cmd_evidence() {
  sub=${1:-}; slug=${2:-}
  [ "$sub" = archive ] && [ -n "$slug" ] || die 'usage: crucible evidence archive SLUG'
  need "$slug"
  d=$(D "$slug"); wid=$(workid "$slug")
  [ -d "$d/evidence" ] || die "no evidence directory: $slug"
  mkdir -p "$d/evidence/history"
  moved=0
  for f in "$d/evidence"/*; do
    [ -f "$f" ] || continue
    b=${f##*/}
    case $b in .partial.*) continue ;; esac
    stem=${b%.txt}
    case $b in *.txt) : ;; *) continue ;; esac
    id=${stem##*.}
    if [ "$id" != "$wid" ]; then
      mv "$f" "$d/evidence/history/"
      printf 'archived %s (work-id %s, current %s)\n' "$b" "$id" "$wid"
      moved=$((moved + 1))
    fi
  done
  [ "$moved" -gt 0 ] || printf 'no stale evidence to archive for %s (work id %s)\n' "$slug" "$wid"
}

cmd_close() {
  need "${1:-}"; slug=$1; shift
  successor=
  lesson=
  while [ $# -gt 0 ]; do
    case $1 in
      --successor)
        shift
        successor=${1:-}
        [ -n "$successor" ] || die 'usage: crucible close SLUG "lesson" [--successor SHA]'
        ;;
      *)
        if [ -z "$lesson" ]; then
          lesson=$1
        else
          lesson="$lesson $1"
        fi
        ;;
    esac
    shift
  done
  d=$(D "$slug")
  [ -n "$lesson" ] || die 'usage: crucible close SLUG "one-line lesson, or NONE" [--successor SHA]'
  [ "$(printf '%s' "$lesson" | wc -l | tr -d ' ')" = 0 ] || die "lesson must be one line"
  if uses_managed_lifecycle; then
    state_validate_file "$ROOT/STATE.tsv"
    [ "$(state_value "$slug" 2)" != CLOSED ] || die "$slug is already closed"
  else
    grep -q '^STATUS: CLOSED' "$d/ITEM.md" 2>/dev/null && die "$slug is already closed"
  fi
  # mkdir is atomic and fails if the directory exists, so exactly one caller claims a
  # close. Reading STATUS and then writing it is check-then-act: two callers both read
  # OPEN, both append a lesson, and both write the status.
  mkdir "$d/.closing" 2>/dev/null || die "a close of $slug is already in progress or finished"
  before=$(workid "$slug")
  cmd_check "$slug" || { rmdir "$d/.closing" 2>/dev/null; die "refused: $slug is not closeable"; }
  after=$(workid "$slug")
  [ "$before" = "$after" ] || { rmdir "$d/.closing" 2>/dev/null
    die "refused: work changed during check ($before -> $after)"; }
  if [ -f "$d/TARGET" ]; then
    r=$(tgt "$slug" repo); b=$(tgt "$slug" branch)
    head=$(git -C "$r" rev-parse --verify --quiet "$b" 2>/dev/null | cut -c1-12)
    if [ -n "$head" ] && [ "$after" != "$head" ]; then
      succ12=$(printf '%s' "$successor" | cut -c1-12)
      if [ -n "$successor" ] && [ "$succ12" = "$head" ]; then
        :
      else
        rmdir "$d/.closing" 2>/dev/null
        die "refused: close work-id $after is not $b HEAD $head (new attempt or --successor SHA)"
      fi
    fi
  fi
  last_pass=
  if [ -d "$d/verdicts" ]; then
    for vf in "$d/verdicts"/*.md; do
      [ -f "$vf" ] || continue
      [ "$(sed -n 's/^VERDICT: //p' "$vf" | head -1)" = PASS ] || continue
      last_pass=$(sed -n 's/^WORK-ID: //p' "$vf" | head -1)
    done
  fi
  if [ -n "$last_pass" ] && [ "$after" != "$last_pass" ]; then
    succ12=$(printf '%s' "$successor" | cut -c1-12)
    if [ -n "$successor" ] && { [ "$succ12" = "$after" ] || [ "$succ12" = "$last_pass" ]; }; then
      :
    else
      rmdir "$d/.closing" 2>/dev/null
      die "refused: close work-id $after is not last PASS $last_pass (record a successor review or --successor SHA)"
    fi
  fi
  if stale=$(item_stale_evidence_files "$slug" "$after"); then
    rmdir "$d/.closing" 2>/dev/null
    die "refused: stale evidence still in items/$slug/evidence (run: evidence archive $slug): $stale"
  fi
  reject_fp=
  for rf in "$ROOT"/attempts/*/result.md; do
    [ -f "$rf" ] || continue
    [ "$(sed -n 's/^ITEM: //p' "$rf" | head -1)" = "$slug" ] || continue
    [ "$(sed -n 's/^OUTCOME: //p' "$rf" | head -1)" = REJECT ] || continue
    fp=$(sed -n 's/^FINDING-FINGERPRINT: //p' "$rf" | head -1)
    [ -n "$fp" ] && [ "$fp" != - ] && reject_fp=$fp
  done
  if [ -n "$reject_fp" ] && [ "$lesson" = NONE ]; then
    rmdir "$d/.closing" 2>/dev/null
    die "refused: LESSONS.md cannot stay NONE when REJECT fingerprint $reject_fp exists"
  fi
  printf -- '- [%s] %s (item %s, work %s)\n' "$(date +%Y-%m-%d)" "$lesson" "$slug" "$after" >> "$ROOT/LESSONS.md"
  if uses_managed_lifecycle; then
    risk=$(state_value "$slug" 5)
    state_update_item "$slug" CLOSED REVIEW "$after" "$risk" - -
  else
    sed "s|^STATUS: OPEN.*|STATUS: CLOSED $after|" "$d/ITEM.md" > "$d/ITEM.$$.tmp" && mv "$d/ITEM.$$.tmp" "$d/ITEM.md"
  fi
  if [ -f "$(claims_file)" ]; then
    tot=$(grep -c '^### C' "$(claims_file)" 2>/dev/null || true)
    i=1
    while [ "$i" -le "${tot:-0}" ]; do
      it=$(claims_field "C$i" item)
      [ "$it" = "$slug" ] && claims_set_status "C$i" CLOSED
      i=$((i + 1))
    done
  fi
  printf 'closed %s at %s\n' "$slug" "$after"
}

case ${1:-help} in
adopt)    shift; cmd_adopt "$@" ;;
cycle)    shift; cmd_cycle "$@" ;;
drive)    shift; cmd_drive "$@" ;;
plan-audit) shift; cmd_plan_audit "$@" ;;
claim)    shift; cmd_claim "$@" ;;
triage)   shift; cmd_triage "$@" ;;
panes)    shift; cmd_panes "$@" ;;
add)      shift; cmd_add "$@" ;;
selftest) shift
          [ -z "${CRUCIBLE_IN_SELFTEST:-}" ] || die "already inside a selftest — refusing to recurse"
          CRUCIBLE_IN_SELFTEST=1; export CRUCIBLE_IN_SELFTEST
          exec "$ROOT/scripts/selftest.sh" "$@" ;;
agents)   shift; cmd_agents "$@" ;;
target)   shift; cmd_target "$@" ;;
lifecycle) shift; cmd_lifecycle "$@" ;;
state)    shift; cmd_state "$@" ;;
ready)    shift; cmd_ready "$@" ;;
task)     shift; cmd_task "$@" ;;
next)     shift; cmd_next "$@" ;;
attempt)  shift; cmd_attempt "$@" ;;
contract-audit) shift; cmd_contract_audit "$@" ;;
probe-acp) shift; cmd_probe_acp "$@" ;;
result)   shift; cmd_result "$@" ;;
phase)    shift; cmd_phase "$@" ;;
dispatch) shift; cmd_dispatch "$@" ;;
brief)    shift; cmd_brief "$@" ;;
run)      shift; cmd_run "$@" ;;
run-claim) shift; cmd_run_claim "$@" ;;
check)    shift; cmd_check "$@" ;;
close)    shift; cmd_close "$@" ;;
evidence) shift; cmd_evidence "$@" ;;
workid)   shift; need "${1:-}"; workid "$1"; echo ;;
help)     shift; if [ "${1:-}" = protocol ]; then protocol_usage; else [ $# -eq 0 ] || die 'usage: crucible help [protocol]'; usage; fi ;;
-h|--help) usage ;;
# An unknown verb refuses. A tool whose premise is "refuse, never warn" must not
# silently succeed on a command it does not have.
*) printf 'crucible: unknown verb: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
